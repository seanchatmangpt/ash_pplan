#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

mix ggen_igniter.sync \
  --pack-dir priv/ggen/ash-pplan-pack \
  --engine oxigraph \
  --out lib/ash_pplan/generated/projection_catalog.ex

mix format lib/ash_pplan/generated/projection_catalog.ex
