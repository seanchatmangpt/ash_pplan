#!/usr/bin/env bash
# Generates the durable-protocol TLA+ module, TLC cfg, trace reader and the stateright
# differential model from the ontology. Honors MANUFACTURE_MANIFEST_ROOT.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
. "$ROOT/bin/manufacture-lib.sh"
PACK="priv/ggen/ash-pplan-durable-tla-pack"
mkdir -p priv/tla/durable "$MF_ROOT"
for t in durable.tla durable.cfg transitions.exs stateright_model.rs; do
  case "$t" in 
    durable.tla) out=priv/tla/durable/DurableProtocol.tla ;;
    durable.cfg) out=priv/tla/durable/DurableProtocol.cfg ;;
    transitions.exs) out=priv/tla/durable/transitions.exs ;;
    stateright_model.rs) out=priv/tla/durable/stateright/model.rs ;;
  esac
  mf_sync "$t" -- --pack-dir "$PACK" --template "$PACK/templates/$t.eex" --engine oxigraph --on-stale prune \
    --out "$out"
done
