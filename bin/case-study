#!/usr/bin/env bash
# bin/case-study — one-command case-study evidence chain (P-Plan-run-first).
#
# Step order, per operator contract amendment:
#   1. o2c-run         — EXECUTE the P-Plan order-to-cash workflow
#                        (examples/case_study_o2c.exs) on the real durable
#                        engine; its full output is kept as the run receipt.
#   2. canonical-court — mix test test/workflow/canonical_court_test.exs
#   3. fleet-soak-court— SOAK_SECONDS mix test test/fleet/
#
# Writes a dated receipt under docs/case-studies/receipts/: one row per step
# with the real command, real exit code, the last line of real output as the
# evidence digest, the real mix test summary line, and a sha256 of each step's
# log. The dated receipt embeds the o2c run receipt's path, sha256, and the
# engine's own digests (replay.ledger_digest, sha256 of the OCEL export).
# No CI, no network; a local evidence receipt, not an attestation.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Per-invocation lane build root: unique per run so concurrent lanes never
# share build dirs; deleted on exit (build roots are leases, not assets).
export MIX_BUILD_ROOT="${MIX_BUILD_ROOT:-_build-case-$$}"
OWNED_BUILD_ROOT=0
[ "$MIX_BUILD_ROOT" = "_build-case-$$" ] && OWNED_BUILD_ROOT=1

SOAK_SECONDS="${SOAK_SECONDS:-30}"
RECEIPT_DIR="docs/case-studies/receipts"
mkdir -p "$RECEIPT_DIR" tmp

STAMP="$(date -u '+%Y%m%dT%H%M%SZ')"
RUN_RECEIPT="$RECEIPT_DIR/o2c-run-$STAMP.log"

STEPS_FILE="$(mktemp)"
LOG_DIR="$(mktemp -d)"
cleanup() {
  rm -f "$STEPS_FILE"
  rm -rf "$LOG_DIR"
  [ "$OWNED_BUILD_ROOT" -eq 1 ] && rm -rf "$MIX_BUILD_ROOT"
  return 0
}
trap cleanup EXIT

# run_step <id> <command...> — runs, records row, never aborts the chain.
run_step() {
  local id="$1"; shift
  local cmd="$*"
  local log="$LOG_DIR/$id.log" out rc digest sum
  if out="$(bash -o pipefail -c "$cmd" 2>&1)"; then rc=0; else rc=$?; fi
  printf '%s\n' "$out" >"$log"
  digest="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n 1 | cut -c1-140)"
  if [ "$id" = "o2c-run" ]; then
    sum="$(printf '%s\n' "$out" | grep -q '== evidence chain complete' && echo 'run receipt complete' || echo 'incomplete')"
  else
    sum="$(printf '%s\n' "$out" | grep -Eo '[0-9]+ tests?, [0-9]+ failures?(, [0-9]+ skipped)?' | tail -1)"
    [ -z "$sum" ] && sum="(no summary line)"
  fi
  local verdict="FAIL"; [ "$rc" -eq 0 ] && verdict="PASS"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$id" "$rc" "$verdict" "$digest" "$cmd" "$sum" "$(shasum -a 256 "$log" | cut -d' ' -f1)" >>"$STEPS_FILE"
  printf '[%s] %s (exit %s): %s\n' "$verdict" "$id" "$rc" "$digest"
  [ "$id" = "o2c-run" ] && cp "$log" "$RUN_RECEIPT"
  return 0
}

# ------------------------------------------------- 1. the P-Plan run (run first)
run_step "o2c-run" \
  "ok=0; for i in 1 2 3; do MIX_ENV=test mix run examples/case_study_o2c.exs && { ok=1; break; }; sleep 20; done; [ \"\$ok\" -eq 1 ]"

# Embedded run-receipt digests (real values lifted from the o2c-run log).
O2C_LEDGER="$(grep -Eo 'replay.ledger_digest: [0-9a-f]+' "$LOG_DIR/o2c-run.log" | awk '{print $2}')"
O2C_OCEL="$(grep -Eo 'replay.evidence.ocel2_sha256: sha256:[0-9a-f]+' "$LOG_DIR/o2c-run.log" | awk '{print $2}')"
O2C_EXPORT="$(grep -Eo 'sha256\(export\): [0-9a-f]+' "$LOG_DIR/o2c-run.log" | awk '{print $2}')"
O2C_STANDING="$(grep -Eo 'standing: [A-Z_]+' "$LOG_DIR/o2c-run.log" | awk '{print $2}')"
RUN_RECEIPT_SHA="$(shasum -a 256 "$RUN_RECEIPT" | cut -d' ' -f1)"

# ------------------------------------------------------ 2-3. the two test courts
run_step "canonical-court" "mix test test/workflow/canonical_court_test.exs"
run_step "fleet-soak-court" "SOAK_SECONDS='$SOAK_SECONDS' mix test test/fleet/"

# ---------------------------------------------------------------- render receipt
overall="PASS"
fail_count=$(awk -F'\t' '$3=="FAIL"' "$STEPS_FILE" | wc -l | tr -d ' ')
pass_count=$(awk -F'\t' '$3=="PASS"' "$STEPS_FILE" | wc -l | tr -d ' ')
if [ "$fail_count" -gt 0 ]; then overall="FAIL"; fi

RECEIPT="$RECEIPT_DIR/case-study-$STAMP.md"

VERSION="$(mix run --no-start -e 'IO.puts(AshPPlan.version())' 2>/dev/null | tail -n 1)"
: "${VERSION:=unknown}"

{
  echo "# Case-Study Receipt (ash_pplan v${VERSION})"
  echo
  echo "Generated by \`bin/case-study\` on $(date -u '+%Y-%m-%dT%H:%M:%SZ')."
  echo "P-Plan-run-first: the order-to-cash workflow executed on the real"
  echo "durable engine before the two test courts. Every row is a real executed"
  echo "command with its real exit code, the last line of its real output as"
  echo "the evidence digest, and the real summary line. Build root:"
  echo "\`$MIX_BUILD_ROOT\`. Soak: ${SOAK_SECONDS}s."
  echo
  echo "## Executed P-Plan run (run receipt)"
  echo
  echo "- run receipt: \`$RUN_RECEIPT\`"
  echo "- run receipt sha256: \`$RUN_RECEIPT_SHA\`"
  echo "- standing: ${O2C_STANDING:-unknown}"
  echo "- replay.ledger_digest: \`${O2C_LEDGER:-missing}\`"
  echo "- replay.evidence.ocel2_sha256: \`${O2C_OCEL:-missing}\`"
  echo "- sha256(OCEL export): \`${O2C_EXPORT:-missing}\`"
  echo
  echo "## Steps"
  echo
  echo "| step | command | exit | summary | evidence digest (last line) | log sha256 | verdict |"
  echo "|---|---|---|---|---|---|---|"
  awk -F'\t' '{printf "| %s | `%s` | %s | %s | %s | %s | %s |\n", $1, $5, $2, $6, $4, $7, $3}' "$STEPS_FILE"
  echo
  echo "## Overall verdict"
  echo
  echo "OVERALL: $overall — $pass_count PASS, $fail_count FAIL."
  echo
  echo "All numbers in this receipt regenerate on every run; this is a local"
  echo "evidence record, not a CI attestation."
} >"$RECEIPT"

echo
echo "Receipt written to $RECEIPT (OVERALL: $overall)"
echo "Executed-run digest: ${O2C_LEDGER:-missing}"
[ "$fail_count" -eq 0 ]
