#!/usr/bin/env bash
# bin/ggen-verify -- fail-CLOSED pack verification across all 11 ggen packs.
#
# Runs `mix ggen_igniter.verify --pack priv/ggen/<pack> --json-envelope` for every
# pack that ships gates/, fails (exit 1) on ANY unbound fact or cardinality breach,
# and prints a per-pack PASS/FAIL table. Full envelopes land in tmp/ggen-verify/.
#
# Row vocabulary: PASS | FAIL | DRIFT | ENGINE-LIMIT | SKIP.
#   ENGINE-LIMIT: the verify run of this pack DIED inside the sparql.ex 0.3.12
#     engine (currently: EXISTS/NOT EXISTS is unimplemented -- the translator
#     leaves a :not_exists atom that crashes as `Protocol.UndefinedError` on
#     `:"$undefined"` in SPARQL.Algebra.Filter). The pack is UNVERIFIED.
#   Exit semantics (fail-CLOSED, unchanged for PASS/FAIL/DRIFT): any FAIL,
#     DRIFT, or ENGINE-LIMIT row sets overall=1 -> script exit 1. ENGINE-LIMIT
#     is not silently skippable: an unverified pack must not count as clean.
#
# vendor/<pack> names address the vendored copies under priv/ggen/vendor/.
#
# CONVENTION NOTE (updated post-re-home, ADR 0010 / 0523ad9): four vendored
# packs carry OFFENDER-REPORTING gates -- their SELECT rows name LAWFUL
# subjects only when the gate is VIOLATED, so 0 rows = clean and >= 1 row = an
# offender list. Post-re-home, the two re-homed packs below are correctly
# structured: their offender queries live in verify/*.unbound.rq (ADR 0010)
# and are NOT part of the `mix ggen_igniter.verify` surface, so the mix
# verify run for them reports ENGINE-LIMIT -- sparql.ex 0.3.12 cannot execute
# the EXISTS-family query shapes that remain in the pack's verify queries.
# Scoring for these packs happens via the Oxigraph-backed courts
# (test/courts/pack_state_transition_court_test.exs,
# test/courts/standing_parity_court_test.exs). Rows below are ACCURATE
# observations of the current toolchain, not wrapper failures:
#   vendor/state-transition-pack        ENGINE-LIMIT expected (sparql.ex
#                                       lacks EXISTS; scored by
#                                       pack_state_transition_court_test)
#   vendor/evidence-standing-pack       ENGINE-LIMIT expected (same engine
#                                       limit; scored by
#                                       standing_parity_court_test)
#   vendor/workflow-corpus-pack         offender-reporting + FILTER NOT EXISTS
#                                       gates, ENGINE-LIMIT expected
#   vendor/semantic-gate-witness-court-pack
#                                       ASK contract gate (court self-check);
#                                       single boolean, no rows -- expect PASS
#                                       if the ASK evaluates true, else FAIL
#
# Env:
#   MIX_BUILD_ROOT              inherited (default: mix's own default)
#   GGEN_VERIFY_PACKS           space-separated pack names to override the default 7
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PACKS="${GGEN_VERIFY_PACKS:-ash-pplan-pack ash-pplan-workflow-pack ash-pplan-standing-pack ash-pplan-durable-tla-pack ash-pplan-store-conformance-pack ash-pplan-durable-chaos-pack vendor/ash-pplan-protocol-court-pack vendor/state-transition-pack vendor/evidence-standing-pack vendor/semantic-gate-witness-court-pack vendor/workflow-corpus-pack}"

report_dir="tmp/ggen-verify"
mkdir -p "$report_dir"

# Strict envelope parsing (bin/.ggen-verify-parse.py): the task's stdout must be
# a single valid --json-envelope document; ANY schema drift (non-JSON output,
# missing/renamed keys, envelope contradicting the observed exit code) is a
# typed error and fails the wrapper -- never a silent fallback.
parse_envelope() {
  local file="$1" result="$2" pack="$3"
  if ! python3 "$ROOT/bin/.ggen-verify-parse.py" "$file" "$result" "$pack"; then
    printf '%-40s %-10s %s\n' "$pack" "DRIFT" "typed schema-drift error (see stderr)"
    overall=1
    return 1
  fi
}

overall=0
printf '%-40s %-10s %s\n' "PACK" "RESULT" "DETAIL"
printf '%-40s %-10s %s\n' "----------------------------------------" "----------" "------------------------------"

for pack in $PACKS; do
  pack_dir="priv/ggen/$pack"
  if [ ! -d "$pack_dir/gates" ]; then
    printf '%-40s %-10s %s\n' "$pack" "SKIP" "no gates/ directory"
    continue
  fi

  envelope_file="$report_dir/$pack.json"
  mkdir -p "$(dirname "$envelope_file")"
  detail=""

  # The workflow pack's SHIPPED ontology declares no Workflow/Task/Method
  # individuals by design (workflows are merged in from
  # test/support/examples/ontology/examples.ttl at manufacture time; see
  # priv/ggen/ash-pplan-workflow-pack/bin/manufacture-workflow and
  # bin/manufacture-examples). Gates 060-110 are therefore legitimately empty on
  # the shipped graph, so this pack is verified against the SAME merged ontology
  # the manufacture loop consumes.
  ontology_args=()
  if [ "$pack" = "ash-pplan-workflow-pack" ]; then
    merged="$report_dir/workflow-merged-ontology.ttl"
    python3 - "$merged" <<'PY'
import sys
from rdflib import Graph
g = Graph()
g.parse("ontology.ttl", format="turtle")
g.parse("test/support/examples/ontology/examples.ttl", format="turtle")
g.serialize(destination=sys.argv[1], format="turtle")
PY
    ontology_args=(--ontology "$merged")
  fi

  # ggen_igniter.verify exits 0 clean, 1 on unbound facts or cardinality breach,
  # 2 on invocation error. Guarded so `set -e` does not kill the loop. Stderr
  # is captured too: an engine crash (Protocol.UndefinedError from sparql.ex)
  # goes to stderr, not stdout.
  result="PASS"
  if ! mix ggen_igniter.verify --pack "$pack_dir" "${ontology_args[@]}" --json-envelope >"$envelope_file" 2>"$envelope_file.err"; then
    result="FAIL"
    overall=1
  fi

  # Engine-crash guard: a gate query using a shape sparql.ex 0.3.12 cannot
  # execute (EXISTS/NOT EXISTS -- unimplemented, crashes as
  # `Protocol.UndefinedError` on `:"$undefined"` inside SPARQL.Algebra.Filter)
  # kills the whole `mix ggen_igniter.verify` process; the crash dump lands on
  # STDERR and stdout holds no envelope, so the strict parser would mislabel
  # it DRIFT. Classify it typed instead: ENGINE-LIMIT (pack UNVERIFIED, still
  # fail-closed: overall was already set to 1 by the FAIL branch above; the
  # run exits 1, never silently skipping the pack). Classified BEFORE
  # parse_envelope so the non-JSON crash dump never reaches the parser.
  # R4 belt-and-suspenders: match BOTH known crash shapes -- the translator
  # leaving `SPARQL.Algebra.Expression not implemented for Atom :not_exists`
  # and the resulting `Protocol.UndefinedError` on `:"$undefined"` inside
  # SPARQL.Algebra.Filter -- so ANY EXISTS-shaped engine death becomes a typed
  # ENGINE-LIMIT row (pack UNVERIFIED, overall=1) instead of killing the run.
  if [ "$result" = "FAIL" ] && grep -q -e 'SPARQL.Algebra.Expression not implemented for Atom' -e 'Protocol.UndefinedError' "$envelope_file" "$envelope_file.err" 2>/dev/null; then
    printf '%-40s %-10s %s\n' "$pack" "ENGINE-LIMIT" "gate query died in sparql.ex 0.3.12 (EXISTS/NOT EXISTS unimplemented); pack UNVERIFIED -- rewrite the gate or fix the engine"
    continue
  fi

  if ! detail="$(parse_envelope "$envelope_file" "$result" "$pack")"; then
    continue
  fi

  printf '%-40s %-10s %s\n' "$pack" "$result" "$detail"
done

echo ""
if [ "$overall" -eq 0 ]; then
  echo "ggen-verify: all packs PASS (fail-closed contracts active)"
else
  echo "ggen-verify: FAILURES above; full envelopes in $report_dir/" >&2
fi
exit "$overall"
