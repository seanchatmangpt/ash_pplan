#!/usr/bin/env python3
"""Executable conformance gate for the canonical ash_pplan ontology.

`ontology/shapes.ttl` + `ontology/law_parity.n3` are the admitted conformance
profile for `ontology.ttl`, evaluated by `ggen law validate` (ggen.toml [law]).
ERRC E1 phase 2 (2026-10-04): the SHACL engine is ggen's GraphLaw engine
(same verdict as the previous pyshacl run — the parity court,
test/courts/law_validate_parity_court_test.exs, proved 13/13 refusal parity
before this swap). The rdflib triple-count floor is kept: ggen does not check
population, and a parse that silently produced a near-empty graph would make
every downstream gate vacuously pass.

Usage:
    bin/conform                 # human-readable report, non-zero on violation
    bin/conform --json          # machine-readable evidence on stdout
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ONTOLOGY = ROOT / "ontology.ttl"
SHAPES = ROOT / "ontology" / "shapes.ttl"

# The ontology is the sole semantic source. A parse that silently produced a
# near-empty graph would make every downstream gate vacuously pass, so the
# floor is asserted here as well as in the pinned ggen-ecosystem container.
MINIMUM_TRIPLES = 110


def ggen_law_validate() -> tuple[bool, str]:
    """Run `ggen law validate` at the repo root; (conforms, combined output)."""
    result = subprocess.run(
        ["ggen", "law", "validate"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        env={"NO_COLOR": "1", "PATH": "/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin"},
    )
    return result.returncode == 0, result.stdout + result.stderr


def main(argv: list[str]) -> int:
    as_json = "--json" in argv[1:]

    try:
        from rdflib import Graph
    except ImportError as error:  # pragma: no cover - environment failure
        print(f"bin/conform requires rdflib: {error}", file=sys.stderr)
        return 2

    data = Graph()
    data.parse(str(ONTOLOGY), format="turtle")
    triples = len(data)
    floor_met = triples >= MINIMUM_TRIPLES

    conforms, output = ggen_law_validate()
    if not conforms:
        # ggen prints the denial/SHACL report on refusal; surface it verbatim.
        print(output, file=sys.stderr)

    admitted = conforms and floor_met

    if as_json:
        json.dump(
            {
                "ontology": str(ONTOLOGY.relative_to(ROOT)),
                "shapes": str(SHAPES.relative_to(ROOT)),
                "triples": triples,
                "minimum_triples": MINIMUM_TRIPLES,
                "conforms": conforms,
                "admitted": admitted,
            },
            sys.stdout,
            indent=2,
            sort_keys=True,
        )
        sys.stdout.write("\n")
    else:
        print(f"ONTOLOGY_TRIPLES={triples}")
        print(f"SHAPES={SHAPES.relative_to(ROOT)}")
        print(f"CONFORMS={conforms}")

        if not floor_met:
            print(
                f"REFUSED: ontology has {triples} triples, below the admitted "
                f"floor of {MINIMUM_TRIPLES}",
                file=sys.stderr,
            )

    return 0 if admitted else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
