@prefix ex: <https://w3id.org/ash-pplan/examples#> .
@prefix ap: <https://w3id.org/ash-pplan#> .

# Example/test-support individuals only. Application-specific capabilities,
# providers and workflows live here, never in the shipped ontology.ttl. They
# reuse the ap: vocabulary; the merged graph is built by bin/manufacture-examples.

ex:cap_Repository_Observe a ap:Capability ; ap:capabilityId "Repository.Observe" ; ap:family "repository" .
ex:cap_Repository_Integrate a ap:Capability ; ap:capabilityId "Repository.Integrate" ; ap:family "repository" .
ex:cap_Work_Select a ap:Capability ; ap:capabilityId "Work.Select" ; ap:family "work" .
ex:cap_Agent_Execute a ap:Capability ; ap:capabilityId "Agent.Execute" ; ap:family "agent" .
ex:cap_Verification_Run a ap:Capability ; ap:capabilityId "Verification.Run" ; ap:family "verification" .
ex:cap_Evidence_Record a ap:Capability ; ap:capabilityId "Evidence.Record" ; ap:family "evidence" .
ex:cap_Authority_Check a ap:Capability ; ap:capabilityId "Authority.Check" ; ap:family "authority" .

ex:provider_ultracode_repository a ap:Provider ;
    ap:providerId "ultracode_repository" ;
    ap:providerModule "AshPPlan.Providers.UltracodeRepository" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Repository_Observe, ex:cap_Repository_Integrate ;
    ap:supportsProperty "observable", "compensable" ;
    ap:emitsEvidence "prov", "git_ref" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Repository_Observe ; ap:adapter "ultracode" ; ap:operation "repository_observe" ; ap:stepOptions "[]" ],
        [ a ap:Realization ; ap:realizes ex:cap_Repository_Integrate ; ap:adapter "ultracode" ; ap:operation "repository_integrate" ; ap:stepOptions "[]" ] .

ex:provider_ultracode_work a ap:Provider ;
    ap:providerId "ultracode_work" ;
    ap:providerModule "AshPPlan.Providers.UltracodeWork" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Work_Select ;
    ap:supportsProperty "observable" ;
    ap:emitsEvidence "prov", "frontier" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Work_Select ; ap:adapter "ultracode" ; ap:operation "work_select" ; ap:stepOptions "[]" ] .

ex:provider_ultracode_agent a ap:Provider ;
    ap:providerId "ultracode_agent" ;
    ap:providerModule "AshPPlan.Providers.UltracodeAgent" ;
    ap:cost 2 ;
    ap:supportsCapability ex:cap_Agent_Execute ;
    ap:supportsProperty "durable", "resumable" ;
    ap:emitsEvidence "prov", "agent_receipt" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Agent_Execute ; ap:adapter "ultracode" ; ap:operation "agent_execute" ; ap:stepOptions "[]" ] .

ex:provider_ultracode_verification a ap:Provider ;
    ap:providerId "ultracode_verification" ;
    ap:providerModule "AshPPlan.Providers.UltracodeVerification" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Verification_Run ;
    ap:supportsProperty "observable" ;
    ap:emitsEvidence "prov", "verdict" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Verification_Run ; ap:adapter "ultracode" ; ap:operation "verification_run" ; ap:stepOptions "[]" ] .

ex:provider_ultracode_evidence a ap:Provider ;
    ap:providerId "ultracode_evidence" ;
    ap:providerModule "AshPPlan.Providers.UltracodeEvidence" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Evidence_Record ;
    ap:supportsProperty "durable" ;
    ap:emitsEvidence "prov", "receipt" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Evidence_Record ; ap:adapter "ultracode" ; ap:operation "evidence_record" ; ap:stepOptions "[]" ] .

ex:provider_ultracode_authority a ap:Provider ;
    ap:providerId "ultracode_authority" ;
    ap:providerModule "AshPPlan.Providers.UltracodeAuthority" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Authority_Check ;
    ap:supportsProperty "observable" ;
    ap:emitsEvidence "prov", "authority_decision" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Authority_Check ; ap:adapter "ultracode" ; ap:operation "authority_check" ; ap:stepOptions "[]" ] .

ex:wf_ultracode a ap:Workflow ; ap:workflowName "ultracode" ; ap:goal "close_frontier" ;
    ap:hasTask ex:task_ultracode_observe, ex:task_ultracode_select, ex:task_ultracode_execute, ex:task_ultracode_integrate, ex:task_ultracode_verify ;
    ap:hasMethod ex:method_close_frontier_default, ex:method_close_frontier_degraded .

ex:task_ultracode_observe a ap:Task ; ap:taskId "observe" ; ap:requiresCapability ex:cap_Repository_Observe ; ap:authorityCeiling "observe" ; ap:order 1 ; ap:outcome "success" .
ex:task_ultracode_select a ap:Task ; ap:taskId "select" ; ap:requiresCapability ex:cap_Work_Select ; ap:authorityCeiling "select" ; ap:order 2 ; ap:dependsOn ex:task_ultracode_observe ; ap:outcome "success" .
ex:task_ultracode_execute a ap:Task ; ap:taskId "execute" ; ap:requiresCapability ex:cap_Agent_Execute ; ap:authorityCeiling "construct" ; ap:order 3 ; ap:dependsOn ex:task_ultracode_select ; ap:outcome "success", "refused", "unavailable", "failed" ; ap:requiresProperty "durable" .
ex:task_ultracode_integrate a ap:Task ; ap:taskId "integrate" ; ap:requiresCapability ex:cap_Repository_Integrate ; ap:authorityCeiling "construct" ; ap:order 4 ; ap:dependsOn ex:task_ultracode_execute ; ap:outcome "merged", "stale", "conflict" .
ex:task_ultracode_verify a ap:Task ; ap:taskId "verify" ; ap:requiresCapability ex:cap_Verification_Run ; ap:authorityCeiling "observe" ; ap:order 5 ; ap:dependsOn ex:task_ultracode_integrate ; ap:outcome "admitted", "failed", "insufficient_evidence" .
ex:task_ultracode_close_frontier a ap:Task ; ap:taskId "close_frontier" ; ap:authorityCeiling "construct" ; ap:compound true .

ex:method_close_frontier_default a ap:Method ; ap:methodId "close_frontier_default" ; ap:decomposes ex:task_ultracode_close_frontier ;
    ap:subtask ex:task_ultracode_observe, ex:task_ultracode_select, ex:task_ultracode_execute, ex:task_ultracode_integrate, ex:task_ultracode_verify .
ex:method_close_frontier_degraded a ap:Method ; ap:methodId "close_frontier_degraded" ; ap:decomposes ex:task_ultracode_close_frontier ;
    ap:subtask ex:task_ultracode_observe, ex:task_ultracode_select, ex:task_ultracode_verify .

ex:wf_file_release a ap:Workflow ; ap:workflowName "file_release" ; ap:goal "release_file" ;
    ap:hasTask ex:task_file_release_fetch, ex:task_file_release_write, ex:task_file_release_verify .

ex:task_file_release_fetch a ap:Task ; ap:taskId "fetch" ; ap:requiresCapability ap:cap_Remote_Read ; ap:authorityCeiling "observe" ; ap:order 1 ; ap:outcome "success" .
ex:task_file_release_write a ap:Task ; ap:taskId "write" ; ap:requiresCapability ap:cap_File_Write ; ap:authorityCeiling "construct" ; ap:order 2 ; ap:dependsOn ex:task_file_release_fetch ; ap:outcome "success" .
ex:task_file_release_verify a ap:Task ; ap:taskId "verify" ; ap:requiresCapability ex:cap_Verification_Run ; ap:authorityCeiling "observe" ; ap:order 3 ; ap:dependsOn ex:task_file_release_write ; ap:outcome "admitted", "failed", "insufficient_evidence" .

# ---------------------------------------------------------------------------
# qualified_fulfillment (append-only): capabilities, providers, workflow.
# ---------------------------------------------------------------------------
ex:cap_Order_Admit a ap:Capability ; ap:capabilityId "Order.Admit" ; ap:family "order" .
ex:cap_Order_VerifyPackage a ap:Capability ; ap:capabilityId "Order.VerifyPackage" ; ap:family "order" .
ex:cap_Payment_Authorize a ap:Capability ; ap:capabilityId "Payment.Authorize" ; ap:family "payment" .
ex:cap_Artifact_Write a ap:Capability ; ap:capabilityId "Artifact.Write" ; ap:family "artifact" .
ex:cap_Process_EnsureAvailable a ap:Capability ; ap:capabilityId "Process.EnsureAvailable" ; ap:family "process" .
ex:cap_Actuator_Command a ap:Capability ; ap:capabilityId "Actuator.Command" ; ap:family "actuator" .
ex:cap_Human_Approve a ap:Capability ; ap:capabilityId "Human.Approve" ; ap:family "human" .
ex:cap_Shipment_Commit a ap:Capability ; ap:capabilityId "Shipment.Commit" ; ap:family "shipment" .
ex:cap_Schedule_Deferred a ap:Capability ; ap:capabilityId "Schedule.Deferred" ; ap:family "schedule" .
ex:cap_Evidence_Establish a ap:Capability ; ap:capabilityId "Evidence.Establish" ; ap:family "evidence" .

ex:provider_order a ap:Provider ;
    ap:providerId "order" ;
    ap:providerModule "AshPPlan.Providers.Order" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Order_Admit, ex:cap_Order_VerifyPackage, ex:cap_Shipment_Commit ;
    ap:supportsProperty "compensable", "transactional" ;
    ap:emitsEvidence "ash_result" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Order_Admit ; ap:adapter "qf_ledger" ; ap:operation "order_admit" ; ap:stepOptions "[]" ],
        [ a ap:Realization ; ap:realizes ex:cap_Order_VerifyPackage ; ap:adapter "qf_ledger" ; ap:operation "order_verifypackage" ; ap:stepOptions "[]" ],
        [ a ap:Realization ; ap:realizes ex:cap_Shipment_Commit ; ap:adapter "qf_ledger" ; ap:operation "shipment_commit" ; ap:stepOptions "[transaction?: true]" ] .

ex:provider_payment a ap:Provider ;
    ap:providerId "payment" ;
    ap:providerModule "AshPPlan.Providers.Payment" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Payment_Authorize ;
    ap:emitsEvidence "http_response" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Payment_Authorize ; ap:adapter "qf_ledger" ; ap:operation "payment_authorize" ; ap:stepOptions "[]" ] .

ex:provider_payment_backup a ap:Provider ;
    ap:providerId "payment_backup" ;
    ap:providerModule "AshPPlan.Providers.PaymentBackup" ;
    ap:cost 3 ;
    ap:supportsCapability ex:cap_Payment_Authorize ;
    ap:emitsEvidence "http_response" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Payment_Authorize ; ap:adapter "qf_ledger" ; ap:operation "payment_authorize" ; ap:stepOptions "[]" ] .

ex:provider_artifact a ap:Provider ;
    ap:providerId "artifact" ;
    ap:providerModule "AshPPlan.Providers.Artifact" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Artifact_Write ;
    ap:supportsProperty "compensable" ;
    ap:emitsEvidence "file_stat" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Artifact_Write ; ap:adapter "qf_ledger" ; ap:operation "artifact_write" ; ap:stepOptions "[revert_on_undo?: true]" ] .

ex:provider_worker a ap:Provider ;
    ap:providerId "worker" ;
    ap:providerModule "AshPPlan.Providers.Worker" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Process_EnsureAvailable ;
    ap:supportsProperty "compensable" ;
    ap:emitsEvidence "process_result" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Process_EnsureAvailable ; ap:adapter "qf_ledger" ; ap:operation "process_ensureavailable" ; ap:stepOptions "[]" ] .

ex:provider_actuator a ap:Provider ;
    ap:providerId "actuator" ;
    ap:providerModule "AshPPlan.Providers.Actuator" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Actuator_Command, ap:cap_State_Await ;
    ap:supportsProperty "pollable", "observable" ;
    ap:emitsEvidence "observation" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Actuator_Command ; ap:adapter "bb_reactor" ; ap:operation "actuator_command" ; ap:stepOptions "[]" ],
        [ a ap:Realization ; ap:realizes ap:cap_State_Await ; ap:adapter "bb_reactor" ; ap:operation "state_await" ; ap:stepOptions "[]" ] .

ex:provider_fulfillment_manual a ap:Provider ;
    ap:providerId "fulfillment_manual" ;
    ap:providerModule "AshPPlan.Providers.FulfillmentManual" ;
    ap:cost 4 ;
    ap:supportsCapability ex:cap_Actuator_Command, ap:cap_State_Await ;
    ap:supportsProperty "pollable", "observable" ;
    ap:emitsEvidence "observation" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Actuator_Command ; ap:adapter "bb_reactor" ; ap:operation "actuator_command" ; ap:stepOptions "[]" ],
        [ a ap:Realization ; ap:realizes ap:cap_State_Await ; ap:adapter "bb_reactor" ; ap:operation "state_await" ; ap:stepOptions "[mode: :await]" ] .

ex:provider_durable_gate a ap:Provider ;
    ap:providerId "durable_gate" ;
    ap:providerModule "AshPPlan.Providers.DurableGate" ;
    ap:cost 2 ;
    ap:supportsCapability ex:cap_Human_Approve ;
    ap:supportsProperty "durable", "resumable", "checkpointed" ;
    ap:emitsEvidence "continuation" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Human_Approve ; ap:adapter "durable" ; ap:operation "human_approve" ; ap:stepOptions "[]" ] .

ex:provider_scheduler a ap:Provider ;
    ap:providerId "scheduler" ;
    ap:providerModule "AshPPlan.Providers.Scheduler" ;
    ap:cost 2 ;
    ap:supportsCapability ex:cap_Schedule_Deferred ;
    ap:supportsProperty "scheduled", "durable" ;
    ap:emitsEvidence "wakeup_descriptor" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Schedule_Deferred ; ap:adapter "durable" ; ap:operation "schedule_deferred" ; ap:stepOptions "[]" ] .

ex:provider_evidence_local a ap:Provider ;
    ap:providerId "evidence_local" ;
    ap:providerModule "AshPPlan.Providers.EvidenceLocal" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Evidence_Establish ;
    ap:supportsProperty "durable" ;
    ap:emitsEvidence "receipt" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Evidence_Establish ; ap:adapter "qf_ledger" ; ap:operation "evidence_establish" ; ap:stepOptions "[]" ] .

ex:wf_qualified_fulfillment a ap:Workflow ; ap:workflowName "qualified_fulfillment" ; ap:goal "fulfill_order" ;
    ap:hasTask ex:task_qf_admit_order, ex:task_qf_authorize_payment, ex:task_qf_produce_manifest, ex:task_qf_prepare_worker, ex:task_qf_pick_inventory, ex:task_qf_await_pick, ex:task_qf_verify_package, ex:task_qf_await_human_release, ex:task_qf_commit_shipment, ex:task_qf_schedule_followup, ex:task_qf_establish_evidence ;
    ap:hasMethod ex:method_qf_qualified_physical_fulfillment, ex:method_qf_pick_inventory_physical .

ex:task_qf_admit_order a ap:Task ; ap:taskId "admit_order" ; ap:requiresCapability ex:cap_Order_Admit ; ap:authorityCeiling "select" ; ap:order 1 ; ap:outcome "success" .
ex:task_qf_authorize_payment a ap:Task ; ap:taskId "authorize_payment" ; ap:requiresCapability ex:cap_Payment_Authorize ; ap:authorityCeiling "construct" ; ap:order 2 ; ap:dependsOn ex:task_qf_admit_order ; ap:outcome "authorized", "declined", "unavailable", "timeout" .
ex:task_qf_produce_manifest a ap:Task ; ap:taskId "produce_manifest" ; ap:requiresCapability ex:cap_Artifact_Write ; ap:authorityCeiling "select" ; ap:order 3 ; ap:dependsOn ex:task_qf_authorize_payment ; ap:outcome "success" .
ex:task_qf_prepare_worker a ap:Task ; ap:taskId "prepare_worker" ; ap:requiresCapability ex:cap_Process_EnsureAvailable ; ap:authorityCeiling "select" ; ap:order 4 ; ap:dependsOn ex:task_qf_authorize_payment ; ap:outcome "available", "started", "restart_required", "unavailable" .
ex:task_qf_pick_inventory a ap:Task ; ap:taskId "pick_inventory" ; ap:requiresCapability ex:cap_Actuator_Command ; ap:authorityCeiling "select" ; ap:order 5 ; ap:dependsOn ex:task_qf_produce_manifest, ex:task_qf_prepare_worker ; ap:outcome "accepted", "rejected", "actuator_unavailable" .
ex:task_qf_await_pick a ap:Task ; ap:taskId "await_pick" ; ap:requiresCapability ap:cap_State_Await ; ap:authorityCeiling "observe" ; ap:order 6 ; ap:dependsOn ex:task_qf_pick_inventory ; ap:outcome "completed", "obstruction", "timeout", "unit_failed" .
ex:task_qf_verify_package a ap:Task ; ap:taskId "verify_package" ; ap:requiresCapability ex:cap_Order_VerifyPackage ; ap:authorityCeiling "observe" ; ap:order 7 ; ap:dependsOn ex:task_qf_await_pick ; ap:outcome "success", "failed" .
ex:task_qf_await_human_release a ap:Task ; ap:taskId "await_human_release" ; ap:requiresCapability ex:cap_Human_Approve ; ap:authorityCeiling "select" ; ap:order 8 ; ap:dependsOn ex:task_qf_verify_package ; ap:outcome "approved", "refused", "still_waiting" ; ap:requiresProperty "durable" .
ex:task_qf_commit_shipment a ap:Task ; ap:taskId "commit_shipment" ; ap:requiresCapability ex:cap_Shipment_Commit ; ap:authorityCeiling "construct" ; ap:order 9 ; ap:dependsOn ex:task_qf_await_human_release ; ap:outcome "success", "failed" .
ex:task_qf_schedule_followup a ap:Task ; ap:taskId "schedule_followup" ; ap:requiresCapability ex:cap_Schedule_Deferred ; ap:authorityCeiling "select" ; ap:order 10 ; ap:dependsOn ex:task_qf_commit_shipment ; ap:outcome "success" .
ex:task_qf_establish_evidence a ap:Task ; ap:taskId "establish_evidence" ; ap:requiresCapability ex:cap_Evidence_Establish ; ap:authorityCeiling "observe" ; ap:order 11 ; ap:dependsOn ex:task_qf_schedule_followup ; ap:outcome "success" .
ex:task_qf_fulfill_order a ap:Task ; ap:taskId "fulfill_order" ; ap:authorityCeiling "construct" ; ap:compound true .
ex:task_qf_pick_phase a ap:Task ; ap:taskId "pick_inventory_phase" ; ap:authorityCeiling "select" ; ap:compound true .

ex:method_qf_qualified_physical_fulfillment a ap:Method ; ap:methodId "qualified_physical_fulfillment" ; ap:decomposes ex:task_qf_fulfill_order ;
    ap:subtask ex:task_qf_admit_order, ex:task_qf_authorize_payment, ex:task_qf_produce_manifest, ex:task_qf_prepare_worker, ex:task_qf_pick_inventory, ex:task_qf_await_pick, ex:task_qf_verify_package, ex:task_qf_await_human_release, ex:task_qf_commit_shipment, ex:task_qf_schedule_followup, ex:task_qf_establish_evidence .
ex:method_qf_pick_inventory_physical a ap:Method ; ap:methodId "pick_inventory_physical" ; ap:decomposes ex:task_qf_pick_phase ;
    ap:subtask ex:task_qf_pick_inventory, ex:task_qf_await_pick .

# --- m8: self-hosting fixed point (closure loop over its own completion graph) ---
# Providers are realized by the test-only `selfhost` adapter (deterministic local agent) and the
# durable adapter (integration gate). No provider carries DO authority.

ex:provider_selfhost_repository a ap:Provider ;
    ap:providerId "selfhost_repository" ;
    ap:providerModule "AshPPlan.Providers.SelfhostRepository" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Repository_Observe, ex:cap_Repository_Integrate ;
    ap:supportsProperty "observable", "compensable" ;
    ap:emitsEvidence "prov", "frontier" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Repository_Observe ; ap:adapter "selfhost" ; ap:operation "repository_observe" ; ap:stepOptions "[]" ],
        [ a ap:Realization ; ap:realizes ex:cap_Repository_Integrate ; ap:adapter "selfhost" ; ap:operation "repository_integrate" ; ap:stepOptions "[]" ] .

ex:provider_selfhost_work a ap:Provider ;
    ap:providerId "selfhost_work" ;
    ap:providerModule "AshPPlan.Providers.SelfhostWork" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Work_Select ;
    ap:supportsProperty "observable" ;
    ap:emitsEvidence "prov", "frontier" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Work_Select ; ap:adapter "selfhost" ; ap:operation "work_select" ; ap:stepOptions "[]" ] .

ex:provider_selfhost_agent a ap:Provider ;
    ap:providerId "selfhost_agent" ;
    ap:providerModule "AshPPlan.Providers.SelfhostAgent" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Agent_Execute ;
    ap:supportsProperty "durable", "resumable" ;
    ap:emitsEvidence "prov", "agent_receipt" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Agent_Execute ; ap:adapter "selfhost" ; ap:operation "agent_execute" ; ap:stepOptions "[]" ] .

ex:provider_selfhost_gate a ap:Provider ;
    ap:providerId "selfhost_gate" ;
    ap:providerModule "AshPPlan.Providers.SelfhostGate" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Human_Approve ;
    ap:supportsProperty "durable", "resumable", "checkpointed" ;
    ap:emitsEvidence "continuation" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Human_Approve ; ap:adapter "durable" ; ap:operation "human_approve" ; ap:stepOptions "[signal: \"selfhost_integration_gate\", timeout: nil]" ] .

ex:provider_selfhost_verification a ap:Provider ;
    ap:providerId "selfhost_verification" ;
    ap:providerModule "AshPPlan.Providers.SelfhostVerification" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Verification_Run ;
    ap:supportsProperty "observable" ;
    ap:emitsEvidence "prov", "verdict" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Verification_Run ; ap:adapter "selfhost" ; ap:operation "verification_run" ; ap:stepOptions "[]" ] .

ex:provider_selfhost_evidence a ap:Provider ;
    ap:providerId "selfhost_evidence" ;
    ap:providerModule "AshPPlan.Providers.SelfhostEvidence" ;
    ap:cost 1 ;
    ap:supportsCapability ex:cap_Evidence_Record ;
    ap:supportsProperty "durable" ;
    ap:emitsEvidence "prov", "receipt" ;
    ap:realization [ a ap:Realization ; ap:realizes ex:cap_Evidence_Record ; ap:adapter "selfhost" ; ap:operation "evidence_record" ; ap:stepOptions "[]" ] .

ex:wf_selfhost a ap:Workflow ; ap:workflowName "selfhost" ; ap:goal "close_selfhost_frontier" ;
    ap:hasTask ex:task_selfhost_observe, ex:task_selfhost_select, ex:task_selfhost_execute, ex:task_selfhost_gate, ex:task_selfhost_integrate, ex:task_selfhost_verify, ex:task_selfhost_record ;
    ap:hasMethod ex:method_selfhost_close .

ex:task_selfhost_observe a ap:Task ; ap:taskId "observe" ; ap:requiresCapability ex:cap_Repository_Observe ; ap:authorityCeiling "observe" ; ap:order 1 ; ap:outcome "success" .
ex:task_selfhost_select a ap:Task ; ap:taskId "select" ; ap:requiresCapability ex:cap_Work_Select ; ap:authorityCeiling "select" ; ap:order 2 ; ap:dependsOn ex:task_selfhost_observe ; ap:outcome "success" .
ex:task_selfhost_execute a ap:Task ; ap:taskId "execute" ; ap:requiresCapability ex:cap_Agent_Execute ; ap:authorityCeiling "construct" ; ap:order 3 ; ap:dependsOn ex:task_selfhost_select ; ap:outcome "success", "refused" ; ap:requiresProperty "durable" .
ex:task_selfhost_gate a ap:Task ; ap:taskId "integration_gate" ; ap:requiresCapability ex:cap_Human_Approve ; ap:authorityCeiling "select" ; ap:order 4 ; ap:dependsOn ex:task_selfhost_execute ; ap:outcome "approved" ; ap:requiresProperty "durable" .
ex:task_selfhost_integrate a ap:Task ; ap:taskId "integrate" ; ap:requiresCapability ex:cap_Repository_Integrate ; ap:authorityCeiling "construct" ; ap:order 5 ; ap:dependsOn ex:task_selfhost_gate ; ap:outcome "merged" .
ex:task_selfhost_verify a ap:Task ; ap:taskId "verify" ; ap:requiresCapability ex:cap_Verification_Run ; ap:authorityCeiling "observe" ; ap:order 6 ; ap:dependsOn ex:task_selfhost_integrate ; ap:outcome "admitted", "failed" .
ex:task_selfhost_record a ap:Task ; ap:taskId "record_standing" ; ap:requiresCapability ex:cap_Evidence_Record ; ap:authorityCeiling "observe" ; ap:order 7 ; ap:dependsOn ex:task_selfhost_verify ; ap:outcome "success" ; ap:requiresProperty "durable" .
ex:task_selfhost_close_selfhost_frontier a ap:Task ; ap:taskId "close_selfhost_frontier" ; ap:authorityCeiling "construct" ; ap:compound true .

ex:method_selfhost_close a ap:Method ; ap:methodId "close_selfhost_frontier_loop" ; ap:decomposes ex:task_selfhost_close_selfhost_frontier ;
    ap:subtask ex:task_selfhost_observe, ex:task_selfhost_select, ex:task_selfhost_execute, ex:task_selfhost_gate, ex:task_selfhost_integrate, ex:task_selfhost_verify, ex:task_selfhost_record .
