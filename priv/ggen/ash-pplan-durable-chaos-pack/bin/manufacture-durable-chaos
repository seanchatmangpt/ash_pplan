#!/usr/bin/env bash
# Generates the model-based chaos suites (test/durable/chaos/*_test.exs) from the chaos pack.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
cd "$ROOT"
. "$ROOT/bin/manufacture-lib.sh"

PACK="priv/ggen/ash-pplan-durable-chaos-pack"

sync() {
  local name="$1" template="$2" out="$3" foreach="$4"
  mf_sync "$name" -- --ontology "$PACK/ontology.ttl" --pack-dir "$PACK" \
    --template "$PACK/templates/$template" --engine oxigraph --on-stale prune \
    --out "$out" --for-each "$foreach"
}

mkdir -p "$MF_ROOT" test/durable/chaos

sync invariants invariant_property.exs.eex "test/durable/chaos/<%= invariantId %>_property_test.exs" invariants
sync phases kill_matrix.exs.eex "test/durable/chaos/kill_<%= phaseId %>_test.exs" kill_phases

mix format test/durable/chaos/*.exs
