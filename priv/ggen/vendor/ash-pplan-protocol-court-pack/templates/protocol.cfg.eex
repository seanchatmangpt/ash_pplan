---
to: 'tmp/x5/protocol-court/<%= moduleName %>.cfg'
mode: file
---
<%
  unescape = fn body ->
    Regex.replace(~r/\\(u[0-9A-Fa-f]{4}|.)/s, body, fn _, c ->
      case c do
        "n" -> "\n"
        "t" -> "\t"
        "r" -> "\r"
        "\"" -> "\""
        "\\" -> "\\"
        "'" -> "'"
        <<"u", hex::binary-size(4)>> -> <<String.to_integer(hex, 16)::utf8>>
        other -> other
      end
    end)
  end

  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          unescape.(body)
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end

  norm = fn rows -> Enum.map(List.wrap(rows), fn row -> Map.new(row, fn {k, v} -> {to_string(k), scalar.(v)} end) end) end
  statuses = statuses |> norm.() |> Enum.sort_by(& &1["status"])
  actions = actions |> norm.() |> Enum.sort_by(&String.to_integer(&1["order"]))
  guards = norm.(guards)
  properties = norm.(properties)
  terminal = statuses |> Enum.filter(&(&1["terminal"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
%>\* GENERATED by ggen_igniter from packs/ash-pplan-protocol-court-pack/ontology.ttl.
SPECIFICATION Spec
CONSTANTS <%= cfgConstants %>
<%= for p <- Enum.sort_by(Enum.filter(properties, &(&1["kind"] == "invariant")), &{String.to_integer(&1["order"]), &1["name"]}) do %>INVARIANT <%= p["name"] %>
<% end %><%= for p <- Enum.sort_by(Enum.filter(properties, &(&1["kind"] == "property")), &{String.to_integer(&1["order"]), &1["name"]}) do %>PROPERTY <%= p["name"] %>
<% end %>