---
to: 'tmp/x5/protocol-court/<%= moduleName %>.tla'
mode: file
---
<%
  unescape = fn body ->
    Regex.replace(~r/\\(u[0-9A-Fa-f]{4}|.)/s, body, fn _, c ->
      case c do
        "n" -> "\n"
        "t" -> "\t"
        "r" -> "\r"
        "\"" -> "\""
        "\\" -> "\\"
        "'" -> "'"
        <<"u", hex::binary-size(4)>> -> <<String.to_integer(hex, 16)::utf8>>
        other -> other
      end
    end)
  end

  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          unescape.(body)
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end

  norm = fn rows -> Enum.map(List.wrap(rows), fn row -> Map.new(row, fn {k, v} -> {to_string(k), scalar.(v)} end) end) end
  statuses = statuses |> norm.() |> Enum.sort_by(& &1["status"])
  transitions = transitions |> norm.() |> Enum.sort_by(&{&1["from"], &1["to"]})
  actions = actions |> norm.() |> Enum.sort_by(&String.to_integer(&1["order"]))
  guards = norm.(guards)
  properties = norm.(properties)
  q = fn s -> inspect(s) end
  set = fn xs -> "{" <> Enum.map_join(xs, ", ", q) <> "}" end
  terminal = statuses |> Enum.filter(&(&1["terminal"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
  parked = statuses |> Enum.filter(&(&1["parked"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
  forward = statuses |> Enum.filter(&(&1["forward"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
  init_lines = initExpr |> String.trim() |> String.split("\n") |> Enum.map_join("\n", &("  " <> &1))
  guard_lines = fn action ->
    guards
    |> Enum.filter(&(&1["action"] == action))
    |> Enum.sort_by(&String.to_integer(&1["gorder"]))
    |> Enum.map_join("\n", fn g -> "  /\\ " <> g["expr"] <> " \\* guard:" <> g["gid"] end)
  end
  header = fn a -> if a["param"] == "", do: a["action"], else: a["action"] <> "(" <> a["param"] <> ")" end
  next_lines =
    Enum.map_join(actions, "\n", fn a ->
      if a["param"] == "",
        do: "  \\/ " <> a["action"],
        else: "  \\/ \\E w \\in Workers : " <> a["action"] <> "(w)"
    end)
%>---------------------------- MODULE <%= moduleName %> ----------------------------
\* GENERATED by ggen_igniter from packs/ash-pplan-protocol-court-pack/ontology.ttl.
\* Do not edit. Re-render with mix ggen_igniter.sync --pack-dir.
\* One machine, a set of workers, steps "a" (effect) and "b" (awaits a signal).
EXTENDS Integers, FiniteSets
CONSTANT Workers

Steps == <%= stepSet %>
Statuses == <%= set.(Enum.map(statuses, & &1["status"])) %>
Terminal == <%= set.(terminal) %>
Parked == <%= set.(parked) %>
Forward == <%= set.(forward) %>

VARIABLES <%= variables %>
vars == <<status, holder, pc, sigPending, sigDelivered, recorded, effects>>

Init ==
<%= init_lines %>

<%= for a <- actions do %><%= header.(a) %> ==
<%= guard_lines.(a["action"]) %>
  /\ <%= a["effect"] %>

<% end %>Quiescent ==
  /\ status \in Terminal
  /\ \A w \in Workers : pc[w] = "idle"
  /\ UNCHANGED vars

Next ==
<%= next_lines %>
  \/ Quiescent

<%= for p <- Enum.sort_by(properties, &{String.to_integer(&1["order"]), &1["name"]}) do %><%= p["name"] %> == <%= p["expr"] %>
<% end %>Spec == Init /\ [][Next]_vars /\ \A w \in Workers : WF_vars(<%= wfAction %>(w))
=============================================================================
