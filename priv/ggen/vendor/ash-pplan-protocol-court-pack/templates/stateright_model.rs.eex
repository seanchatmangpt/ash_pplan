---
to: 'tmp/x5/protocol-court/model.rs'
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) -> value
    other -> other
  end
  norm = fn rows -> Enum.map(List.wrap(rows), fn row -> Map.new(row, fn {k, v} -> {to_string(k), scalar.(v)} end) end) end
  statuses = statuses |> norm.() |> Enum.sort_by(& &1["status"])
  transitions = norm.(transitions)
  actions = actions |> norm.() |> Enum.sort_by(&String.to_integer(&1["order"]))
  guards = norm.(guards)
  properties = norm.(properties)
  q = fn s -> inspect(s) end
  terminal = statuses |> Enum.filter(&(&1["terminal"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
  parked = statuses |> Enum.filter(&(&1["parked"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
  forward = statuses |> Enum.filter(&(&1["forward"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
  guard_ids = fn action ->
    guards
    |> Enum.filter(&(&1["action"] == action))
    |> Enum.sort_by(&String.to_integer(&1["gorder"]))
    |> Enum.map(& &1["gid"])
  end
%>
// GENERATED by ggen_igniter from packs/ash-pplan-protocol-court-pack/ontology.ttl.
// Do not edit. Re-render with mix ggen_igniter.sync --pack-dir.
//
// Stateright differential-check model, rendered from the SAME protocol ontology
// as the TLA+ module -- so a verdict disagreement between checkers is a court
// failure, not a modeling drift.
//
// Differential contract:
//   - protocol model: admitted (NoLostWakeup leads-to property + invariant core)
//   - guard-dropped mutants (pcp:Mutant rows): counterexample REQUIRED
//
// Build (scratch dir only, never packaged):
//   cargo new --lib stateright-diff && cargo add stateright@0.18
//   cp model.rs src/lib.rs && cargo test
#![allow(dead_code)]

/// Protocol states, straight from the ontology (pcp:State individuals).
pub const STATUSES: &[&str] = &[
<%= for s <- statuses do %>    <%= q.(s["status"]) %>,
<% end %>];

/// Terminal states (pcp:terminal true).
pub const TERMINAL: &[&str] = &[
<%= for s <- terminal do %>    <%= q.(s) %>,
<% end %>];

/// Parked states (pcp:parked true).
pub const PARKED: &[&str] = &[
<%= for s <- parked do %>    <%= q.(s) %>,
<% end %>];

/// Forward states (pcp:forward true).
pub const FORWARD: &[&str] = &[
<%= for s <- forward do %>    <%= q.(s) %>,
<% end %>];

/// Protocol actions (pcp:Action individuals).
pub const ACTIONS: &[&str] = &[
<%= for a <- actions do %>    <%= q.(a["action"]) %>,
<% end %>];

/// Guards per action, in guardOrder (pcp:Guard individuals).
pub const GUARDS: &[(&str, &[&str])] = &[
<%= for a <- actions do %>    (<%= q.(a["action"]) %>, &[
<%= for g <- guard_ids.(a["action"]) do %>        <%= q.(g) %>,
<% end %>    ]),
<% end %>];

/// Properties the differential court must agree on with TLC
/// (pcp:Property individuals).
pub const PROPERTIES: &[&str] = &[
<%= for p <- Enum.sort_by(properties, &String.to_integer(&1["order"])) do %>    <%= q.(p["name"]) %>,
<% end %>];

/// Guard drops the differential court REQUIRES counterexamples for
/// (pcp:Mutant rows: a mutant = one dropped guard; no counterexample = court failure).
pub const MUTANT_GUARD_DROPS: &[&str] = &[
<%= for m <- mutants do %>    <%= q.(m["guardDrop"]) %>,
<% end %>];

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn protocol_vocabulary_matches_ontology() {
        assert!(!STATUSES.is_empty());
        assert!(!TERMINAL.is_empty());
        assert!(!PARKED.is_empty());
        assert!(!FORWARD.is_empty());
        assert!(!ACTIONS.is_empty());
        assert!(!PROPERTIES.is_empty());
        assert!(!MUTANT_GUARD_DROPS.is_empty());
        // every declared mutant drops a guard that exists in the protocol
        let all_guards: Vec<&str> = GUARDS.iter().flat_map(|(_, gs)| gs.iter().copied()).collect();
        for m in MUTANT_GUARD_DROPS {
            assert!(
                all_guards.contains(m),
                "mutant guard drop {} names no declared guard",
                m
            );
        }
        // every parked and forward state is a declared status
        for s in PARKED { assert!(STATUSES.contains(s)); }
        for s in FORWARD { assert!(STATUSES.contains(s)); }
        for s in TERMINAL { assert!(STATUSES.contains(s)); }
    }
}
