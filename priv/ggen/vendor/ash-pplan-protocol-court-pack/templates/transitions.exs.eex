---
to: 'tmp/x5/protocol-court/<%= String.downcase(moduleName) %>_transitions.exs'
mode: file
---
<%
  unescape = fn body ->
    Regex.replace(~r/\\(u[0-8A-Fa-f]{4}|.)/s, body, fn _, c ->
      case c do
        "n" -> "\n"
        "t" -> "\t"
        "r" -> "\r"
        "\"" -> "\""
        "\\" -> "\\"
        "'" -> "'"
        <<"u", hex::binary-size(4)>> -> <<String.to_integer(hex, 16)::utf8>>
        other -> other
      end
    end)
  end
  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          unescape.(body)
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end
  norm = fn rows -> Enum.map(List.wrap(rows), fn row -> Map.new(row, fn {k, v} -> {to_string(k), scalar.(v)} end) end) end
  statuses = statuses |> norm.() |> Enum.sort_by(& &1["status"])
  transitions = transitions |> norm.() |> Enum.sort_by(&{&1["from"], &1["to"]})
  q = fn s -> inspect(s) end
  terminal = statuses |> Enum.filter(&(&1["terminal"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
%># GENERATED by ggen_igniter from packs/ash-pplan-protocol-court-pack/ontology.ttl. Do not edit.
%{
  protocol: <%= inspect(moduleName) %>,
  statuses: <%= inspect(Enum.map(statuses, &String.to_atom(&1["status"]))) %>,
  terminal: <%= inspect(Enum.map(terminal, &String.to_atom/1)) %>,
  transitions: <%= inspect(Enum.map(transitions, &{String.to_atom(&1["from"]), String.to_atom(&1["to"])})) %>
}
