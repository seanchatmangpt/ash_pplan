# INVERTED COMPANION to gates for stem transitions. ZERO ROWS IS THE PASS CONDITION.

PREFIX tdb: <https://seanchatmangpt.github.io/packs/tokyo-depeg-burn-in#>
SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a tdb:Transition .
    OPTIONAL { ?subject tdb:transitionId ?v }
    FILTER (!BOUND(?v))
    BIND("transitionId" AS ?missing_property)
  }
  UNION
  {
    ?subject a tdb:Transition .
    OPTIONAL { ?subject tdb:transitionOrder ?v }
    FILTER (!BOUND(?v))
    BIND("transitionOrder" AS ?missing_property)
  }
}
