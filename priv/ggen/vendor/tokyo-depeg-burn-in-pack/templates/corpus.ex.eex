---
to: 'tmp/tdb-render/corpus.ex'
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_integer(value) -> Integer.to_string(value)
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
        String.starts_with?(value, "<") and String.end_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end
  norm = fn rows ->
    rows |> List.wrap() |> Enum.map(fn row -> Map.new(row, fn {k, v} -> {to_string(k), scalar.(v)} end) end)
  end
  stages = stages |> norm.() |> Enum.sort_by(& &1["order"])
  participants = participants |> norm.() |> Enum.sort_by(& &1["participantId"])
  module = corpusModule |> to_string |> scalar.() |> String.replace("<", "") |> String.replace(">", "")
  runner = runnerPath |> to_string |> scalar.()
%># GENERATED by ggen_igniter from packs/tokyo-depeg-burn-in-pack/ontology.ttl. Do not edit.
# Do not render-verify this file in isolation; compile under the consumer project.
defmodule <%= module %> do
  @moduledoc """
  Generated scenario corpus for the Tokyo flash-depeg burn-in.

  The corpus is DATA: participants, stage order, effect-identity invariants,
  refusal classes and the required lifecycle all come from the pack's
  ontology.ttl via its gates. Two traffic classes: honest traffic, and the
  mutant class (duplicate accepted, sanctions-skip accepted, revoked authority
  executes, tampered receipt verifies, stale lease executes) that MUST be
  detected.
  """

  @doc "The 6 protocol stages, in ontology order."
  def stages do
    <%= inspect(Enum.map(stages, fn s -> %{id: String.to_atom(s["stageId"]), order: String.to_integer(s["order"]), title: s["title"], verb: String.to_atom(s["handlerVerb"]), refusal_class: s["refusalClass"]} end)) %>
  end

  @doc "The four settlement participants."
  def participants do
    <%= inspect(Enum.map(participants, fn p -> %{id: p["participantId"], role: String.to_atom(p["role"]), venue: p["venue"]} end)) %>
  end

  @doc """
  One honest order scenario (production env, real collaborators only).
  `opts` override the participant ids for a given run.
  """
  def honest_order(opts \\ []) do
    %{
      scenario_id: Keyword.get(opts, :scenario_id, "tokyo-" <> Integer.to_string(System.unique_integer([:positive]))),
      payload: %{
        pair: "JPY/USD",
        notional: 5_000_000,
        depeg_trigger_bps: 250,
        initiator: Keyword.get(opts, :initiator, "agent-ny-7"),
        timestamp: DateTime.utc_now() |> DateTime.to_iso8601()
      },
      stages: Enum.map(stages(), & &1.id),
      participants: Enum.map(participants(), & &1.id)
    }
  end

  @doc "The sanctions-skip mutant trace: skips the SanctionsScreen place."
  def sanctions_skip_mutant do
    scenario = honest_order()
    put_in(scenario, [:stages], List.delete(scenario.stages, :conformance))
  end
end
