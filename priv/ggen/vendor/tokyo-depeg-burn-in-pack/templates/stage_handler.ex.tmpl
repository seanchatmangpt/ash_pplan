---
to: 'tmp/tdb-render/<%= stageId %>_stage_handler.ex'
for_each: stages
sparql:
  stages: |
    PREFIX tdb: <https://seanchatmangpt.github.io/packs/tokyo-depeg-burn-in#>
    SELECT ?stageId ?order ?title ?handlerVerb ?deviation ?refusalClass ?handlerNamespace WHERE {
      ?s a tdb:Stage ; tdb:stageId ?stageId ; tdb:order ?order ; tdb:title ?title ;
         tdb:handlerVerb ?handlerVerb ; tdb:deviation ?deviation ; tdb:refusalBinding ?ref .
      ?ref tdb:refusalClass ?refusalClass .
    }
    ORDER BY ?order
---
<%
  scalar = fn
    nil -> nil
    value when is_integer(value) -> Integer.to_string(value)
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end
  id = scalar.(stageId)
  verb = scalar.(handlerVerb)
  deviation = scalar.(deviation)
  title = scalar.(title)
  refusal = scalar.(refusalClass)
  ns = scalar.(handlerNamespace) || "AshPPlan.TokyoDepeg.Stage"
  module = ns <> "." <> (id |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join(""))
%># GENERATED by ggen_igniter from packs/tokyo-depeg-burn-in-pack/ontology.ttl (stage <%= id %>).
# Do not render-verify this file in isolation; compile under the consumer project.
# Do not edit. Re-render with mix ggen_igniter.sync --pack-dir.
defmodule <%= module %> do
  @moduledoc """
  Generated stage handler for the `<%= id %>` stage: <%= title %>.

  Anti-vacuity contract: the deviation "<%= deviation %>" MUST be detected --
  honest traffic passes this stage and the mutant fires
  `<%= refusal %>` with a receipt subject.
  """

  @spec <%= verb %>(map()) :: {:ok, map()} | {:refused, atom(), map()}
  def <%= verb %>(scenario) do
    case check(scenario) do
      :ok -> {:ok, scenario}
      {:refused, reason} ->
        {:refused, reason, %{stage: <%= inspect(id) %>, refusal_class: <%= inspect(refusal) %>}}
    end
  end

  @doc "Overridable seam: the consumer replaces this with the real production check."
  @spec check(map()) :: :ok | {:refused, atom()}
  def check(scenario), do: apply(__MODULE__, :check_impl, [scenario])

  @doc false
  @spec check_impl(map()) :: :ok | {:refused, atom()}
  def check_impl(_scenario), do: :ok
end
