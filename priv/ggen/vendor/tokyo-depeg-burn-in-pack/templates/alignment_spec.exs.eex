---
to: 'tmp/tdb-render/alignment_spec.exs'
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_integer(value) -> Integer.to_string(value)
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          unescape = fn b ->
            Regex.replace(~r/\\(.)/s, b, fn _, c ->
              case c do
                "n" -> "\n"
                "t" -> "\t"
                "\"" -> "\""
                "\\" -> "\\"
                "'" -> "'"
                other -> other
              end
            end)
          end
          unescape.(body)
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end
  norm = fn rows ->
    rows
    |> List.wrap()
    |> Enum.map(fn row -> Map.new(row, fn {k, v} -> {to_string(k), scalar.(v)} end) end)
  end
  places = places |> norm.() |> Enum.sort_by(& &1["placeOrder"])
  transitions = transitions |> norm.() |> Enum.sort_by(& &1["transitionOrder"])
  arcs = arcs |> norm.() |> Enum.sort_by(& &1["transitionId"])
  invariants = effect_invariants |> norm.() |> Enum.sort_by(& &1["invariantOrder"])
  refusals = refusals |> norm.() |> Enum.sort_by(& &1["refusalClass"])
%># GENERATED by ggen_igniter from packs/tokyo-depeg-burn-in-pack/ontology.ttl. Do not edit.
# Required trade lifecycle as data (Van der Aalst conformance model):
# RiskPreflight -> CollateralCheck -> SanctionsScreen -> Execution.
# Execution is reachable ONLY through SanctionsScreen; the sanctions-skip
# mutant must align at cost > 0. Honest traces align at cost 0.
[
  places: <%= inspect(Enum.map(places, fn p -> %{id: String.to_atom(p["placeId"]), label: p["label"], guard: case p["guardPlaceLabel"] do nil -> nil; g -> String.to_atom(g) end} end)) %>,
  transitions: <%= inspect(Enum.map(transitions, fn t -> String.to_atom(t["transitionId"]) end)) %>,
  arcs: <%= inspect(Enum.map(arcs, fn a -> {String.to_atom(a["fromPlace"]), String.to_atom(a["transitionId"]), String.to_atom(a["toPlace"])} end)) %>,
  effect_invariants: <%= inspect(Enum.map(invariants, fn i -> %{id: String.to_atom(i["invariantId"]), kind: String.to_atom(i["invariantKind"]), expr: i["invariantExpr"]} end)) %>,
  refusal_classes: <%= inspect(Enum.map(refusals, fn r -> {String.to_atom(r["refusalClass"]), r["receiptSubject"]} end)) %>
]
