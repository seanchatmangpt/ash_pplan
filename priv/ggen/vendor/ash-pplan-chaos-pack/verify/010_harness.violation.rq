# Violation gate: a Harness row missing ANY required chaos-harness fact must
# refuse the sync (fail closed). Complete rows render; incomplete rows refuse.
PREFIX acp: <https://seanchatmangpt.github.io/packs/ash-pplan-chaos#>
SELECT DISTINCT ?h ?missing WHERE {
  ?h a acp:Harness .
  FILTER NOT EXISTS {
    ?h acp:testNamespace ?ns ; acp:generatorsModule ?gm ; acp:harnessModule ?hm ;
       acp:invariantsModule ?im ; acp:sabotageModule ?sm ; acp:runsEnv ?re .
  }
  BIND("harness row missing testNamespace/generatorsModule/harnessModule/invariantsModule/sabotageModule/runsEnv" AS ?missing)
}
