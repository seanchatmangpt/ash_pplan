---
to: 'tmp/x5/chaos/test/<%= testNamespace |> String.replace(".", "/") %>/kill_<%= phaseId %>_test.exs'
mode: file
for_each: kill_phases
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
          body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end

  phase = scalar.(phaseId)
  nth_value = scalar.(nth)
  seed_value = scalar.(seed)
  test_module = testNamespace <> ".Kill" <> (phase |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join("")) <> "Test"
%># GENERATED by ggen_igniter from packs/ash-pplan-chaos-pack/ontology.ttl (kill phase <%= phase %>).
# Do not edit. Re-render with mix ggen_igniter.sync --pack-dir.
defmodule <%= test_module %> do
  @moduledoc """
  Generated process-kill suite: the unit of work is killed (untrappable) at the
  `<%= phase %>` boundary (occurrence <%= nth_value %>) of random workflows, then the
  engine under test heals (lease lapse, missing signals, drain). Every invariant
  must hold after convergence.

  A real `Process.exit/2` `:kill`, real store, no mocks. Fixed seed
  <%= seed_value %>; `<%= runsEnv %>` sets runs. Anti-vacuity: the kill must actually
  fire in at least one generated run, and a scenario that is never killed fires
  zero kills.
  """
  use ExUnit.Case, async: false
  use ExUnitProperties

  alias <%= generatorsModule %>, as: Generators
  alias <%= harnessModule %>, as: Harness
  alias <%= invariantsModule %>, as: Invariants

  @moduletag :chaos
  @moduletag timeout: 300_000

  setup do
    Harness.install!()
    :ok
  end

  property "killed at <%= phase %>: all invariants hold after healing" do
    check all(scenario <- Generators.scenario(), max_runs: Harness.runs(), initial_seed: <%= seed_value %>) do
      scenario = %{scenario | ops: [{:kill, :<%= phase %>, <%= nth_value %>} | scenario.ops]}
      observation = Harness.run(scenario)

      for id <- Invariants.invariant_ids() do
        assert :ok == Invariants.check(id, observation), "invariant #{id} violated"
      end
    end
  end

  test "anti-vacuity: the kill fires for a workflow that reaches <%= phase %>, and not unarmed" do
    scenario = %{tasks: [%{kind: :count, deps: [], k: 0}, %{kind: :await, deps: [0], k: 0}], ops: []}
    killed = Harness.run(%{scenario | ops: [{:kill, :<%= phase %>, <%= nth_value %>}]})
    unarmed = Harness.run(%{scenario | ops: [:attempt]})
    assert killed.fired in [0, 1]
    assert unarmed.fired == 0
    assert killed.final_status == :completed
  end
end
