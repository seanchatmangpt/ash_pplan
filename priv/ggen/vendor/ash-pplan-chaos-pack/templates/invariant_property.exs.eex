---
to: 'tmp/x5/chaos/test/<%= testNamespace |> String.replace(".", "/") %>/<%= invariantId %>_property_test.exs'
mode: file
for_each: invariants
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
          body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end

  id = scalar.(invariantId)
  text = scalar.(title)
  seed_value = scalar.(seed)
  test_module = testNamespace <> "." <> (id |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join("")) <> "PropertyTest"
%># GENERATED by ggen_igniter from packs/ash-pplan-chaos-pack/ontology.ttl (invariant <%= id %>).
# Do not edit. Re-render with mix ggen_igniter.sync --pack-dir.
defmodule <%= test_module %> do
  @moduledoc """
  Generated model-based chaos property: <%= text %>.

  Random workflows run against the real engine under test; after the consumer
  harness's drain, the observation must satisfy
  `Invariants.check(:<%= id %>, _)`.

  The property starts from the recorded fixed seed <%= seed_value %>
  (`initial_seed`), so a failure reproduces exactly; `<%= runsEnv %>` sets the
  run count. Anti-vacuity: the sabotage test feeds the check an observation
  corrupted to violate the invariant and requires it to fail.
  """
  use ExUnit.Case, async: false
  use ExUnitProperties

  alias <%= generatorsModule %>, as: Generators
  alias <%= harnessModule %>, as: Harness
  alias <%= invariantsModule %>, as: Invariants
  alias <%= sabotageModule %>, as: Sabotage

  @moduletag :chaos
  @moduletag timeout: 300_000

  setup do
    Harness.install!()
    :ok
  end

  property "<%= text %>" do
    check all(scenario <- Generators.scenario(), max_runs: Harness.runs(), initial_seed: <%= seed_value %>) do
      assert :ok == Invariants.check(:<%= id %>, Harness.run(scenario))
    end
  end

  test "anti-vacuity: the check refuses a sabotaged observation" do
    good = Harness.run(%{tasks: [%{kind: :count, deps: [], k: 0}], ops: [:attempt]})
    assert :ok == Invariants.check(:<%= id %>, good)
    assert {:error, _} = Invariants.check(:<%= id %>, Sabotage.violate(:<%= id %>, good))
  end
end
