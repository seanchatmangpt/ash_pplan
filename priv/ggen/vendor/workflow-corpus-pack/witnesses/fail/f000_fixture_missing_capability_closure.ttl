@prefix wfc: <https://ggen.dev/ontology/workflow-corpus#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex: <https://example.test/wfc/fail-closure/> .

# Task with no wfc:capability and no fixture-level capability set.
ex:f a wfc:WorkflowFixture ;
    wfc:goal "uncovered task" ;
    wfc:task ex:t1 .

ex:t1 a prov:Activity .
