@prefix wfc: <https://ggen.dev/ontology/workflow-corpus#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex: <https://example.test/wfc/fail-authority/> .

# Consequential capability with NO wfc:requiredAuthority on the fixture.
ex:f a wfc:WorkflowFixture ;
    wfc:goal "consequential on ambient authority" ;
    wfc:task ex:t1 .

ex:t1 a prov:Activity ;
    wfc:capability "File.Write" .
