@prefix wfc: <https://ggen.dev/ontology/workflow-corpus#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Fixture 07 - durability + evidence: crash mid-flight, replay to completion.
# Gate witness: gates/f07_durability_evidence.rq fires on
#   fixtures/07-durability-evidence/negative-reexecuted-evidenced.ttl (E-F07-REEXECUTED-EVIDENCED) and
#   fixtures/07-durability-evidence/negative-lost-outcome.ttl (E-F07-LOST-OUTCOME).

wfc:f07 a wfc:WorkflowFixture ;
    dcterms:identifier "workflow-corpus-fixture-07" ;
    wfc:fixtureNumber 7 ;
    wfc:goal "Run a three-task record migration (migrate-records, verify-counts, emit-receipt) that survives a simulated crash after migrate-records completes: the crash checkpoint is taken, the workflow replays, and replay completes the remaining tasks WITHOUT re-executing any task that already has a completion receipt, and WITHOUT dropping any unevidenced task." ;
    dcterms:requires "crash-point:after-migrate" ;
    wfc:capability "File.Write" , "Durability.Checkpoint" , "Durability.Replay" , "Workflow.Halt" , "Workflow.Resume" , "Evidence.Establish" , "Evidence.Bind" , "Receipt.Sign" ;
    wfc:task wfc:f07-task-migration ;
    wfc:expectedDecomposition wfc:f07-decomp-pre-crash , wfc:f07-decomp-replay ;
    wfc:expectedOutcome wfc:f07-outcome-replayed-complete ;
    wfc:requiredEvidence "Every completed task has a completion receipt (prov:Entity, dcterms:type evidence:completion-receipt) generated by that task and signed via Receipt.Sign; the migrate-records receipt exists BEFORE the crash and is the replay's justification for skipping it." ;
    wfc:requiredAuthority "Durability.Replay resumes only under a Workflow.Resume grant naming the checkpoint digest; Receipt.Sign authority is scoped per task. No ambient resume authority." ;
    wfc:expectedProviderClosure wfc:f07-closure-persist ,
        wfc:f07-closure-verify ,
        wfc:f07-closure-file ,
        wfc:f07-closure-pplan ;
    wfc:forbiddenRealization "A replay loop that ignores completion receipts and re-executes evidenced tasks, or a resume that drops an unevidenced task from the replay set." ;
    wfc:falsifierStatement wfc:f07-falsifier .

# Root workflow task.
wfc:f07-task-migration a prov:Activity ;
    dcterms:title "record-migration-workflow" ;
    dcterms:description "Three-task migration with a simulated crash point after migrate-records. Two decompositions over the same task pool: the pre-crash forward plan and the post-crash replay plan." ;
    dcterms:hasPart wfc:f07-sub-migrate , wfc:f07-sub-verify , wfc:f07-sub-emit .

wfc:f07-sub-migrate a prov:Activity ;
    dcterms:identifier "f07-sub-migrate" ;
    dcterms:title "migrate-records" .

wfc:f07-sub-verify a prov:Activity ;
    dcterms:identifier "f07-sub-verify" ;
    dcterms:title "verify-counts" .

wfc:f07-sub-emit a prov:Activity ;
    dcterms:identifier "f07-sub-emit" ;
    dcterms:title "emit-receipt" .

# Simulated crash: workflow halts after migrate-records is evidenced.
wfc:f07-task-crash a prov:Activity ;
    dcterms:title "simulated-crash" ;
    dcterms:type "task:crash" ;
    dcterms:description "Durability.Checkpoint is taken, then Workflow.Halt. Execution resumes only via Durability.Replay under the post-crash-replay decomposition." .

# Pre-crash forward plan (full task set).
wfc:f07-decomp-pre-crash a wfc:ExpectedDecomposition ;
    dcterms:title "method:pre-crash-forward" ;
    skos:note "arity:3" ;
    dcterms:hasPart ( wfc:f07-sub-migrate wfc:f07-sub-verify wfc:f07-sub-emit ) .

# Post-crash replay plan: migrate-records is ALREADY EVIDENCED, so the replay set
# must be exactly (verify-counts, emit-receipt).
wfc:f07-decomp-replay a wfc:ExpectedDecomposition ;
    dcterms:title "method:post-crash-replay" ;
    skos:note "arity:2" ;
    dcterms:hasPart ( wfc:f07-sub-verify wfc:f07-sub-emit ) .

# Completion receipt for the pre-crash-completed task - the evidence that
# replay must respect.
wfc:f07-receipt-migrate a prov:Entity ;
    dcterms:type "evidence:completion-receipt" ;
    dcterms:title "completion-receipt:migrate-records" ;
    prov:wasGeneratedBy wfc:f07-sub-migrate .

# Expected terminal outcome of the replay.
wfc:f07-outcome-replayed-complete a wfc:ExpectedOutcome ;
    dcterms:title "outcome:replayed-complete" ;
    dcterms:type "outcome:success" ;
    dcterms:description "Replay reaches the goal: verify-counts and emit-receipt complete with fresh completion receipts, migrate-records executes exactly once (its pre-crash receipt is reused, never re-earned), and the workflow emits a whole-workflow receipt binding all three task receipts." .

wfc:f07-closure-persist a wfc:ProviderClosure ;
    dcterms:title "AshAffidavit.Resource.Persist" ;
    dcterms:description "observed at ~/ash_affidavit/lib/ash_affidavit/persist.ex; realizes Durability.Checkpoint (durable checkpoint store)." .

wfc:f07-closure-verify a wfc:ProviderClosure ;
    dcterms:title "AshAffidavit.Resource.Verify" ;
    dcterms:description "observed at ~/ash_affidavit/lib/ash_affidavit/verify.ex; with AshAffidavit.Refusal realizes Evidence.Bind verification and typed refusal of re-execution attempts against live receipts." .

wfc:f07-closure-file a wfc:ProviderClosure ;
    dcterms:title "Reactor.File.WriteFile" ;
    dcterms:description "reactor_file (hex package; provider metadata only, no local inspection) realizes File.Write for migrate-records." .

wfc:f07-closure-pplan a wfc:ProviderClosure ;
    dcterms:title "ash_pplan v26.9.30 replay-resume loop" ;
    dcterms:description "expected consumer closure at ~/ash_pplan (built in parallel; READ-ONLY): realizes Durability.Replay and Workflow.Resume. Expected, not yet observed." .

wfc:f07-falsifier a wfc:Falsifier ;
    wfc:falsifierStatement "The engine fails this fixture if the post-crash replay re-executes a task that already has a completion receipt (migrate-records), or if the replay drops any task that has no completion receipt (verify-counts, emit-receipt) from the replay set - losing an outcome." .
