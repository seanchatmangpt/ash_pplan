@prefix wfc: <https://ggen.dev/ontology/workflow-corpus#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ANTI-VACUITY WITNESS for gates/f06_fond_replanning.rq.
# Malformed variant (untyped recovery): the failure outcome carries a
# dcterms:relation, but the target is an untyped node with no prov:Activity
# type - not a typed recovery task. The gate MUST return at least one row
# (E-F06-NO-RECOVERY-PATH) against this graph.

wfc:nf06b a wfc:WorkflowFixture ;
    dcterms:identifier "workflow-corpus-fixture-06-negative-untyped-recovery" ;
    wfc:fixtureNumber 6 ;
    wfc:expectedOutcome wfc:nf06b-refused .

wfc:nf06b-refused a wfc:ExpectedOutcome ;
    dcterms:title "outcome:endpoint-unreachable" ;
    dcterms:type "outcome:failure" ;
    dcterms:relation wfc:nf06b-ghost .

wfc:nf06b-ghost dcterms:title "pretend-recovery" .
