@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== CLASSES =====
# The five lawful state stages a subject moves through, in order:
#   ObservedState -> SelectedState -> ConstructedState -> ExecutedState -> VerifiedState
# Each stage is a real class; a concrete State individual is typed as exactly
# one stage class and linked to its predecessor stage (for the same subject)
# via st:precedes. "No skipping stages": a st:VerifiedState claim about a
# subject must trace back, via one or more st:precedes hops, to a real
# st:ExecutedState individual for that same subject -- enforced structurally
# here, refused if violated by gates/010_no_skipping_executed.rq.
st:Subject a rdfs:Class .
st:State a rdfs:Class .
st:ObservedState rdfs:subClassOf st:State .
st:SelectedState rdfs:subClassOf st:State .
st:ConstructedState rdfs:subClassOf st:State .
st:ExecutedState rdfs:subClassOf st:State .
st:VerifiedState rdfs:subClassOf st:State .

# ===== PROPERTIES =====
st:forSubject a rdf:Property ; rdfs:domain st:State ; rdfs:range st:Subject .
st:precedes a rdf:Property ; rdfs:domain st:State ; rdfs:range st:State .
st:stateId a rdf:Property ; rdfs:domain st:State ; rdfs:range xsd:string .

# ===== REAL INDIVIDUALS: one concrete subject =====
# Worked example: this exact pack's own admission into the marketplace
# catalog is the subject under state transition. It carries a full run
# through all five stages with real, ordered precedes edges between each
# consecutive pair.
st:StateTransitionPackAdmission a st:Subject ;
    rdfs:label "Admission of packs/state-transition-pack into the marketplace catalog" .

st:Observed-StateTransitionPack-001 a st:ObservedState ;
    st:stateId "state-transition-pack/admission/observed/001" ;
    st:forSubject st:StateTransitionPackAdmission ;
    rdfs:label "Candidate pack directory observed on disk with a pack.toml and ontology.ttl" .

st:Selected-StateTransitionPack-001 a st:SelectedState ;
    st:stateId "state-transition-pack/admission/selected/001" ;
    st:forSubject st:StateTransitionPackAdmission ;
    rdfs:label "Pack selected for real qualification against the native ggen runtime" .

st:Constructed-StateTransitionPack-001 a st:ConstructedState ;
    st:stateId "state-transition-pack/admission/constructed/001" ;
    st:forSubject st:StateTransitionPackAdmission ;
    rdfs:label "Pack directory materialized: pack.toml, ontology.ttl, gate, qualification fixture" .

st:Executed-StateTransitionPack-001 a st:ExecutedState ;
    st:stateId "state-transition-pack/admission/executed/001" ;
    st:forSubject st:StateTransitionPackAdmission ;
    rdfs:label "qualify_pack() actually run against the pack via the native ggen binary" .

st:Verified-StateTransitionPack-001 a st:VerifiedState ;
    st:stateId "state-transition-pack/admission/verified/001" ;
    st:forSubject st:StateTransitionPackAdmission ;
    rdfs:label "qualify_pack() returned status ALIVE with no REFUSED code" .

# Ordered transition edges: each stage precedes the next for the same subject.
st:Observed-StateTransitionPack-001 st:precedes st:Selected-StateTransitionPack-001 .
st:Selected-StateTransitionPack-001 st:precedes st:Constructed-StateTransitionPack-001 .
st:Constructed-StateTransitionPack-001 st:precedes st:Executed-StateTransitionPack-001 .
st:Executed-StateTransitionPack-001 st:precedes st:Verified-StateTransitionPack-001 .

st:ObservedState a rdfs:Class .
st:AdmittedState a rdfs:Class ;
  rdfs:comment "Observed or derived state that passed the applicable admission boundary." .
st:CandidateState a rdfs:Class ;
  rdfs:comment "State candidate not yet admitted as canonical truth." .
st:SelectedState a rdfs:Class .
st:ConstructedState a rdfs:Class .
st:ExecutedState a rdfs:Class ;
  rdfs:comment "State recording that a consequence-bearing transition was executed; execution alone does not imply observation, admission, or verification." .
st:VerifiedState a rdfs:Class ;
  rdfs:comment "State supported by the verifier appropriate to the exact subject and boundary." .
st:TransitionBoundary a rdfs:Class .
st:OutcomeRecord a rdfs:Class .

st:precedes a rdf:Property .
st:records a rdf:Property .
st:boundedBy a rdf:Property .
st:admittedFrom a rdf:Property .
st:candidateFor a rdf:Property .
st:executedFrom a rdf:Property .
st:verifiedFrom a rdf:Property .
st:supersedesState a rdf:Property .

# ===== FSM INDIVIDUAL SCHEMA (26.9.13) =====
# A st:Machine owns st:State individuals (st:inMachine, st:seq, st:stateName),
# st:Transition individuals (st:from, st:to, st:kind, st:transitionName) and
# st:Guard individuals (st:guardName, st:predicateKey) attached with st:guardedBy.
# Templates project enum + transition table + guard dispatch for ts/py/rs/ex.
st:Machine a rdfs:Class .
st:Transition a rdfs:Class .
st:Guard a rdfs:Class .
st:machineName a rdf:Property ; rdfs:domain st:Machine ; rdfs:range xsd:string .
st:initial a rdf:Property ; rdfs:domain st:Machine ; rdfs:range st:State .
st:inMachine a rdf:Property ; rdfs:range st:Machine .
st:stateName a rdf:Property ; rdfs:domain st:State ; rdfs:range xsd:string .
st:seq a rdf:Property ; rdfs:domain st:State ; rdfs:range xsd:integer .
st:transitionName a rdf:Property ; rdfs:domain st:Transition ; rdfs:range xsd:string .
st:from a rdf:Property ; rdfs:domain st:Transition ; rdfs:range st:State .
st:to a rdf:Property ; rdfs:domain st:Transition ; rdfs:range st:State .
st:kind a rdf:Property ; rdfs:domain st:Transition ; rdfs:comment "advance (must go to seq+1), retry, or abort" .
st:guardedBy a rdf:Property ; rdfs:domain st:Transition ; rdfs:range st:Guard .
st:guardName a rdf:Property ; rdfs:domain st:Guard ; rdfs:range xsd:string .
st:predicateKey a rdf:Property ; rdfs:domain st:Guard ; rdfs:range xsd:string .

# ===== FSM LOOP MODEL (26.9.13) =====
# The closed loop of patterns/fond-hddl-mx-loop as a st:Machine:
#   O_t -> HDDL -> FOND -> SELECT -> CONSTRUCT -> BRCE -> R_t -> Replay -> MX -> O_{t+1}
# Nine states in an advance chain (seq n -> n+1) plus one "loop" transition
# closing MX back to O_{t+1}.
st:MxLoopMachine a st:Machine ; st:machineName "MxLoop" ; st:initial st:MxLoopObserved .
st:MxLoopObserved a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Observed" ; st:seq 0 .
st:MxLoopDecomposed a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Decomposed" ; st:seq 1 .
st:MxLoopPlanned a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Planned" ; st:seq 2 .
st:MxLoopSelected a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Selected" ; st:seq 3 .
st:MxLoopConstructed a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Constructed" ; st:seq 4 .
st:MxLoopExecuted a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Executed" ; st:seq 5 .
st:MxLoopReceipted a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Receipted" ; st:seq 6 .
st:MxLoopReplayed a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Replayed" ; st:seq 7 .
st:MxLoopExperienced a st:State ; st:inMachine st:MxLoopMachine ; st:stateName "Experienced" ; st:seq 8 .

st:MxLoopExecuteGuard a st:Guard ; st:guardName "admitted" ; st:predicateKey "admitted" .
st:MxLoopDecompose a st:Transition ; st:transitionName "decompose" ; st:kind "advance" ; st:from st:MxLoopObserved ; st:to st:MxLoopDecomposed .
st:MxLoopPlan a st:Transition ; st:transitionName "plan" ; st:kind "advance" ; st:from st:MxLoopDecomposed ; st:to st:MxLoopPlanned .
st:MxLoopSelect a st:Transition ; st:transitionName "select" ; st:kind "advance" ; st:from st:MxLoopPlanned ; st:to st:MxLoopSelected .
st:MxLoopConstruct a st:Transition ; st:transitionName "construct" ; st:kind "advance" ; st:from st:MxLoopSelected ; st:to st:MxLoopConstructed .
st:MxLoopExecute a st:Transition ; st:transitionName "execute" ; st:kind "advance" ; st:from st:MxLoopConstructed ; st:to st:MxLoopExecuted ; st:guardedBy st:MxLoopExecuteGuard .
st:MxLoopReceipt a st:Transition ; st:transitionName "receipt" ; st:kind "advance" ; st:from st:MxLoopExecuted ; st:to st:MxLoopReceipted .
st:MxLoopReplay a st:Transition ; st:transitionName "replay" ; st:kind "advance" ; st:from st:MxLoopReceipted ; st:to st:MxLoopReplayed .
st:MxLoopRecord a st:Transition ; st:transitionName "record" ; st:kind "advance" ; st:from st:MxLoopReplayed ; st:to st:MxLoopExperienced .
st:MxLoopNext a st:Transition ; st:transitionName "next" ; st:kind "loop" ; st:from st:MxLoopExperienced ; st:to st:MxLoopObserved .

# ===== CHAIN POLICY (26.9.13) =====
# st:ChainPolicy picks the receipt-chain digest. The active policy is the one
# with the highest st:policyPrecedence; gates/050 refuses a policy whose
# algorithm lacks a st:HashImpl for any language in st:policyLanguage.
# Bun 1.3.7 has no BLAKE3, so no BLAKE3 individual exists. blake2b256 is
# catalogued only where a real 256-bit implementation exists (python hashlib).
st:ChainPolicy a rdfs:Class .
st:HashImpl a rdfs:Class .
st:chosenAlgo a rdf:Property ; rdfs:domain st:ChainPolicy .
st:policyPrecedence a rdf:Property ; rdfs:domain st:ChainPolicy ; rdfs:range xsd:integer .
st:policyLanguage a rdf:Property ; rdfs:domain st:ChainPolicy .
st:implAlgo a rdf:Property ; rdfs:domain st:HashImpl .
st:implLanguage a rdf:Property ; rdfs:domain st:HashImpl .
st:implImport a rdf:Property ; rdfs:domain st:HashImpl .
st:implExpr a rdf:Property ; rdfs:domain st:HashImpl ; rdfs:comment "expression over a string variable named data yielding a lowercase hex digest" .
st:implHelper a rdf:Property ; rdfs:domain st:HashImpl ; rdfs:comment "optional helper source emitted before the digest function" .

st:DefaultChainPolicy a st:ChainPolicy ; st:chosenAlgo "sha256" ; st:policyPrecedence 0 ;
    st:policyLanguage "ts", "py", "rs", "ex" .

st:Sha256Ts a st:HashImpl ; st:implAlgo "sha256" ; st:implLanguage "ts" ;
    st:implImport "import { createHash } from \"node:crypto\";" ;
    st:implExpr "createHash(\"sha256\").update(data).digest(\"hex\")" .
st:Sha256Py a st:HashImpl ; st:implAlgo "sha256" ; st:implLanguage "py" ;
    st:implImport "import hashlib" ;
    st:implExpr "hashlib.sha256(data.encode()).hexdigest()" .
st:Sha256Ex a st:HashImpl ; st:implAlgo "sha256" ; st:implLanguage "ex" ;
    st:implExpr ":crypto.hash(:sha256, data) |> Base.encode16(case: :lower)" .
st:Sha256Rs a st:HashImpl ; st:implAlgo "sha256" ; st:implLanguage "rs" ;
    st:implExpr "sha256_hex(data.as_bytes())" ;
    st:implHelper """const K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

fn sha256_hex(input: &[u8]) -> String {
    let mut h: [u32; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    ];
    let mut msg = input.to_vec();
    msg.push(0x80);
    while msg.len() % 64 != 56 {
        msg.push(0);
    }
    msg.extend_from_slice(&((input.len() as u64) * 8).to_be_bytes());
    for chunk in msg.chunks(64) {
        let mut w = [0u32; 64];
        for i in 0..16 {
            w[i] = u32::from_be_bytes([chunk[4 * i], chunk[4 * i + 1], chunk[4 * i + 2], chunk[4 * i + 3]]);
        }
        for i in 16..64 {
            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
        }
        let mut v = h;
        for i in 0..64 {
            let s1 = v[4].rotate_right(6) ^ v[4].rotate_right(11) ^ v[4].rotate_right(25);
            let ch = (v[4] & v[5]) ^ (!v[4] & v[6]);
            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(K[i]).wrapping_add(w[i]);
            let s0 = v[0].rotate_right(2) ^ v[0].rotate_right(13) ^ v[0].rotate_right(22);
            let maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]);
            let t2 = s0.wrapping_add(maj);
            v = [t1.wrapping_add(t2), v[0], v[1], v[2], v[3].wrapping_add(t1), v[4], v[5], v[6]];
        }
        for i in 0..8 {
            h[i] = h[i].wrapping_add(v[i]);
        }
    }
    h.iter().map(|x| format!("{:08x}", x)).collect()
}""" .

st:Blake2b256Py a st:HashImpl ; st:implAlgo "blake2b256" ; st:implLanguage "py" ;
    st:implImport "import hashlib" ;
    st:implExpr "hashlib.blake2b(data.encode(), digest_size=32).hexdigest()" .
