@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
es:W060PassPending a es:ChainEntry ; es:chainId "w060-pass" ;
    es:chainPolicy es:DefaultChainPolicy ;
    es:entryPhase es:PhasePending ; es:entryStanding es:UNKNOWN ; es:entryAction "task" .
es:W060PassOutcome a es:ChainEntry ; es:chainId "w060-pass" ;
    es:chainPolicy es:DefaultChainPolicy ;
    es:entryPhase es:PhaseOutcome ; es:entryStanding es:ALIVE ; es:entryAction "task" ;
    es:pendingEntry es:W060PassPending .
