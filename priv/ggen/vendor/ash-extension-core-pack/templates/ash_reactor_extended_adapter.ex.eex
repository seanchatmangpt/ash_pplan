---
to: "lib/{{ adapter_package_name }}/reactor/adapters/ash_reactor_extended.ex"
sparql:
  spec: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT ?adapter_package_name ?adapter_module_name ?adapter_id WHERE {
      ?spec a aex:ReactorAdapterSpec ;
            aex:adapterPackageName ?adapter_package_name ;
            aex:adapterModuleName ?adapter_module_name ;
            aex:adapterId ?adapter_id .
    }
  ops: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT ?op_name ?op_step_module WHERE {
      ?op a aex:ReactorAdapterOp ;
          aex:adapterOpOf ?spec ;
          aex:adapterOpName ?op_name ;
          aex:adapterOpStepModule ?op_step_module ;
          aex:adapterOpOrder ?op_order .
    }
    ORDER BY ?op_order
---
<%= "# GENERATED by ggen_igniter from ash-extension-core-pack ontology.ttl (aex:AshPPlanAshReactorExtended)." %>
<%= "# Do not edit. Regenerate with ./bin/manufacture." %>

<%
# Companion adapter covering the Ash.Reactor step kinds the consumer's
# existing domain-action adapter does not implement itself. Generated from
# aex:ReactorAdapterSpec / aex:ReactorAdapterOp rows -- regenerate via
# `mix ggen_igniter.sync`, never hand-edit.
%>
defmodule <%= adapter_module_name %> do
  @moduledoc """
  Companion adapter extending `AshPPlan.Reactor.Adapters.AshReactor`'s
  domain-action coverage (create/read/update/destroy/action) with the
  Ash.Reactor step kinds it does not implement itself: generic actions,
  ash_step, read_one, load, and the bulk kinds. Generated from
  `aex:AshPPlanAshReactorExtended` (`aex:ReactorAdapterSpec`) and its
  `aex:ReactorAdapterOp` rows in the ash-extension-core-pack ontology --
  regenerate, do not hand-edit.
  """
  @behaviour AshPPlan.Reactor.Adapter

  @impl true
  def id, do: :<%= adapter_id %>

  @impl true
  def available?, do: Code.ensure_loaded?(Ash.Reactor)

  @impl true
  def ops,
    do: [
<%= Enum.map_join(ops, ",\n", fn op -> "      :" <> op["op_name"] end) %>
    ]

  @table %{
<%= Enum.map_join(ops, ",\n", fn op -> "    #{op["op_name"]}: {#{op["op_step_module"]}, []}" end) %>
  }

  @impl true
  def step(op, options), do: AshPPlan.Reactor.Adapter.resolve(__MODULE__, @table, op, options)
end
