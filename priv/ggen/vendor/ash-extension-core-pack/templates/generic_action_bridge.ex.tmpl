---
to: "lib/{{ package_name }}/reactor/generic_action_bridge.ex"
for_each: "bridge"
sparql:
  bridge: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT DISTINCT ?package_name ?module_name ?domain_module ?action_name ?reactor_module ?transactional WHERE {
      ?b a aex:ReactorActionBridge ;
         aex:bridgePackageName ?package_name ;
         aex:bridgeModule ?module_name ;
         aex:bridgeDomainModule ?domain_module ;
         aex:bridgeActionName ?action_name ;
         aex:bridgeReactorModule ?reactor_module ;
         aex:bridgeTransactional ?transactional .
    }
  inputs: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT ?module_name ?input_name ?input_type ?input_required ?input_order WHERE {
      ?i a aex:BridgeInput ;
         aex:bridgeInputOf ?b ;
         aex:bridgeInputName ?input_name ;
         aex:bridgeInputType ?input_type ;
         aex:bridgeInputRequired ?input_required .
      ?b aex:bridgeModule ?module_name .
    }
    ORDER BY ?module_name ?input_order
---
{# Reactor-as-generic-action bridge. 2026-10-03 research finding: an Ash
   generic action may bind a Reactor module directly as its `run` (the
   documented preferred initiation pattern). Two caveats are carried in the
   generated moduledoc rather than silently dropped:
   (1) every Reactor `input` of the bound module must map to an action
       argument -- the generated bridge re-checks the mapping at runtime with
       check_input_mapping/0 (compiled action arguments vs admitted inputs);
   (2) `transaction? true` on the action forces the Reactor to run
       synchronously (async?: false); the declared transactional? value is
       stated in the doc. #}
defmodule {{ module_name }}.Domain do
  @moduledoc false
  use Ash.Domain, validate_config_inclusion?: false

  resources do
    resource {{ module_name }}
  end
end

defmodule {{ module_name }} do
  @moduledoc """
  GENERATED by ggen_igniter from the ash-extension-core-pack ontology
  (aex:ReactorActionBridge). Do not edit; regenerate with
  `mix ggen_igniter.sync --pack-dir <ash-extension-core-pack> --template
  templates/generic_action_bridge.ex.tmpl --engine oxigraph
  --out lib/{{ package_name }}/reactor/generic_action_bridge.ex`.

  Binds a Reactor module ({{ reactor_module }}) directly as the `run` of an
  Ash generic action ({{ action_name }}) -- the documented preferred
  initiation pattern for Reactor-backed generic actions.

  Caveats (admitted facts, carried as doc comments):
  * Every Reactor input must map to an action argument. This bridge enforces
    the mapping at runtime: check_input_mapping/0 compares the inputs
    admitted in the ontology against the compiled action arguments and
    refuses on any unmapped input.
  * `transaction? true` on the action forces the Reactor to run
    synchronously (async?: false), so every step executes inside the
    enclosing transaction. This bridge declares transactional: {{ transactional }}.
  """

  use Ash.Resource,
    domain: {{ domain_module }},
    data_layer: Ash.DataLayer.Ets

  ets do
    private? true
  end

  attributes do
    uuid_primary_key :id
  end

  actions do
    defaults [:read]

    action :{{ action_name }}, :map do
{% for i in inputs %}{% if i.module_name == module_name %}
      argument :{{ i.input_name }}, {% if i.input_type == "integer" %}:integer{% elif i.input_type == "string" %}:string{% else %}:term{% endif %}{% if i.input_required %}, allow_nil?: false{% endif %}
{% endif %}{% endfor %}
      run {{ reactor_module }}
    end
  end

  @doc """
  Runtime check that every admitted Reactor input maps to a real action
  argument on {{ action_name }}. Returns `{:error, {:unmapped_inputs, ...}}`
  when the bound reactor has an input the action does not accept.
  """
  def check_input_mapping do
    arguments =
      {{ module_name }}
      |> Ash.Resource.Info.action(:{{ action_name }})
      |> Map.fetch!(:arguments)
      |> MapSet.new(& &1.name)

    admitted = MapSet.new(input_names())

    case MapSet.difference(admitted, arguments) |> MapSet.to_list() do
      [] -> :ok
      unmapped -> {:error, {:unmapped_inputs, unmapped}}
    end
  end

  @doc "Reactor inputs admitted in the ontology for the bound reactor."
  def input_names do
    [{% for i in inputs %}{% if i.module_name == module_name %}{% if not loop.first %}, {% endif %}:{{ i.input_name }}{% endif %}{% endfor %}]
  end

  @doc "Atom names of the action arguments rendered from the same input rows."
  def argument_names do
    [{% for i in inputs %}{% if i.module_name == module_name %}{% if not loop.first %}, {% endif %}:{{ i.input_name }}{% endif %}{% endfor %}]
  end
end

defmodule {{ reactor_module }} do
  @moduledoc """
  GENERATED Reactor bound as the `run` of `{{ module_name }}.{{ action_name }}/2`.
  One `input` per action argument (checked by check_input_mapping/0).
  """
  use Reactor

{% for i in inputs %}{% if i.module_name == module_name %}
  input :{{ i.input_name }}
{% endif %}{% endfor %}

  step :bridge_step do
{% for i in inputs %}{% if i.module_name == module_name %}
    argument :{{ i.input_name }}, input(:{{ i.input_name }})
{% endif %}{% endfor %}
    run fn arguments, _context ->
      {:ok, %{bridged: arguments}}
    end
  end

  return :bridge_step
end
