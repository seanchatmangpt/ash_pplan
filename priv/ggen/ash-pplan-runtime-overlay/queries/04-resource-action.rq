PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
SELECT ?integration ?resource_module ?domain_module ?data_layer ?action_module WHERE {
  ?integration a rt:Integration ; rt:resourceModule ?resource_module ; rt:domainModule ?domain_module ;
    rt:dataLayer ?data_layer ; rt:actionModule ?action_module .
}
ORDER BY ?integration ?resource_module
