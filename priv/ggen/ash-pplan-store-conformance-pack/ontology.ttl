@prefix sc: <https://w3id.org/ash-pplan/store-conformance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Store conformance ontology. Source of truth for test/support/durable/store_conformance.ex.
# Every AshPPlan.Reactor.Durable.Store callback is a sc:Callback; every behavioural law is a
# sc:Law that sc:covers callbacks and carries an executable Elixir sc:body. In a body, `mod` is
# the store module under test and `s` the started store with run "r1" (model :m, bindings %{a: 1})
# already inserted. The template refuses to render when a callback is covered by no law.

<https://w3id.org/ash-pplan/store-conformance> a owl:Ontology ;
    dcterms:title "ash_pplan durable Store conformance laws" ;
    owl:versionInfo "26.10.1" .

sc:Callback a rdfs:Class ; rdfs:label "Store behaviour callback" .
sc:Law a rdfs:Class ; rdfs:label "Store behavioural law" .

sc:cb_start_run a sc:Callback ; sc:callbackName "start_run" ; sc:arity 2 .
sc:cb_get_run a sc:Callback ; sc:callbackName "get_run" ; sc:arity 2 .
sc:cb_list_runs a sc:Callback ; sc:callbackName "list_runs" ; sc:arity 1 .
sc:cb_transition a sc:Callback ; sc:callbackName "transition" ; sc:arity 5 .
sc:cb_claim a sc:Callback ; sc:callbackName "claim" ; sc:arity 5 .
sc:cb_release_claim a sc:Callback ; sc:callbackName "release_claim" ; sc:arity 3 .
sc:cb_checkpoints a sc:Callback ; sc:callbackName "checkpoints" ; sc:arity 2 .
sc:cb_standing a sc:Callback ; sc:callbackName "standing" ; sc:arity 2 .
sc:cb_record a sc:Callback ; sc:callbackName "record" ; sc:arity 6 .
sc:cb_claim_undo a sc:Callback ; sc:callbackName "claim_undo" ; sc:arity 4 .
sc:cb_release_undo a sc:Callback ; sc:callbackName "release_undo" ; sc:arity 3 .
sc:cb_deliver_signal a sc:Callback ; sc:callbackName "deliver_signal" ; sc:arity 4 .
sc:cb_pending_signal a sc:Callback ; sc:callbackName "pending_signal" ; sc:arity 3 .
sc:cb_consume_signal a sc:Callback ; sc:callbackName "consume_signal" ; sc:arity 3 .
sc:cb_park a sc:Callback ; sc:callbackName "park" ; sc:arity 6 .
sc:cb_get_waiter a sc:Callback ; sc:callbackName "get_waiter" ; sc:arity 3 .
sc:cb_waiters a sc:Callback ; sc:callbackName "waiters" ; sc:arity 2 .
sc:cb_release a sc:Callback ; sc:callbackName "release" ; sc:arity 3 .
sc:cb_release_all a sc:Callback ; sc:callbackName "release_all" ; sc:arity 2 .
sc:cb_signals a sc:Callback ; sc:callbackName "signals" ; sc:arity 2 .

sc:law_start_run_exclusive a sc:Law ;
    sc:lawId "start_run_exclusive" ; sc:order 10 ;
    sc:statement "start_run is exclusive per id; get_run/list_runs round-trip in insertion order; parent is stored" ;
    sc:covers sc:cb_start_run, sc:cb_get_run, sc:cb_list_runs ;
    sc:body """
assert {:error, :exists} = mod.start_run(s, %{id: "r1"})
{:ok, c} = mod.start_run(s, %{id: "r2", parent: {"r1", "sig"}})
assert c.parent_id == "r1" and c.parent_signal == "sig"
assert c.status == :pending and c.version == 1
assert mod.get_run(s, "r1").bindings == %{a: 1}
assert mod.get_run(s, "nope") == nil
assert Enum.map(mod.list_runs(s), & &1.id) == ["r1", "r2"]
""" .

sc:law_transition_guarded a sc:Law ;
    sc:lawId "transition_guarded" ; sc:order 20 ;
    sc:statement "transition applies only from an allowed status: ok bumps version, stale, illegal, not_found; terminal is absorbing" ;
    sc:covers sc:cb_transition, sc:cb_get_run ;
    sc:body """
v = mod.get_run(s, "r1").version
assert {:ok, r} = mod.transition(s, "r1", [:pending], :waiting, %{})
assert r.status == :waiting and r.version == v + 1
assert {:error, :stale} = mod.transition(s, "r1", [:pending], :completed, %{})
assert {:error, :illegal} = mod.transition(s, "r1", :any, :cancelled, %{})
assert {:error, :not_found} = mod.transition(s, "zz", :any, :failed, %{})
assert {:ok, %{result: 42}} = mod.transition(s, "r1", :any, :completed, %{result: 42})
assert {:error, :stale} = mod.transition(s, "r1", :any, :failed, %{})
assert mod.get_run(s, "r1").status == :completed
assert mod.get_run(s, "r1").result == 42
""" .

sc:law_claim_lease a sc:Law ;
    sc:lawId "claim_lease" ; sc:order 30 ;
    sc:statement "claim is free when unclaimed, lease lapsed, or the same claimer re-enters; a nil claimer never re-enters" ;
    sc:covers sc:cb_claim, sc:cb_get_run ;
    sc:body """
t0 = @t0
assert {:ok, r} = mod.claim(s, "r1", :a, 1000, t0)
assert r.claimed_by == :a
assert :taken = mod.claim(s, "r1", :b, 1000, DateTime.add(t0, 500, :millisecond))
assert {:ok, _} = mod.claim(s, "r1", :a, 1000, DateTime.add(t0, 500, :millisecond))
assert {:ok, r} = mod.claim(s, "r1", :b, 1000, DateTime.add(t0, 5000, :millisecond))
assert r.claimed_by == :b
assert {:ok, _} = mod.claim(s, "r1", nil, 1000, DateTime.add(t0, 20_000, :millisecond))
assert :taken = mod.claim(s, "r1", nil, 1000, DateTime.add(t0, 20_001, :millisecond))
assert {:ok, _} = mod.claim(s, "r1", nil, 1000, DateTime.add(t0, 21_000, :millisecond))
assert :taken = mod.claim(s, "missing", :a, 10, t0)
""" .

sc:law_claim_exclusive_concurrent a sc:Law ;
    sc:lawId "claim_exclusive_concurrent" ; sc:order 40 ;
    sc:statement "concurrent claim has exactly one winner" ;
    sc:covers sc:cb_claim ;
    sc:body """
t0 = @t0

results =
  1..32
  |> Task.async_stream(fn n -> mod.claim(s, "r1", {:c, n}, 60_000, t0) end, max_concurrency: 32)
  |> Enum.map(fn {:ok, r} -> r end)

assert Enum.count(results, &match?({:ok, _}, &1)) == 1
assert Enum.count(results, &(&1 == :taken)) == 31
""" .

sc:law_release_claim_owner_only a sc:Law ;
    sc:lawId "release_claim_owner_only" ; sc:order 50 ;
    sc:statement "release_claim clears only the holder's claim; it is idempotent and a no-op for others" ;
    sc:covers sc:cb_release_claim, sc:cb_claim, sc:cb_get_run ;
    sc:body """
t0 = @t0
assert {:ok, _} = mod.claim(s, "r1", :a, 60_000, t0)
assert :ok = mod.release_claim(s, "r1", :b)
assert mod.get_run(s, "r1").claimed_by == :a
assert :ok = mod.release_claim(s, "r1", :a)
assert mod.get_run(s, "r1").claimed_by == nil
assert :ok = mod.release_claim(s, "r1", :a)
assert :ok = mod.release_claim(s, "missing", :a)
assert {:ok, _} = mod.claim(s, "r1", :b, 60_000, t0)
""" .

sc:law_record_insert_or_adopt a sc:Law ;
    sc:lawId "record_insert_or_adopt" ; sc:order 60 ;
    sc:statement "record is insert-or-adopt: a second write for (run, key) returns the standing checkpoint unchanged" ;
    sc:covers sc:cb_record, sc:cb_checkpoints ;
    sc:body """
{:ok, a} = mod.record(s, "r1", "k1", "one", 1, %{impl: Foo, args: %{x: 1}})
{:ok, b} = mod.record(s, "r1", "k2", "two", 2, %{})
{:ok, a2} = mod.record(s, "r1", "k1", "one", 999, %{})
assert a2 == a and a2.output == 1 and a.impl == Foo and a.args == %{x: 1}
assert b.seq > a.seq
assert Map.keys(mod.checkpoints(s, "r1")) |> Enum.sort() == ["k1", "k2"]
assert mod.checkpoints(s, "r1")["k1"].output == 1
""" .

sc:law_record_concurrent_adopts a sc:Law ;
    sc:lawId "record_concurrent_adopts" ; sc:order 70 ;
    sc:statement "concurrent record leaves one standing row and every caller sees the first output" ;
    sc:covers sc:cb_record, sc:cb_standing ;
    sc:body """
outs =
  1..24
  |> Task.async_stream(fn n -> mod.record(s, "r1", "k", "l", n, %{}) end, max_concurrency: 24)
  |> Enum.map(fn {:ok, {:ok, cp}} -> cp.output end)

assert length(Enum.uniq(outs)) == 1
assert length(mod.standing(s, "r1")) == 1
""" .

sc:law_standing_ordered_by_seq a sc:Law ;
    sc:lawId "standing_ordered_by_seq" ; sc:order 80 ;
    sc:statement "standing lists non-undone checkpoints of one run in seq order; checkpoints are scoped per run" ;
    sc:covers sc:cb_standing, sc:cb_checkpoints, sc:cb_record ;
    sc:body """
{:ok, _} = mod.start_run(s, %{id: "r2"})
{:ok, a} = mod.record(s, "r1", "z", "first", 1, %{})
{:ok, _} = mod.record(s, "r2", "x", "other", 0, %{})
{:ok, b} = mod.record(s, "r1", "a", "second", 2, %{})
{:ok, c} = mod.record(s, "r1", "m", "third", 3, %{})
assert a.seq < b.seq and b.seq < c.seq
assert Enum.map(mod.standing(s, "r1"), & &1.label) == ["first", "second", "third"]
assert Enum.map(mod.standing(s, "r2"), & &1.label) == ["other"]
assert mod.standing(s, "none") == []
assert mod.checkpoints(s, "none") == %{}
""" .

sc:law_terminal_refuses_checkpoints a sc:Law ;
    sc:lawId "terminal_refuses_checkpoints" ; sc:order 90 ;
    sc:statement "a terminal run refuses new checkpoints but still adopts a standing one" ;
    sc:covers sc:cb_record, sc:cb_transition, sc:cb_checkpoints ;
    sc:body """
{:ok, a} = mod.record(s, "r1", "k1", "one", 1, %{})
{:ok, _} = mod.transition(s, "r1", :any, :completed, %{})
assert {:error, :terminal} = mod.record(s, "r1", "k2", "two", 2, %{})
assert {:ok, again} = mod.record(s, "r1", "k1", "one", 999, %{})
assert again == a
assert Map.keys(mod.checkpoints(s, "r1")) == ["k1"]
""" .

sc:law_undo_once a sc:Law ;
    sc:lawId "undo_once" ; sc:order 100 ;
    sc:statement "claim_undo is consume-once per checkpoint and removes it from standing; release_undo reopens it" ;
    sc:covers sc:cb_claim_undo, sc:cb_release_undo, sc:cb_standing ;
    sc:body """
t0 = @t0
{:ok, _} = mod.record(s, "r1", "k", "l", 1, %{})
assert {:ok, cp} = mod.claim_undo(s, "r1", "k", t0)
assert cp.undone_at == t0
assert :taken = mod.claim_undo(s, "r1", "k", t0)
assert mod.standing(s, "r1") == []
assert :ok = mod.release_undo(s, "r1", "k")
assert Enum.map(mod.standing(s, "r1"), & &1.step_key) == ["k"]
assert {:ok, _} = mod.claim_undo(s, "r1", "k", t0)
assert :taken = mod.claim_undo(s, "r1", "nokey", t0)
assert :ok = mod.release_undo(s, "r1", "nokey")
""" .

sc:law_signals_fifo_consume_once a sc:Law ;
    sc:lawId "signals_fifo_consume_once" ; sc:order 110 ;
    sc:statement "signals are FIFO per name, ids are unique, and consume_signal is consume-once" ;
    sc:covers sc:cb_deliver_signal, sc:cb_pending_signal, sc:cb_consume_signal, sc:cb_signals ;
    sc:body """
t0 = @t0
{:ok, s1} = mod.deliver_signal(s, "r1", "go", 1)
{:ok, s2} = mod.deliver_signal(s, "r1", "go", 2)
{:ok, _} = mod.deliver_signal(s, "r1", "other", 3)
assert s1.id != s2.id
assert mod.pending_signal(s, "r1", "go").id == s1.id
assert mod.pending_signal(s, "r1", "none") == nil
assert {:ok, consumed} = mod.consume_signal(s, s1.id, t0)
assert consumed.consumed_at == t0
assert :taken = mod.consume_signal(s, s1.id, t0)
assert :taken = mod.consume_signal(s, :missing, t0)
assert mod.pending_signal(s, "r1", "go").id == s2.id
assert length(mod.signals(s, "r1")) == 3
assert Enum.map(mod.signals(s, "r1"), & &1.payload) == [1, 2, 3]
assert mod.signals(s, "r2") == []
""" .

sc:law_consume_concurrent a sc:Law ;
    sc:lawId "consume_concurrent" ; sc:order 120 ;
    sc:statement "concurrent consume_signal has exactly one winner" ;
    sc:covers sc:cb_consume_signal ;
    sc:body """
t0 = @t0
{:ok, sig} = mod.deliver_signal(s, "r1", "go", 1)

results =
  1..16
  |> Task.async_stream(fn _ -> mod.consume_signal(s, sig.id, t0) end, max_concurrency: 16)
  |> Enum.map(fn {:ok, r} -> r end)

assert Enum.count(results, &match?({:ok, _}, &1)) == 1
assert Enum.count(results, &(&1 == :taken)) == 15
assert mod.pending_signal(s, "r1", "go") == nil
""" .

sc:law_park_deadline_once a sc:Law ;
    sc:lawId "park_deadline_once" ; sc:order 130 ;
    sc:statement "park keeps the first deadline (measured once) unless overwrite: true; waiters are listed by name" ;
    sc:covers sc:cb_park, sc:cb_get_waiter, sc:cb_waiters ;
    sc:body """
t0 = @t0
d1 = DateTime.add(t0, 1000, :millisecond)
d2 = DateTime.add(t0, 9000, :millisecond)
assert {:ok, w} = mod.park(s, "r1", "w", :signal, d1, [])
assert {:ok, ^w} = mod.park(s, "r1", "w", :signal, d2, [])
assert mod.get_waiter(s, "r1", "w").deadline == d1
assert {:ok, w2} = mod.park(s, "r1", "w", :poll, d2, overwrite: true)
assert w2.deadline == d2 and w2.kind == :poll
assert mod.get_waiter(s, "r1", "w").deadline == d2
{:ok, _} = mod.park(s, "r1", "v", :signal, nil, [])
assert Enum.map(mod.waiters(s, "r1"), & &1.name) == ["v", "w"]
assert mod.get_waiter(s, "r1", "absent") == nil
assert mod.waiters(s, "r2") == []
""" .

sc:law_release_idempotent a sc:Law ;
    sc:lawId "release_idempotent" ; sc:order 140 ;
    sc:statement "release and release_all are idempotent and scoped to the run" ;
    sc:covers sc:cb_release, sc:cb_release_all, sc:cb_park, sc:cb_waiters ;
    sc:body """
{:ok, _} = mod.start_run(s, %{id: "r2"})
{:ok, _} = mod.park(s, "r1", "w", :signal, nil, [])
{:ok, _} = mod.park(s, "r1", "v", :signal, nil, [])
{:ok, _} = mod.park(s, "r2", "w", :signal, nil, [])
assert :ok = mod.release(s, "r1", "w")
assert :ok = mod.release(s, "r1", "w")
assert mod.get_waiter(s, "r1", "w") == nil
assert mod.get_waiter(s, "r2", "w") != nil
assert :ok = mod.release_all(s, "r1")
assert :ok = mod.release_all(s, "r1")
assert mod.waiters(s, "r1") == []
assert length(mod.waiters(s, "r2")) == 1
""" .
