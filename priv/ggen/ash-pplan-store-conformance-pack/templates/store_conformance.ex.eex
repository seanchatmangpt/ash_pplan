---
to: "test/support/durable/store_conformance.ex"
mode: file
---
<%
  # Decode an RDF term serialised by the engine ("..."^^xsd:t, "..." with N-Triples escapes).
  unescape = fn body ->
    Regex.replace(~r/\\(u[0-9A-Fa-f]{4}|.)/s, body, fn _, c ->
      case c do
        "n" -> "\n"
        "t" -> "\t"
        "r" -> "\r"
        "\"" -> "\""
        "\\" -> "\\"
        "'" -> "'"
        <<"u", hex::binary-size(4)>> -> <<String.to_integer(hex, 16)::utf8>>
        other -> other
      end
    end)
  end

  scalar = fn
    nil ->
      nil

    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          unescape.(body)

        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")

        true ->
          value
      end

    value ->
      value
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  to_int = fn v -> v |> to_string() |> String.replace(~r/\^\^.*$/, "") |> String.to_integer() end

  cbs =
    callbacks
    |> normalize.()
    |> Enum.map(&{&1["name"], to_int.(&1["arity"])})
    |> Enum.uniq()
    |> Enum.sort()

  cover_rows = normalize.(covers)
  covered = cover_rows |> Enum.map(& &1["callback"]) |> MapSet.new()

  uncovered = for {n, _} <- cbs, not MapSet.member?(covered, n), do: n

  if uncovered != [] do
    raise "store-conformance ontology: callbacks covered by no law: #{inspect(uncovered)}"
  end

  covers_by_law = Enum.group_by(cover_rows, & &1["id"], & &1["callback"])

  law_list =
    laws
    |> normalize.()
    |> Enum.map(fn l ->
      %{
        id: l["id"],
        order: to_int.(l["order"]),
        statement: l["statement"],
        body: l["body"] |> String.trim() |> String.split("\n") |> Enum.map_join("\n", &("    " <> &1)),
        covers: Map.get(covers_by_law, l["id"], [])
      }
    end)
    |> Enum.uniq_by(& &1.id)
    |> Enum.sort_by(&{&1.order, &1.id})
%># GENERATED by ggen_igniter from priv/ggen/ash-pplan-store-conformance-pack/ontology.ttl.
# Do not edit. Regenerate with bin/manufacture-store-conformance.
defmodule AshPPlan.Test.StoreConformance do
  @moduledoc """
  Store conformance suite, generated from the sc:Law individuals of the store-conformance
  ontology. Each law is a plain function `law_<id>(mod, store)` that raises on violation, so one
  body serves two consumers:

    * `use AshPPlan.Test.StoreConformance, store: Module, start: fun` defines one ExUnit test per
      law against any `AshPPlan.Reactor.Durable.Store` implementation. `start` is a zero-arity
      function returning `{:ok, store}`; a fresh store is started per test and run "r1" is
      pre-inserted.
    * `run/2` executes every law against a store and returns `[{law_id, :ok | {:error, exception}}]`,
      which the anti-vacuity court uses to prove a deliberately broken store fails the suite.

  Anti-vacuity mutation: remove any `sc:covers` link (the template refuses an uncovered
  callback) or weaken a law body, and the corresponding mutant store in the conformance courts
  passes the suite.
  """
  import ExUnit.Assertions

  @t0 ~U[2026-01-01 00:00:00.000Z]

  @callbacks [
<%= for {n, a} <- cbs do %>    {:<%= n %>, <%= a %>},
<% end %>  ]

  @laws [
<%= for l <- law_list do %>    %{
      id: <%= inspect(l.id) %>,
      statement: <%= inspect(l.statement) %>,
      covers: <%= inspect(l.covers) %>
    },
<% end %>  ]

  @doc "Callbacks (name, arity) declared by the ontology."
  @spec callbacks() :: [{atom(), non_neg_integer()}]
  def callbacks, do: @callbacks

  @doc "Laws (id, statement, covered callbacks) declared by the ontology."
  @spec laws() :: [%{id: String.t(), statement: String.t(), covers: [String.t()]}]
  def laws, do: @laws

  @doc "Fixed clock used by the laws."
  def t0, do: @t0

  @doc "Starts a fresh store via `start` (returning `{:ok, store}`) with run \"r1\" inserted."
  def boot(mod, start) do
    {:ok, s} = start.()
    {:ok, _} = mod.start_run(s, %{id: "r1", model: :m, bindings: %{a: 1}})
    s
  end

  @doc "Runs every law against `mod` on a fresh store each; returns per-law outcomes."
  @spec run(module(), (-> {:ok, term()})) :: [{String.t(), :ok | {:error, Exception.t()}}]
  def run(mod, start) do
    for %{id: id} <- @laws do
      s = boot(mod, start)

      outcome =
        try do
          run_law(id, mod, s)
          :ok
        rescue
          e -> {:error, e}
        catch
          kind, reason -> {:error, %RuntimeError{message: "#{kind}: #{inspect(reason)}"}}
        after
          if is_pid(s) and Process.alive?(s), do: GenServer.stop(s, :normal)
        end

      {id, outcome}
    end
  end

  @doc "Dispatches one law by id."
<%= for l <- law_list do %>  def run_law(<%= inspect(l.id) %>, mod, s), do: law_<%= l.id %>(mod, s)
<% end %>
<%= for l <- law_list do %>
  @doc <%= inspect(l.statement) %>
  def law_<%= l.id %>(mod, s) do
<%= l.body %>
  end
<% end %>
  defmacro __using__(opts) do
    store = Keyword.fetch!(opts, :store)
    start = Keyword.fetch!(opts, :start)
    case_opts = Keyword.get(opts, :case, async: true)

    tests =
      for %{id: id, statement: statement} <- @laws do
        quote do
          test unquote("#{id}: #{statement}"), %{conformance_store: s} do
            apply(AshPPlan.Test.StoreConformance, unquote(String.to_atom("law_" <> id)), [
              unquote(store),
              s
            ])
          end
        end
      end

    quote do
      use ExUnit.Case, unquote(case_opts)

      setup do
        %{conformance_store: AshPPlan.Test.StoreConformance.boot(unquote(store), unquote(start))}
      end

      unquote_splicing(tests)
    end
  end
end
