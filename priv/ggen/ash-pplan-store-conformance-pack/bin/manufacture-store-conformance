#!/usr/bin/env bash
# Generates test/support/durable/store_conformance.ex from the store-conformance ontology.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
cd "$ROOT"
. "$ROOT/bin/manufacture-lib.sh"

PACK="priv/ggen/ash-pplan-store-conformance-pack"
OUT="test/support/durable/store_conformance.ex"

mkdir -p "$MF_ROOT" test/support/durable
mf_sync store_conformance -- --pack-dir "$PACK" \
  --template "$PACK/templates/store_conformance.ex.eex" --engine oxigraph --on-stale prune \
  --out "$OUT"

mix format "$OUT"
