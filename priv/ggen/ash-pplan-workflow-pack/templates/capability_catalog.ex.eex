<%
  scalar = fn
    nil ->
      nil

    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)

          body
          |> String.replace("\\\"", "\"")
          |> String.replace("\\\\", "\\")

        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")

        true ->
          value
      end

    value ->
      value
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  to_atom = fn value -> value |> to_string() |> String.to_atom() end
  uniq_sorted = fn list -> list |> Enum.uniq() |> Enum.sort() end

  caps =
    capabilities
    |> normalize.()
    |> Enum.map(&%{id: &1["id"], family: &1["family"]})
    |> Enum.uniq()
    |> Enum.sort_by(&{&1.id, &1.family})
%># GENERATED by ggen_igniter from ontology.ttl.
# Do not edit. Regenerate with priv/ggen/ash-pplan-workflow-pack/bin/manufacture-workflow.
defmodule AshPPlan.Generated.CapabilityCatalog do
  @moduledoc false

  @capabilities [
<%= for cap <- caps do %>    %{id: <%= inspect(cap.id) %>, family: <%= inspect(cap.family) %>},
<% end %>  ]

  @spec all() :: [%{id: String.t(), family: String.t()}]
  def all, do: @capabilities

  @spec ids() :: [String.t()]
  def ids, do: Enum.map(@capabilities, & &1.id)
