---
to: "tmp/r2_render/reactors.ex"
mode: file
---
<%
  scalar = fn
    nil ->
      nil

    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)

          body
          |> String.replace("\\\"", "\"")
          |> String.replace("\\\\", "\\")

        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")

        true ->
          value
      end

    value ->
      value
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  to_atom = fn value -> value |> to_string() |> String.to_atom() end
  uniq_sorted = fn list -> list |> Enum.uniq() |> Enum.sort() end

  # Multiline literals (docs, bodies, arg/alias/input blocks) arrive
  # N-Triples-escaped; single-pass unescape restores them.
  text = fn value ->
    case Regex.run(~r/^"((?:\\.|[^"])*)"/, value) do
      [_, body] ->
        Regex.replace(~r/\\(.)/s, body, fn _w, c ->
          case c do
            "n" -> "\n"
            "t" -> "\t"
            "r" -> "\r"
            _ -> c
          end
        end)

      _ ->
        value
    end
  end

  wfs =
    reactor_workflows
    |> normalize.()
    |> Enum.sort_by(& &1["name"])

  int = fn v ->
    case Regex.run(~r/\d+/, to_string(v)) do
      [d] -> String.to_integer(d)
      _ -> 0
    end
  end

  tasks_by_wf =
    reactor_tasks
    |> normalize.()
    |> Enum.map(fn r -> Map.put(r, "order", int.(r["order"])) end)
    |> Enum.group_by(& &1["name"])
    |> Map.new(fn {k, v} -> {k, Enum.sort_by(v, & &1["order"])} end)

  args_by_wf =
    reactor_args
    |> normalize.()
    |> Enum.group_by(& &1["name"])
    |> Map.new(fn {k, v} ->
      {k, Map.new(v, fn r -> {r["task"], text.(r["args"])} end)}
    end)

  surface_by_wf =
    reactor_surface
    |> normalize.()
    |> Map.new(fn r ->
      {r["name"],
       %{
         "inputs" => text.(r["inputs"] || ""),
         "aliases" => text.(r["aliases"] || "")
       }}
    end)
%># GENERATED by ggen_igniter from the workflow-pack ontology (ERRC R2).
# Do not edit. Regenerate from priv/ggen/ash-pplan-workflow-pack/gates/120-123.
# Collaborators are injected as real processes through reactor inputs.
<%= for wf <- wfs do %><%
  name = wf["name"]
  tasks = Map.get(tasks_by_wf, name, [])
  args_map = Map.get(args_by_wf, name, %{})
  surface = Map.get(surface_by_wf, name, %{"inputs" => "", "aliases" => ""})
  aliases = String.split(surface["aliases"], "\n", trim: true)
  inputs = String.split(surface["inputs"], "\n", trim: true)
%>defmodule <%= wf["module"] %> do
  @moduledoc """
<%= wf["doc"] %>
  """

  use Reactor

<%= for a <- aliases do %>  <%= a %>
<% end %>
<%= for i <- inputs do %>  input :<%= i %>
<% end %>
<%= for t <- tasks do %>
  step :<%= t["task"] %> do
<%= for line <- String.split(Map.get(args_map, t["task"], ""), "\n", trim: true) do %>    <%= line %>
<% end %><%= t["body"] %>
  end
<% end %>
  return :<%= wf["ret"] %>
end

<% end %>
