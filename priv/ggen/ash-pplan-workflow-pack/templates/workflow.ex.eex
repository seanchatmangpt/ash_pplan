---
to: "test/support/examples/workflows/workflow.ex"
mode: file
for_each: workflows
---
<%
  scalar = fn
    nil ->
      nil

    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)

          body
          |> String.replace("\\\"", "\"")
          |> String.replace("\\\\", "\\")

        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")

        true ->
          value
      end

    value ->
      value
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  to_atom = fn value -> value |> to_string() |> String.to_atom() end
  uniq_sorted = fn list -> list |> Enum.uniq() |> Enum.sort() end

  wname = scalar.(name)
  wgoal = scalar.(goal)
  camel = wname |> String.split(~r/[^A-Za-z0-9]+/, trim: true) |> Enum.map_join(&String.capitalize/1)
  mine = fn rows -> rows |> normalize.() |> Enum.filter(&(&1["workflow"] == wname)) end

  task_rows =
    tasks
    |> mine.()
    |> Enum.sort_by(fn r ->
      case Integer.parse(to_string(r["order"])) do
        {n, _} -> {n, r["task"]}
        :error -> {0, r["task"]}
      end
    end)

  deps = task_deps |> mine.()
  outs = task_outcomes |> mine.()
  tprops = task_props |> mine.()
  attr = fn rows, task, key -> rows |> Enum.filter(&(&1["task"] == task)) |> Enum.map(& &1[key]) |> uniq_sorted.() end

  task_literals =
    Enum.map(task_rows, fn r ->
      id = r["task"]

      "%{id: #{inspect(to_atom.(id))}, capability: #{inspect(r["capability"])}, " <>
        "depends_on: #{inspect(Enum.map(attr.(deps, id, "dep"), to_atom))}, " <>
        "outcomes: #{inspect(Enum.map(attr.(outs, id, "outcome"), to_atom))}, " <>
        "properties: #{inspect(Enum.map(attr.(tprops, id, "property"), to_atom))}, " <>
        "authority: #{inspect(to_atom.(r["authority"]))}}"
    end)

  method_literals =
    methods
    |> mine.()
    |> Enum.group_by(& &1["method"])
    |> Enum.sort()
    |> Enum.map(fn {mid, rows} ->
      subtasks =
        rows
        |> Enum.sort_by(fn r ->
          case Integer.parse(to_string(r["pos"])) do
            {n, _} -> {n, r["subtask"]}
            :error -> {0, r["subtask"]}
          end
        end)
        |> Enum.map(&to_atom.(&1["subtask"]))
        |> Enum.uniq()

      "%{id: #{inspect(to_atom.(mid))}, task: #{inspect(to_atom.(hd(rows)["decomposes"]))}, " <>
        "subtasks: #{inspect(subtasks)}}"
    end)

  ordered = Enum.map(task_rows, & &1["task"])

  pos_of = fn r ->
    case Integer.parse(to_string(r["pos"])) do
      {n, _} -> n
      :error -> 0
    end
  end

  method_groups = methods |> mine.() |> Enum.group_by(& &1["method"]) |> Enum.sort()

  seq = fn ids ->
    ids
    |> Enum.with_index(1)
    |> Enum.map_join("\n", fn {s, i} -> "      (s#{i} (t_#{s}))" end)
  end

%># GENERATED by ggen_igniter from ontology.ttl (workflow <%= wname %>).
# Do not edit. Regenerate with priv/ggen/ash-pplan-workflow-pack/bin/manufacture-workflow.
defmodule AshPPlan.Examples.Workflows.<%= camel %> do
  @moduledoc """
  Generated workflow `<%= wname %>` (goal `<%= wgoal %>`): the canonical model literal and its identity.
  """

  alias AshPPlan.Workflow.{Model, Subject}

  @spec model() :: Model.t()
  def model do
    {:ok, model} =
      Model.new(
        name: <%= inspect(wname) %>,
        goal: <%= inspect(wgoal) %>,
        tasks: [
<%= for t <- task_literals do %>          <%= t %>,
<% end %>        ],
        methods: [
<%= for m <- method_literals do %>          <%= m %>,
<% end %>        ]
      )

    model
  end

  @spec subject() :: map()
  def subject, do: Subject.bind(model())

  @spec hddl() :: String.t()
  def hddl, do: AshPPlan.Workflow.Project.HDDL.render(model())
end
