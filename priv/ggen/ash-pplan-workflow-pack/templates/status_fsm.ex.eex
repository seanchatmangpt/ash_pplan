---
to: lib/ash_pplan/reactor/durable/status.ex
mode: file
sparql:
  status_machine: >
    PREFIX st: <https://ggen.dev/ontology/state-transition#>
    SELECT ?name ?initial WHERE {
      ?m a st:Machine ; st:machineName ?name ; st:initial ?i .
      ?i st:stateName ?initial .
    } ORDER BY ?name
  status_states: >
    PREFIX st: <https://ggen.dev/ontology/state-transition#>
    SELECT ?name ?seq ?terminal ?parked ?rolling ?cancellable ?note WHERE {
      ?s a st:State ; st:inMachine ?m ; st:stateName ?name ; st:seq ?seq .
      OPTIONAL { ?s st:terminal ?terminal }
      OPTIONAL { ?s st:parked ?parked }
      OPTIONAL { ?s st:rollingBack ?rolling }
      OPTIONAL { ?s st:cancellable ?cancellable }
      OPTIONAL { ?s st:note ?note }
    } ORDER BY ?seq
  status_transitions: >
    PREFIX st: <https://ggen.dev/ontology/state-transition#>
    SELECT ?from ?to WHERE {
      ?t a st:Transition ; st:from ?f ; st:to ?u ; st:order ?ord .
      ?f st:inMachine ?mm ; st:stateName ?from .
      ?u st:stateName ?to .
    } ORDER BY ?from ?ord
---
<%
  truthy = fn
    true -> true
    v when is_binary(v) -> v == "true"
    _ -> false
  end

  toint = fn v ->
    if is_integer(v) do
      v
    else
      v |> to_string() |> String.to_integer()
    end
  end

  states =
    status_states
    |> Enum.map(fn s ->
      %{
        name: to_string(s["name"]),
        seq: toint.(s["seq"]),
        terminal: truthy.(s["terminal"]),
        parked: truthy.(s["parked"]),
        rolling: truthy.(s["rolling"]),
        cancellable: truthy.(s["cancellable"]),
        note: if(s["note"], do: to_string(s["note"]))
      }
    end)
    |> Enum.sort_by(& &1.seq)

  machine = Enum.map(status_machine, &to_string(&1["name"]))
  mod = "AshPPlan.Reactor.Durable.Status"

  allowed =
    status_transitions
    |> Enum.map(fn t -> {to_string(t["from"]), to_string(t["to"]) } end)
    |> Enum.group_by(fn {f, _t} -> f end, fn {_f, t} -> t end)

  allowed_ordered =
    states
    |> Enum.map(fn s ->
      tos = Enum.dedup(Map.get(allowed, s.name, []))
      {s.name, tos, s.note}
    end)

  atom_line = fn list -> "~w(" <> Enum.join(list, " ") <> ")a" end
  tos_line = fn
    [] -> "[]"
    tos -> "~w(" <> Enum.join(tos, " ") <> ")a"
  end

  flag_atoms = fn key ->
    states |> Enum.filter(& &1[key]) |> Enum.map(&String.to_atom(&1.name))
  end

  _ = machine
%>
# GENERATED by ggen_igniter from ontology.ttl (st:RunStatusMachine rows).
# Do not edit. Regenerate:
#   mix ggen_igniter.sync --pack-dir priv/ggen/ash-pplan-workflow-pack \
#     --template priv/ggen/ash-pplan-workflow-pack/templates/status_fsm.ex.eex \
#     --engine oxigraph --on-stale prune --out lib/ash_pplan/reactor/durable/status.ex \
#     --manifest-dir tmp/mf-statusgen --verify-cwd "$PWD"
defmodule <%= mod %> do
  @moduledoc """
  Run status machine with guarded transitions. A terminal status is absorbing and no
  transition may overwrite it (magma allowed unconditional overwrites; we do not).
  """
  @type t :: <%= Enum.map_join(states, " | ", fn s -> ":" <> s.name end) %>

  @all <%= atom_line.(Enum.map(states, & &1.name)) %>
  @terminal <%= atom_line.(flag_atoms.(:terminal)) %>
  @parked <%= atom_line.(flag_atoms.(:parked)) %>

  # from => allowed tos
  @allowed %{
<%= for {from_name, tos, note} <- allowed_ordered do %><%= if note do %>    # <%= note %>
<% end %>    <%= from_name %>: <%= tos_line.(tos) %>,
<% end %>  }

  @spec all() :: [t()]
  def all, do: @all
  @spec terminal?(t()) :: boolean()
  def terminal?(s), do: s in @terminal
  @spec parked?(t()) :: boolean()
  def parked?(s), do: s in @parked
  @spec rolling_back?(t()) :: boolean()
  def rolling_back?(s), do: s in <%= inspect(flag_atoms.(:rolling)) %>
  @spec can?(t(), t()) :: boolean()
  def can?(from, to), do: to in Map.get(@allowed, from, [])

  @doc "Cancel is only legal from a non-terminal, non-rolling-back status."
  @spec cancellable?(t()) :: boolean()
  def cancellable?(s), do: s in <%= inspect(flag_atoms.(:cancellable)) %>
end
