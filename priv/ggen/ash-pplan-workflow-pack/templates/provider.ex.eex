---
to: "lib/ash_pplan/generated/workflow/providers/provider.ex"
mode: file
for_each: providers
---
<%
  scalar = fn
    nil ->
      nil

    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)

          body
          |> String.replace("\\\"", "\"")
          |> String.replace("\\\\", "\\")

        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")

        true ->
          value
      end

    value ->
      value
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  to_atom = fn value -> value |> to_string() |> String.to_atom() end
  uniq_sorted = fn list -> list |> Enum.uniq() |> Enum.sort() end

  pid = scalar.(provider_id)
  mod = scalar.(module)

  cost =
    case Float.parse(to_string(scalar.(cost))) do
      {n, ""} -> if n == Float.round(n), do: trunc(n), else: n
      {n, _} -> n
      :error -> 0
    end

  mine = fn rows, key -> rows |> normalize.() |> Enum.filter(&(&1[key] == pid)) end

  caps =
    provider_caps
    |> mine.("provider_id")
    |> Enum.map(fn row ->
      opts =
        case Code.string_to_quoted(to_string(row["step_options"])) do
          {:ok, ast} when is_list(ast) -> row["step_options"]
          _ -> "[]"
        end

      {row["capability"], row["adapter"], row["operation"], opts}
    end)
    |> Enum.uniq()
    |> Enum.sort()

  props = provider_props |> mine.("provider_id") |> Enum.map(& &1["property"]) |> uniq_sorted.()
  evid = provider_evidence |> mine.("provider_id") |> Enum.map(& &1["evidence"]) |> uniq_sorted.()
%># GENERATED by ggen_igniter from ontology.ttl (provider <%= pid %>).
# Do not edit. Regenerate with priv/ggen/ash-pplan-workflow-pack/bin/manufacture-workflow.
defmodule <%= mod %> do
  @moduledoc """
  Generated provider `<%= pid %>`: describes how capabilities are realized (adapter + operation bindings).
  It names no Reactor implementation; `AshPPlan.Reactor` binds realizations to steps.

  Qualification refuses any authority above `:construct`; availability is not authority.
  """
  @behaviour AshPPlan.Provider

  alias AshPPlan.Providers.Qualify

  @capabilities <%= inspect(Enum.map(caps, &elem(&1, 0))) %>
  @properties <%= inspect(Enum.map(props, to_atom)) %>
  @evidence <%= inspect(Enum.map(evid, to_atom)) %>
  @authorities [:none, :observe, :select, :plan, :construct]
  @table %{
<%= for {cap, adapter, op, opts} <- caps do %>    <%= inspect(cap) %> => {<%= inspect(to_atom.(adapter)) %>, <%= inspect(to_atom.(op)) %>, <%= opts %>},
<% end %>  }

  @impl true
  def id, do: <%= inspect(to_atom.(pid)) %>
  @impl true
  def capabilities, do: @capabilities
  @impl true
  def properties, do: @properties
  @impl true
  def evidence, do: @evidence
  @impl true
  def cost, do: <%= inspect(cost) %>

  @impl true
  def qualify(requirement, context) do
    with :ok <- Qualify.check(requirement, context, @capabilities, @properties, @evidence, @authorities) do
<%= if Enum.any?(caps, fn {_, a, _, _} -> a == "reactor_process" end) do %>      Qualify.adapter_available(AshPPlan.Reactor.Adapters.ReactorProcess)
<% else %>      :ok
<% end %>    end
  end

  @impl true
  def realize(requirement, context) do
    with :ok <- qualify(requirement, context) do
      Qualify.realize(requirement, id(), @table, @properties)
    end
  end
end
