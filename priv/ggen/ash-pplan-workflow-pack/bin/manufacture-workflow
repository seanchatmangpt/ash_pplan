#!/usr/bin/env bash
# Runs the GENERIC workflow recipes serially (one template per sync), then formats outputs.
# Application-specific examples are test support: see bin/manufacture-examples.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
cd "$ROOT"
. "$ROOT/bin/manufacture-lib.sh"

PACK="priv/ggen/ash-pplan-workflow-pack"
GEN="lib/ash_pplan/workflow"

sync() {
  local name="$1" template="$2" out="$3" foreach="${4:-}"
  local args=(--pack-dir "$PACK" --template "$PACK/templates/$template" --engine oxigraph --on-stale prune --out "$out")
  if [ -n "$foreach" ]; then args+=(--for-each "$foreach"); fi
  mf_sync "$name" -- "${args[@]}"
}

mkdir -p "${MF_ROOT}" tmp test/courts/providers

sync capability_catalog capability_catalog.ex.eex "$GEN/capability_catalog.ex"
sync provider provider.ex.eex "lib/ash_pplan/providers/<%= provider_id %>.ex" providers
sync provider_index provider_index.ex.eex "lib/ash_pplan/providers/index.ex"

# The shipped ontology declares no workflows (for-each over zero rows is refused),
# so workflow/hddl/court_workflow recipes run only in bin/manufacture-examples.
sync court_provider court_provider.exs.eex "test/courts/providers/<%= provider_id %>_provider_court_test.exs" providers

mix format test/courts/providers/*.exs lib/ash_pplan/providers/*.ex "$GEN/capability_catalog.ex"
