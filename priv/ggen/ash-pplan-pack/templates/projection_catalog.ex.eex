---
to: "lib/ash_pplan/generated/projection_catalog.ex"
mode: file
---
<%
  # Oxigraph returns real N-Triples term strings. Normalize only at the
  # projection boundary so the ontology/query stay standards-native while
  # generated Elixir receives ordinary scalar values.
  scalar = fn value ->
    cond do
      Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
        [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)

        body
        |> String.replace("\\\"", "\"")
        |> String.replace("\\\\", "\\")

      String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
        value |> String.trim_leading("<") |> String.trim_trailing(">")

      true ->
        value
    end
  end

  normalized =
    Enum.map(projections, fn row ->
      Map.new(row, fn {key, value} -> {key, scalar.(value)} end)
    end)

  ordered = Enum.sort_by(normalized, &String.to_integer(&1["order"]))
%># GENERATED by ggen_igniter from ontology.ttl.
# Do not edit. Regenerate with ./bin/manufacture.
defmodule AshPPlan.Generated.ProjectionCatalog do
  @moduledoc false

  @projections [
<%= for row <- ordered do %>    %{
      source: <%= inspect(row["source"]) %>,
      target: <%= inspect(row["target"]) %>,
      primitive: <%= inspect(row["primitive"]) %>,
      owner: <%= inspect(row["owner"]) %>,
      role: <%= inspect(row["role"]) %>,
      status: <%= inspect(row["status"]) %>
    },
<% end %>  ]

  def all, do: @projections

  def fetch(source_iri) do
    Enum.find(@projections, &(&1.source == source_iri))
  end

  def by_role(role) do
    Enum.filter(@projections, &(&1.role == role))
  end
end
