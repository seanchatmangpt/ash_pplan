---
to: "lib/ash_pplan/generated/projection_catalog.ex"
mode: file
---
<%
  ordered = Enum.sort_by(projections, &String.to_integer(&1["order"]))
%># GENERATED by ggen_igniter from ontology.ttl.
# Do not edit. Regenerate with ./bin/manufacture.
defmodule AshPPlan.Generated.ProjectionCatalog do
  @moduledoc false

  @projections [
<%= for row <- ordered do %>    %{
      source: "<%= row["source"] %>",
      target: "<%= row["target"] %>",
      primitive: "<%= row["primitive"] %>",
      owner: "<%= row["owner"] %>",
      role: "<%= row["role"] %>",
      status: "<%= row["status"] %>"
    },
<% end %>  ]

  def all, do: @projections

  def fetch(source_iri) do
    Enum.find(@projections, &(&1.source == source_iri))
  end

  def by_role(role) do
    Enum.filter(@projections, &(&1.role == role))
  end
end
