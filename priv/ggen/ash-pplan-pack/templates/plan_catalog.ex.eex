---
to: "lib/ash_pplan/generated/plan_catalog.ex"
mode: file
---
<%
  scalar = fn
    nil ->
      nil

    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)

          body
          |> String.replace("\\\"", "\"")
          |> String.replace("\\\\", "\\")

        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")

        true ->
          value
      end
  end

  normalize = fn rows ->
    Enum.map(rows, fn row ->
      Map.new(row, fn {key, value} -> {key, scalar.(value)} end)
    end)
  end

  step_rows = normalize.(plan_steps)
  variable_rows = normalize.(plan_variables)

  local_name = fn iri ->
    iri
    |> String.split(["#", "/"], trim: true)
    |> List.last()
  end

  plans =
    step_rows
    |> Enum.group_by(& &1["plan"])
    |> Enum.map(fn {plan_iri, rows} ->
      plan_label = Enum.find_value(rows, & &1["planLabel"]) || local_name.(plan_iri)

      steps =
        rows
        |> Enum.group_by(& &1["step"])
        |> Enum.map(fn {step_iri, step_rows_for_iri} ->
          vars =
            Enum.filter(variable_rows, fn row ->
              row["plan"] == plan_iri and row["step"] == step_iri
            end)

          %{
            iri: step_iri,
            label: Enum.find_value(step_rows_for_iri, & &1["stepLabel"]) || local_name.(step_iri),
            predecessors:
              step_rows_for_iri
              |> Enum.map(& &1["predecessor"])
              |> Enum.reject(&is_nil/1)
              |> Enum.uniq()
              |> Enum.sort(),
            inputs:
              vars
              |> Enum.filter(&(&1["direction"] == "input"))
              |> Enum.map(& &1["variable"])
              |> Enum.uniq()
              |> Enum.sort(),
            outputs:
              vars
              |> Enum.filter(&(&1["direction"] == "output"))
              |> Enum.map(& &1["variable"])
              |> Enum.uniq()
              |> Enum.sort()
          }
        end)
        |> Enum.sort_by(& &1.iri)

      %{iri: plan_iri, label: plan_label, steps: steps}
    end)
    |> Enum.sort_by(& &1.iri)
%># GENERATED by ggen_igniter from ontology.ttl.
# Do not edit. Regenerate with ./bin/manufacture.
defmodule AshPPlan.Generated.PlanCatalog do
  @moduledoc false

  @plans <%= inspect(plans, pretty: true, limit: :infinity, printable_limit: :infinity) %>

  def all, do: @plans

  def fetch(plan_iri) do
    Enum.find(@plans, &(&1.iri == plan_iri))
  end
end
