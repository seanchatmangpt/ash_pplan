#!/usr/bin/env bash
# Generates AshPPlan.Standing.Receipt and AshPPlan.Standing.Chain from the standing ontology.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
cd "$ROOT"
. "$ROOT/bin/manufacture-lib.sh"

PACK="priv/ggen/ash-pplan-standing-pack"

sync() {
  local name="$1" template="$2" out="$3"
  mf_sync "$name" -- --pack-dir "$PACK" --template "$PACK/templates/$template" --engine oxigraph --on-stale prune --out "$out"
}

mkdir -p "$MF_ROOT" lib/ash_pplan/standing
sync m7-standing-receipt receipt.ex.eex lib/ash_pplan/standing/receipt.ex
sync m7-standing-chain chain.ex.eex lib/ash_pplan/standing/chain.ex
mix format lib/ash_pplan/standing/receipt.ex lib/ash_pplan/standing/chain.ex
