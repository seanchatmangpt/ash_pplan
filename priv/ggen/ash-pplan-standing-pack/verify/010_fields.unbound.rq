PREFIX sg: <https://w3id.org/ash-pplan/standing#>

# INVERTED COMPANION to gates/010_fields.rq. ZERO ROWS IS THE PASS CONDITION.
# ANCHOR LIMIT: `?subject a sg:ReceiptField`; a lost rdf:type is covered by the "fields"
# cardinality contract (VALUES on sg:requiredKey).

SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a sg:ReceiptField .
    OPTIONAL { ?subject sg:fieldName ?p_name }
    FILTER (!BOUND(?p_name))
    BIND("sg:fieldName" AS ?missing_property)
  }
  UNION
  {
    ?subject a sg:ReceiptField .
    OPTIONAL { ?subject sg:fieldOrder ?p_order }
    FILTER (!BOUND(?p_order))
    BIND("sg:fieldOrder" AS ?missing_property)
  }
  UNION
  {
    ?subject a sg:ReceiptField .
    OPTIONAL { ?subject sg:missingTerm ?p_missing_term }
    FILTER (!BOUND(?p_missing_term))
    BIND("sg:missingTerm" AS ?missing_property)
  }
  UNION
  {
    ?subject a sg:ReceiptField .
    OPTIONAL { ?subject sg:requiredKey ?p_key }
    FILTER (!BOUND(?p_key))
    BIND("sg:requiredKey" AS ?missing_property)
  }
}
