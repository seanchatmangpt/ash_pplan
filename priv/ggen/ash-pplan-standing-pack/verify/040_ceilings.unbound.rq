PREFIX sg: <https://w3id.org/ash-pplan/standing#>

# INVERTED COMPANION to gates/040_ceilings.rq. ZERO ROWS IS THE PASS CONDITION.
# ANCHOR LIMIT: `?subject a sg:Ceiling`; a lost rdf:type is covered by the "ceilings"
# cardinality contract (ROWS on sg:grantsDo).

SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a sg:Ceiling .
    OPTIONAL { ?subject sg:ceilingName ?p_name }
    FILTER (!BOUND(?p_name))
    BIND("sg:ceilingName" AS ?missing_property)
  }
  UNION
  {
    ?subject a sg:Ceiling .
    OPTIONAL { ?subject sg:grantsDo ?p_grants_do }
    FILTER (!BOUND(?p_grants_do))
    BIND("sg:grantsDo" AS ?missing_property)
  }
}
