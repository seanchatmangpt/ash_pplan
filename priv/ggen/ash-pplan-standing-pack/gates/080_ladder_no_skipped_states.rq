# Standing-ladder gate (adopted from ggen-marketplace/packs/standing-ladder-pack
# gates/010_no_skipped_states.rq; the stl: ladder is modeled in ontology.ttl).
#
# MESSAGE: every stl:StandingClaim's stl:hasStanding must be backed by a real,
# unbroken, evidenced stl:StandingTransition chain reaching it from UNKNOWN,
# one rung at a time -- no skipped rungs, no empty stl:evidenceRef, no missing
# link. Any row below names a claim and the 1-based index of the FIRST rung on
# its required chain with no valid supporting transition; ?missingRungIndex = 0
# names a dangling stl:aboutFact (the fact is not a typed subject in the union
# graph). A claim with ANY row here is refused. This is the same
# "no standing without evidence" law the sg: receipt gates enforce over the
# five receipt fields, generalized to the 10-rung promotion ladder that
# AshPPlan.Standing.ladder/1 derives and AshPPlan.Standing.Ladder.admit/1
# enforces in code.
PREFIX sg:  <https://w3id.org/ash-pplan/standing#>
PREFIX stl: <http://seanchatmangpt.github.io/packs/standing-ladder#>
SELECT ?claim ?missingRungIndex WHERE {
  {
    ?claim a stl:StandingClaim ; stl:hasStanding ?curState .
    ?curState stl:stateIndex ?curIndex .
    VALUES ?missingRungIndex { 1 2 3 4 5 6 7 8 9 }
    FILTER(?missingRungIndex <= ?curIndex)
    FILTER NOT EXISTS {
      ?t a stl:StandingTransition ;
         stl:aboutClaim ?claim ;
         stl:fromState ?fs ; stl:toState ?ts ; stl:evidenceRef ?ev .
      ?fs stl:stateIndex ?fi .
      ?ts stl:stateIndex ?ti .
      FILTER(?fi = ?missingRungIndex - 1 && ?ti = ?missingRungIndex)
      FILTER(STRLEN(?ev) > 0)
    }
  }
  UNION {
    ?claim a stl:StandingClaim ; stl:aboutFact ?fact .
    FILTER NOT EXISTS { ?fact a ?anyType }
    BIND(0 AS ?missingRungIndex)
  }
}
ORDER BY ?claim ?missingRungIndex