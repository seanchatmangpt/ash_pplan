---
to: "lib/ash_pplan/standing/receipt.ex"
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
          body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
    value -> value
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  fields =
    fields
    |> normalize.()
    |> Enum.group_by(&{String.to_integer(&1["order"]), &1["name"], &1["missing_term"]}, & &1["key"])
    |> Enum.sort()
    |> Enum.map(fn {{_o, name, term}, keys} -> {name, term, Enum.uniq(keys)} end)

  layers = layers |> normalize.() |> Enum.map(&{&1["name"], &1["broken_term"]})
  standings = standings |> normalize.() |> Enum.map(& &1["name"])
  ceilings = ceilings |> normalize.()
  safe = ceilings |> Enum.filter(&(&1["grants_do"] == "false")) |> Enum.map(& &1["name"])
  do_ceilings = ceilings |> Enum.filter(&(&1["grants_do"] == "true")) |> Enum.map(& &1["name"])
%># GENERATED by ggen_igniter from priv/ggen/ash-pplan-standing-pack/ontology.ttl.
# Do not edit. Regenerate with bin/manufacture-standing.
defmodule AshPPlan.Standing.Receipt do
  @moduledoc """
  R = receipt(A) for one standing evaluation: five fields (identity, authority, consequence,
  replay, standing), each required; a receipt missing any field is not a receipt and
  `validate/1` names the matching broken term (`R_missing_<field>`). A `DO` authority ceiling is
  refused as `R_missing_authority` (nothing in this library grants DO). Generated from the
  standing ontology; the field list, layer-to-term map, standing values and ceilings are facts of
  that graph, not literals of this file.
  """

  @fields <%= inspect(fields, limit: :infinity) %>
  @layer_terms <%= inspect(layers, limit: :infinity) %>
  @standings <%= inspect(standings, limit: :infinity) %>
  @safe_ceilings <%= inspect(safe, limit: :infinity) %>
  @do_ceilings <%= inspect(do_ceilings, limit: :infinity) %>

  @type t :: %__MODULE__{
          identity: map() | nil,
          authority: map() | nil,
          consequence: map() | nil,
          replay: map() | nil,
          standing: map() | nil
        }
  defstruct identity: nil, authority: nil, consequence: nil, replay: nil, standing: nil

  @doc "Receipt field names in ontology order."
  def fields, do: Enum.map(@fields, &elem(&1, 0))

  @doc "Standing values the ontology admits."
  def standings, do: @standings

  @doc "Broken term a lost verdict layer maps to."
  def layer_term(layer), do: Map.fetch!(Map.new(@layer_terms), to_string(layer))

  @doc "Authority ceilings that grant no DO."
  def safe_ceilings, do: @safe_ceilings

  @doc "Build a receipt from a map (atom or string keys); unknown keys are ignored."
  @spec new(map()) :: t()
  def new(attrs) when is_map(attrs) do
    struct(__MODULE__, for(f <- fields(), do: {String.to_atom(f), fetch(attrs, f)}))
  end

  defp fetch(attrs, f), do: Map.get(attrs, String.to_atom(f), Map.get(attrs, f))

  @doc """
  Validate the five-field shape. `:ok` or `{:error, %{broken_term: term, field: name, reason: r}}`
  naming the first failing field in ontology order.
  """
  @spec validate(t()) :: :ok | {:error, map()}
  def validate(%__MODULE__{} = r) do
    Enum.find_value(@fields, :ok, fn {name, term, keys} ->
      value = Map.fetch!(r, String.to_atom(name))

      case check(name, value, keys) do
        :ok -> nil
        {:error, reason} -> {:error, %{broken_term: term, field: name, reason: reason}}
      end
    end)
  end

  defp check(name, nil, _keys), do: {:error, {:missing_field, name}}

  defp check(name, value, keys) when is_map(value) do
    case Enum.reject(keys, &present?(value, &1)) do
      [] -> check_semantics(name, value)
      missing -> {:error, {:missing_keys, missing}}
    end
  end

  defp check(name, _value, _keys), do: {:error, {:not_a_map, name}}

  defp present?(map, key), do: Map.get(map, String.to_atom(key), Map.get(map, key)) not in [nil, ""]

  defp get(map, key), do: Map.get(map, key, Map.get(map, to_string(key)))

  defp check_semantics("authority", a) do
    ceiling = to_string(get(a, :ceiling))

    cond do
      ceiling in @do_ceilings -> {:error, {:do_ceiling_unleased, ceiling}}
      ceiling in @safe_ceilings -> :ok
      true -> {:error, {:unknown_ceiling, ceiling}}
    end
  end

  defp check_semantics("replay", r) do
    case get(r, :commands) do
      [_ | _] -> :ok
      _ -> {:error, :no_replay_command}
    end
  end

  defp check_semantics("standing", s) do
    if standing_value_ok?(to_string(get(s, :value))),
      do: :ok,
      else: {:error, {:unknown_standing, get(s, :value)}}
  end

  defp check_semantics(_name, _value), do: :ok

  defp standing_value_ok?(value) do
    base = value |> String.split(["(", ":"], parts: 2) |> hd()
    base in @standings
  end

  @doc "String-keyed map in the shape of the DfCM receipt schema (open top level)."
  @spec to_map(t()) :: map()
  def to_map(%__MODULE__{} = r) do
    for f <- fields(), into: %{}, do: {f, jsonable(Map.fetch!(r, String.to_atom(f)))}
  end

  defp jsonable(nil), do: nil
  defp jsonable(%_{} = s), do: s |> Map.from_struct() |> jsonable()
  defp jsonable(m) when is_map(m), do: Map.new(m, fn {k, v} -> {to_string(k), jsonable(v)} end)
  defp jsonable(l) when is_list(l), do: Enum.map(l, &jsonable/1)
  defp jsonable(a) when is_atom(a) and a not in [true, false], do: Atom.to_string(a)
  defp jsonable(t) when is_tuple(t), do: t |> Tuple.to_list() |> jsonable()
  defp jsonable(v), do: v
end
