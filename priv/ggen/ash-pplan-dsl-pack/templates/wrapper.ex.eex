---
to: "lib/ash_pplan/dsl.ex"
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) -> value
    value -> value
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  [ext] = extension |> normalize.() |> Enum.take(1)
%># GENERATED by ggen_igniter from ontology.ttl (Spark DSL extension row ap:dslSection).
# Do not edit. Regenerate with priv/ggen/ash-pplan-dsl-pack/bin/manufacture-dsl.
defmodule <%= ext["wrapper"] %> do
  @moduledoc """
  GENERATED `use`-able wrapper exposing the generated `<%= ext["section"] %>` section.

      defmodule MyFlow do
        use <%= ext["wrapper"] %>

        <%= ext["section"] %> do
          goal "ship"
          task :observe, capability: "Repository.Observe"
        end
      end

  Resolving to a model: `AshPPlan.Workflow.model(MyFlow)` (the generated
  extension registers `AshPPlan.Workflow.Dsl.Transformers.GenerateModel`, so
  the module gains `__ash_pplan_workflow__/0`).
  """
  use Spark.Dsl,
    default_extensions: [extensions: [<%= ext["module"] %>]]

  defdelegate model(module_or_model), to: AshPPlan.Workflow
end
