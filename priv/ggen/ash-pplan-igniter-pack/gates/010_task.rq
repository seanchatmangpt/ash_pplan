PREFIX ig: <https://ggen-igniter.dev/ontology/igniter-task#>
SELECT ?task ?task_name ?module ?group ?shortdoc ?example ?moduledoc_body
WHERE {
  ?task a ig:Task ;
        ig:taskName ?task_name ;
        ig:module ?module ;
        ig:group ?group ;
        ig:shortdoc ?shortdoc ;
        ig:example ?example ;
        ig:moduledocBody ?moduledoc_body .
}
