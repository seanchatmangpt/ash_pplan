---
to: "priv/tla/durable/DurableProtocol.tla"
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
          body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end
  norm = fn rows -> Enum.map(rows, fn row -> Map.new(row, fn {k, v} -> {k, scalar.(v)} end) end) end
  statuses = norm.(statuses)
  transitions = norm.(transitions)
  actions = norm.(actions)
  guards = norm.(guards)
  properties = norm.(properties)
  q = fn s -> inspect(s) end
  set = fn xs -> "{" <> Enum.map_join(xs, ", ", q) <> "}" end
  terminal = for s <- statuses, s["terminal"] == "true", do: s["status"]
  parked = ["waiting", "polling"]
  forward = ["pending", "waiting", "polling"]
  guard_lines = fn action ->
    guards
    |> Enum.filter(&(&1["action"] == action))
    |> Enum.sort_by(&String.to_integer(&1["gorder"]))
    |> Enum.map_join("\n", fn g -> "  /\\ " <> g["expr"] <> " \\* guard:" <> g["gid"] end)
  end
  header = fn a -> if a["param"] == "", do: a["action"], else: a["action"] <> "(" <> a["param"] <> ")" end
  next_lines =
    Enum.map_join(actions, "\n", fn a ->
      if a["param"] == "",
        do: "  \\/ " <> a["action"],
        else: "  \\/ \\E w \\in Workers : " <> a["action"] <> "(w)"
    end)
%>---------------------------- MODULE DurableProtocol ----------------------------
\* GENERATED by ggen_igniter from priv/ggen/ash-pplan-durable-tla-pack/ontology.ttl.
\* Do not edit. Regenerate with ./bin/manufacture-durable-tla.
\* One run, a set of workers, step "a" (effect) and step "b" (awaits a signal).
EXTENDS Integers, FiniteSets
CONSTANT Workers

Steps == {"a", "b"}
Statuses == <%= set.(Enum.map(statuses, & &1["status"])) %>
Terminal == <%= set.(terminal) %>
Parked == <%= set.(parked) %>
Forward == <%= set.(forward) %>

VARIABLES status, holder, pc, sigPending, sigDelivered, recorded, effects
vars == <<status, holder, pc, sigPending, sigDelivered, recorded, effects>>

Init ==
  /\ status = "pending"
  /\ holder = "none"
  /\ pc = [w \in Workers |-> "idle"]
  /\ sigPending = FALSE
  /\ sigDelivered = FALSE
  /\ recorded = [s \in Steps |-> FALSE]
  /\ effects = [s \in Steps |-> 0]

<%= for a <- actions do %><%= header.(a) %> ==
<%= guard_lines.(a["action"]) %>
  /\ <%= a["effect"] %>

<% end %>Quiescent ==
  /\ status \in Terminal
  /\ \A w \in Workers : pc[w] = "idle"
  /\ UNCHANGED vars

Next ==
<%= next_lines %>
  \/ Quiescent

<%= for p <- Enum.sort_by(properties, &String.to_integer(&1["order"])) do %><%= p["name"] %> == <%= p["expr"] %>
<% end %>
Spec == Init /\ [][Next]_vars /\ \A w \in Workers : WF_vars(Claim(w))
=============================================================================
