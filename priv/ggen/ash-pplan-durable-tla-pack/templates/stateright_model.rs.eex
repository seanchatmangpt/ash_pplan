---
to: "priv/tla/durable/stateright/model.rs"
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) -> value
    other -> other
  end
  norm = fn rows -> Enum.map(rows, fn row -> Map.new(row, fn {k, v} -> {k, scalar.(v)} end) end) end
  statuses = statuses |> norm.() |> Enum.sort_by(& &1["status"])
  transitions = norm.(transitions)
  actions = actions |> norm.() |> Enum.sort_by(& &1["action"])
  guards = norm.(guards)
  properties = norm.(properties)
  q = fn s -> inspect(s) end
  terminal = for(s <- statuses, s["terminal"] == "true", do: s["status"]) |> Enum.sort()
  parked = ["waiting", "polling"]
  forward = ["pending", "waiting", "polling"]
  guard_ids = fn action ->
    guards
    |> Enum.filter(&(&1["action"] == action))
    |> Enum.sort_by(&String.to_integer(&1["gorder"]))
    |> Enum.map(& &1["gid"])
  end
%>
// GENERATED by ggen_igniter from priv/ggen/ash-pplan-durable-tla-pack/ontology.ttl.
// Do not edit. Regenerate with ./bin/manufacture-durable-tla.
//
// Stateright differential-check model of the durable claim/lease, attempt, park, signal,
// wake, cancel/unwind protocol — generated from the SAME protocol ontology as
// priv/tla/durable/DurableProtocol.tla, so a verdict disagreement between checkers is a
// court failure, not a modeling drift.
//
// Differential contract (mirrors test/durable/native_tla_court_test.exs):
//   - protocol model: admitted (NoLostWakeup leads-to property + invariant core)
//   - guard-dropped mutants claim_free / run_held / record_once: counterexample expected
//
// Build (scratch dir only, never packaged):
//   cargo new --lib stateright-diff && cargo add stateright@0.18 \
//     && cp priv/tla/durable/stateright/model.rs src/lib.rs
//   cargo test
#![allow(dead_code)]

/// Protocol states, straight from the ontology (`dp:s_*` individuals).
pub const STATUSES: &[&str] = &[
<%= for s <- statuses do %>    <%= q.(s["status"]) %>,
<% end %>];

/// Terminal states (`dp:terminal true`).
pub const TERMINAL: &[&str] = &[
<%= for s <- terminal do %>    <%= q.(s) %>,
<% end %>];

/// Parked states (fixed by the protocol: waiting, polling).
pub const PARKED: &[&str] = &[
<%= for s <- parked do %>    <%= q.(s) %>,
<% end %>];

/// Forward states (fixed by the protocol: pending, waiting, polling).
pub const FORWARD: &[&str] = &[
<%= for s <- forward do %>    <%= q.(s) %>,
<% end %>];

/// Protocol actions (`dp:a_*` individuals).
pub const ACTIONS: &[&str] = &[
<%= for a <- actions do %>    <%= q.(a["action"]) %>,
<% end %>];

/// Guards per action, in `gorder` (`dp:g_*` individuals).
pub const GUARDS: &[(&str, &[&str])] = &[
<%= for a <- actions do %>    (<%= q.(a["action"]) %>, &[
<%= for g <- guard_ids.(a["action"]) do %>        <%= q.(g) %>,
<% end %>    ]),
<% end %>];

/// Properties the differential court must agree on with tla-rs
/// (`dp:p_*` individuals: ClaimExclusive, NoDoubleEffect, NoLostWakeup, ...).
pub const PROPERTIES: &[&str] = &[
<%= for p <- Enum.sort_by(properties, &String.to_integer(&1["order"])) do %>    <%= q.(p["name"]) %>,
<% end %>];

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn protocol_vocabulary_matches_ontology() {
        assert!(STATUSES.contains(&"pending"));
        assert!(TERMINAL.contains(&"completed"));
        assert!(PROPERTIES.contains(&"NoLostWakeup"));
    }
}
