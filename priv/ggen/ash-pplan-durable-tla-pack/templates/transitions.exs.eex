---
to: "priv/tla/durable/transitions.exs"
mode: file
---
<%
  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"])*"/, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
          body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end
  norm = fn rows -> Enum.map(rows, fn row -> Map.new(row, fn {k, v} -> {k, scalar.(v)} end) end) end
  # Deterministic output: sort every row set on its stable unique key so
  # ggen/oxigraph row-order nondeterminism never reaches generated bytes.
  statuses = statuses |> norm.() |> Enum.sort_by(& &1["status"])
  transitions = transitions |> norm.() |> Enum.sort_by(&{&1["from"], &1["to"]})
  actions = norm.(actions)
  guards = norm.(guards)
  properties = norm.(properties)
  q = fn s -> inspect(s) end
  set = fn xs -> "{" <> Enum.map_join(xs, ", ", q) <> "}" end
  terminal =
    statuses |> Enum.filter(&(&1["terminal"] == "true")) |> Enum.map(& &1["status"]) |> Enum.sort()
  parked = ["waiting", "polling"]
  forward = ["pending", "waiting", "polling"]
%># GENERATED by ggen_igniter from priv/ggen/ash-pplan-durable-tla-pack/ontology.ttl. Do not edit.
%{
  statuses: <%= inspect(Enum.map(statuses, &String.to_atom(&1["status"]))) %>,
  terminal: <%= inspect(Enum.map(terminal, &String.to_atom/1)) %>,
  transitions: <%= inspect(Enum.map(transitions, &{String.to_atom(&1["from"]), String.to_atom(&1["to"])})) %>
}
