@prefix ap: <https://ash_pplan.example/airbus-parity#> .
@prefix ns1: <http://ontology.eil.utoronto.ca/p-plan#> .
@prefix p-plan: <http://ontology.eil.utoronto.ca/p-plan/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix up: <https://ash_pplan.example/up#> .

up:depotprob1818 a p-plan:Plan,
        ap:AirbusParityCase ;
    rdfs:label "depotprob1818" ;
    ns1:has_step up:step_drive,
        up:step_drop,
        up:step_lift,
        up:step_load,
        up:step_unload ;
    ap:hasVariable up:fluent_at,
        up:fluent_available,
        up:fluent_clear,
        up:fluent_crate,
        up:fluent_depot,
        up:fluent_distributor,
        up:fluent_hoist,
        up:fluent_in,
        up:fluent_lifting,
        up:fluent_locatable,
        up:fluent_on,
        up:fluent_pallet,
        up:fluent_place,
        up:fluent_surface,
        up:fluent_truck .

up:fluent_at a p-plan:Variable ;
    rdfs:label "at" .

up:fluent_available a p-plan:Variable ;
    rdfs:label "available" .

up:fluent_clear a p-plan:Variable ;
    rdfs:label "clear" .

up:fluent_crate a p-plan:Variable ;
    rdfs:label "crate" .

up:fluent_depot a p-plan:Variable ;
    rdfs:label "depot" .

up:fluent_distributor a p-plan:Variable ;
    rdfs:label "distributor" .

up:fluent_hoist a p-plan:Variable ;
    rdfs:label "hoist" .

up:fluent_in a p-plan:Variable ;
    rdfs:label "in" .

up:fluent_lifting a p-plan:Variable ;
    rdfs:label "lifting" .

up:fluent_locatable a p-plan:Variable ;
    rdfs:label "locatable" .

up:fluent_on a p-plan:Variable ;
    rdfs:label "on" .

up:fluent_pallet a p-plan:Variable ;
    rdfs:label "pallet" .

up:fluent_place a p-plan:Variable ;
    rdfs:label "place" .

up:fluent_surface a p-plan:Variable ;
    rdfs:label "surface" .

up:fluent_truck a p-plan:Variable ;
    rdfs:label "truck" .

up:step_drive a p-plan:Step ;
    rdfs:label "drive" ;
    p-plan:hasOutputVar up:fluent_n__bound_method_FNode_fluent_of_at_x__y__,
        up:fluent_n__bound_method_FNode_fluent_of_at_x__z__ .

up:step_drop a p-plan:Step ;
    rdfs:label "drop" ;
    p-plan:hasOutputVar up:fluent_n__bound_method_FNode_fluent_of_at_y__p__,
        up:fluent_n__bound_method_FNode_fluent_of_available_x__,
        up:fluent_n__bound_method_FNode_fluent_of_clear_y__,
        up:fluent_n__bound_method_FNode_fluent_of_clear_z__,
        up:fluent_n__bound_method_FNode_fluent_of_lifting_x__y__,
        up:fluent_n__bound_method_FNode_fluent_of_on_y__z__ .

up:step_lift a p-plan:Step ;
    rdfs:label "lift" ;
    p-plan:hasOutputVar up:fluent_n__bound_method_FNode_fluent_of_at_y__p__,
        up:fluent_n__bound_method_FNode_fluent_of_available_x__,
        up:fluent_n__bound_method_FNode_fluent_of_clear_y__,
        up:fluent_n__bound_method_FNode_fluent_of_clear_z__,
        up:fluent_n__bound_method_FNode_fluent_of_lifting_x__y__,
        up:fluent_n__bound_method_FNode_fluent_of_on_y__z__ .

up:step_load a p-plan:Step ;
    rdfs:label "load" ;
    p-plan:hasOutputVar up:fluent_n__bound_method_FNode_fluent_of_available_x__,
        up:fluent_n__bound_method_FNode_fluent_of_in_y__z__,
        up:fluent_n__bound_method_FNode_fluent_of_lifting_x__y__ .

up:step_unload a p-plan:Step ;
    rdfs:label "unload" ;
    p-plan:hasOutputVar up:fluent_n__bound_method_FNode_fluent_of_available_x__,
        up:fluent_n__bound_method_FNode_fluent_of_in_y__z__,
        up:fluent_n__bound_method_FNode_fluent_of_lifting_x__y__ .

