PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
SELECT ?integration ?rate_limit_module ?rate_limit_capacity ?rate_limit_window_ms ?rate_limit_key_source WHERE {
  ?integration a rt:Integration ; rt:rateLimitModule ?rate_limit_module ; rt:rateLimitCapacity ?rate_limit_capacity ;
    rt:rateLimitWindowMs ?rate_limit_window_ms ; rt:rateLimitKeySource ?rate_limit_key_source .
}
ORDER BY ?integration ?rate_limit_module
