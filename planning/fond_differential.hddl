(define (domain fond-differential) (:requirements :typing :hierarchy) (:types subject policy) (:task examine (?s - subject ?p - policy)) (:method bounded :parameters (?s - subject ?p - policy) :task (examine ?s ?p) :ordered-subtasks (and (native ?s ?p) (project ?s ?p) (compare ?s ?p))) (:action native :parameters (?s - subject ?p - policy) :precondition () :effect ()) (:action project :parameters (?s - subject ?p - policy) :precondition () :effect ()) (:action compare :parameters (?s - subject ?p - policy) :precondition () :effect ()))
