# ── Requirement nodes (courts, evidence, acceptance, falsifiers, ...) ──────

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#ARD-PRD> a <https://ggen-igniter.dev/ontology/semantic-jira#GoalCheckpoint> ;
    rdfs:label "ash_pplan v26.10.3 capability requirements document" ;
    dcterms:description "Enumerate the P-PLAN/PROV-O control plane, durable run ledger, standing verdict/ladder, OCEL 2.0 export, receipt cache, cross-repo admission courts, case-study layer, and qualification surface of ash_pplan v26.10.3 as requirements anchored to repository artifacts, each with a falsifier and honest limitation." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-bounded-lru> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "LRU holds exactly its bound under storm" ;
    dcterms:description "Under a concurrent storm the cache holds exactly its bound (256/256) with eviction serialized under a single lock; dead-holder flight claims are taken over after bounded extension." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-byte-identical-cached-raw> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Cached and raw receipts byte-identical" ;
    dcterms:description "For the same evidence ledger, receipt_cached/2 and receipt/2 produce byte-identical receipts, observed by the post-chain-digest-fix scaling courts." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-compile-checked-adapters> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Public-API adapters are compile-checked" ;
    dcterms:description "AshPPlan.StateMachine uses AshStateMachine.Info / possible_next_states / Charts public modules and AshPPlan.Oban uses AshOban.Info.oban_triggers_and_scheduled_actions/1 directly; a public contract change fails compilation." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-compiler-gates-topology> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Compiler gates unadmitted topology" ;
    dcterms:description "AshPPlan.Compiler refuses unadmitted topology; ./bin/conform accepts ontology/shapes.ttl conformance and ./bin/conform-falsify proves the profile still refuses." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-consistent-prefix> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Exports carry a consistent-prefix digest" ;
    dcterms:description "Each export carries a per-export digest of a consistent prefix snapshot; the acked prefix is stable after a mid-flight kill and store reopen, observed by test/durable/ledger_ocel_hardening_test.exs and test/stress/ocel_export_kill_test.exs." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-crash-durability> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Records survive restart" ;
    dcterms:description "Runs, checkpoints, signals, waiters and claim leases recorded before a stop, crash or kill of a Store.Dets process survive restart on the same :path; the runnable flow is test/workflow/durable_runtime_test.exs." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-fail-closed-corruption> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Corrupt DETS fails closed" ;
    dcterms:description "A corrupted DETS file yields {:error, {:dets_open_failed, _}} at startup and never opens half-readable." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-idempotent-manufacture> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Manufacture is idempotent" ;
    dcterms:description "./bin/manufacture followed by git diff --exit-code -- lib/ash_pplan/catalog lib/ash_pplan/workflow lib/ash_pplan/providers exits clean." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-kill-during-export> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Mid-export kill never yields a torn log" ;
    dcterms:description "Killing the store mid-export yields either a complete consistent prefix or a typed failure, never a torn log presented as complete." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-ladder-closed-set> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Ladder is a closed 10-state set" ;
    dcterms:description "The ladder is a closed set of exactly 10 states in promotion order; an index outside the set is a typed error, observed by test/stress/standing_churn_test.exs and test/stress/chain_seal_storm_test.exs." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-receipt-deterministic-identity> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Standing receipt identity is deterministic" ;
    dcterms:description "Standing receipt identity is a domain-tagged sha256 over non-event fields plus one sha256 leaf per evidence event (identity tag ash-pplan-standing-identity-v2); cached and raw receipts stay byte-identical." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-replayable-citations> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Every citation is replayable" ;
    dcterms:description "Every cited artifact names how to reproduce it (bench command, test file, or bin/demonstrate / bin/case-study)." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-run-first-status> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "LANDED only with a run receipt" ;
    dcterms:description "A study's status is LANDED only when it cites a run receipt under receipts/; the index in docs/case-studies/README.md currently lists all six studies as RUN-FIRST-PENDING." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-skip-not-pass> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Unrunnable steps reported SKIP" ;
    dcterms:description "Every step ./bin/gate cannot run on this machine is reported SKIP, never passed." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-soak-stability> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
    rdfs:label "Soak completes without unbounded growth" ;
    dcterms:description "The OCEL pipeline soak completes its sustained mixed load without unbounded growth or export failure." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#acc-tokyo-refusals> a <https://ggen-igniter.dev/ontology/semantic-jira#AcceptanceCriterion> ;
