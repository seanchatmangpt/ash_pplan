    dcterms:description "Locating Module.concat/1 or apply/3 indirection over a public upstream API in AshPPlan.StateMachine or AshPPlan.Oban falsifies the compile-checked adapter claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-cache-divergence> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Cached receipt diverges from raw" ;
    dcterms:description "A cached receipt differing byte-wise from the raw receipt over the same evidence ledger falsifies the identity-invariance claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-export-torn> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Torn export digest accepted" ;
    dcterms:description "An export digest matching a log that mixes pre-kill and post-reopen state outside the acked prefix falsifies the consistent-prefix claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-fleet-env-drift> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Runner environment defect reappears" ;
    dcterms:description "A fleet soak run failing only on the runner environment (the defect fixed in 82aacc1) reappearing falsifies the environment-fix stability claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-half-readable-corrupt> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Half-readable corrupted file" ;
    dcterms:description "A corrupted DETS file opening successfully and returning partial run state falsifies the fail-closed claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-ladder-grants-authority> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Ladder gate executes instead of describing" ;
    dcterms:description "Any code path where a ladder rung or receipt gates execution (DO) rather than describing evidence falsifies the observation-only boundary." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-landed-without-receipt> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "LANDED status without receipt" ;
    dcterms:description "A study marked LANDED in the index without a matching receipt file under docs/case-studies/receipts/ falsifies the run-first contract." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-local-pass-as-standing> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Local pass treated as standing" ;
    dcterms:description "Treating a local ./bin/gate pass as release standing, rather than CI's release-gate job on the exact head, falsifies the qualification boundary." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-lost-acked-run> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Acknowledged run lost across restart" ;
    dcterms:description "A run whose caller received a success acknowledgment before a store kill being absent after restart on the same path falsifies the durability claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-out-of-set-rung> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Out-of-set ladder rung returned" ;
    dcterms:description "AshPPlan.Standing.Ladder returning an 11th state or accepting an out-of-set index without a typed refusal falsifies the closed-set claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-second-ontology> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "Second ontology source observed" ;
    dcterms:description "Observing a second, divergent ontology source consumed by ggen_igniter (broken symlink or copied TTL) falsifies the single-source claim." .

<https://ggen-igniter.dev/sjira/v26.10.3/ard-prd#falsifier-skip-as-passed> a <https://ggen-igniter.dev/ontology/semantic-jira#Falsifier> ;
    rdfs:label "SKIP reported as passed" ;
    dcterms:description "Any gate step the machine cannot run being reported as passed rather than SKIP falsifies the honest-reporting claim." .

