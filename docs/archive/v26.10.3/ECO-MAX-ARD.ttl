<https://ggen-igniter.dev/sjira/v26.10.3/sjira#order-spark-dsl-patches> a sj:GoalCheckpoint ;
    dcterms:identifier "ECO-SPARK-PATCH"  ;
    rdfs:label "Project-local Spark DSL extensions via dsl_patches"  ;
    dcterms:description "Research finding 3 (high confidence, 3-0): Spark is the DSL engine behind every Ash-ecosystem DSL including Reactor's (ash_pplan pins spark ~> 2.7 as a direct dependency precisely because Reactor step DSLs are Spark-based); its extension points - sections, entities, transformers, verifiers - and end-user extensibility via dsl_patches/extensions are the lever for project-local extension without forking. This order answers openQuestion 4: whether ash_pplan should expose project-specific Spark DSL sections for its P-PLAN/PROV-O domain instead of composing existing DSLs verbosely at call sites, decided on a measured call-site census."  ;
    sj:repository "seanchatmangpt/ash_pplan"  ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da"  ;
    sj:subject "docs/sjira/v26.10.3/sjira.ttl"  ;
    sj:standing "UNKNOWN"  ;
    sj:evidenceCeiling "EXECUTED_VERIFIED"  ;
    sj:authorityCeiling "CONSTRUCT"  ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output."  ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-SPARK-PATCH" ;
    sj:pathScope "lib/ash_pplan/compiler.ex" ;
    sj:pathScope "lib/ash_pplan/fond.ex" ;
    sj:pathScope "mix.exs" ;
    sj:pathScope "ontology.ttl" ;
    sj:requiresCourt <https://ggen-igniter.dev/sjira/v26.10.3/sjira#court-shacl-tests> ;
    sj:requiresEvidence <https://ggen-igniter.dev/sjira/v26.10.3/sjira#ev-spark-call-site-census> ;
    sj:requiresEvidence <https://ggen-igniter.dev/sjira/v26.10.3/sjira#ev-spark-pin> ;
    sj:acceptance <https://ggen-igniter.dev/sjira/v26.10.3/sjira#acc-dsl-patch-decision> ;
    sj:acceptance <https://ggen-igniter.dev/sjira/v26.10.3/sjira#acc-dsl-patch-nonvacuous> ;
    sj:falsifier <https://ggen-igniter.dev/sjira/v26.10.3/sjira#fals-dsl-patch-fork> ;
    sj:falsifier <https://ggen-igniter.dev/sjira/v26.10.3/sjira#fals-dsl-patch-vacuous> ;
    sj:projection <https://ggen-igniter.dev/sjira/v26.10.3/sjira#projection-sjira> ;
