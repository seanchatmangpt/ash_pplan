<https://ggen-igniter.dev/sjira/v26.10.3/sjira#order-eco-as-config> a sj:GoalCheckpoint ;
    dcterms:identifier "ECO-AS-CONFIG"  ;
    rdfs:label "Compound ecosystem usage via configuration, not integration code"  ;
    dcterms:description "Research finding 1 (high confidence, verified 3-0): Ash resources are the single source of truth and extensions derive capabilities (DB schemas, GraphQL/JSON:API, admin, TypeScript) from typed introspectable actions, so maximum ecosystem usage compounds by adding configuration rather than hand-written integration code. ash_pplan's control plane already joins AshPPlan.ControlPlane/Oban/StateMachine over upstream public introspection; this order extends that configuration-only pattern to every new ecosystem surface adopted under ECO-EXT-AUDIT and ECO-REACTOR-GENERIC, and refuses per-extension glue code at call sites."  ;
    sj:repository "seanchatmangpt/ash_pplan"  ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da"  ;
