<https://ggen-igniter.dev/sjira/v26.10.3/sjira#order-reactor-dag> a sj:GoalCheckpoint ;
    dcterms:identifier "ECO-REACTOR-DAG"  ;
    rdfs:label "Exploit Reactor's argument-derived DAG and default concurrency"  ;
    dcterms:description "Research finding 4 (high confidence, 3-0): Reactor (v~1.0.7, ash-project org, a hard dependency of Ash 3) is a dynamic, concurrent, dependency-resolving saga orchestrator; steps run as concurrently as possible by default over an argument-derived DAG, and steps can be added while the reactor is running. ash_pplan already runs reactor ~> 1.0 with reactor_req, reactor_file and vendored reactor_process. This order verifies ash_pplan's composed flows let the DAG (not sequential composition) determine order and measures the concurrency actually achieved."  ;
    sj:repository "seanchatmangpt/ash_pplan"  ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da"  ;
