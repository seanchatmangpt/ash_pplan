# ── Order 1: ecosystem-as-configuration ─────────────────────────────────────

sjd:order-eco-as-config a sj:WorkOrder ;
    dcterms:identifier "ECO-AS-CONFIG" ;
    dcterms:title "Compound ecosystem usage via configuration, not integration code" ;
    dcterms:description "Research finding 1 (high confidence, verified 3-0): Ash resources are the single source of truth and extensions derive capabilities (DB schemas, GraphQL/JSON:API, admin, TypeScript) from typed introspectable actions, so maximum ecosystem usage compounds by adding configuration rather than hand-written integration code. ash_pplan's control plane already joins AshPPlan.ControlPlane/Oban/StateMachine over upstream public introspection; this order extends that configuration-only pattern to every new ecosystem surface adopted under ECO-EXT-AUDIT and ECO-REACTOR-GENERIC, and refuses per-extension glue code at call sites." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "docs/sjira/v26.10.3/sjira.ttl" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
    sj:originObservation <file:///private/tmp/claude-501/-Users-sac-ash-pplan/10b19945-7299-418b-9c13-3200e9fd4d77/tasks/wihu2sna6.output> ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-AS-CONFIG" ;
    sj:pathScope
        "mix.exs" ,
        "lib/ash_pplan/control_plane.ex" ,
        "lib/ash_pplan/oban.ex" ;
    sj:requiresCourt sjd:court-shacl-tests ;
    sj:requiresEvidence sjd:ev-config-public-api , sjd:ev-config-mix ;
    sj:acceptance sjd:acc-config-only-adoption , sjd:acc-config-no-glue ;
    sj:falsifier sjd:fals-config-glue-code , sjd:fals-config-second-path ;
    sj:projection sjd:projection-sjira ;
    sj:nextAction sjd:action-run-courts ;
    sj:nextCheckpoint sjd:checkpoint-eco-max .

sjd:ev-config-public-api a sj:EvidenceRequirement ;
    rdfs:label "Public-API configuration adoption" ;
    dcterms:description "New ecosystem surfaces are adopted by declaring extensions + configuration and consuming upstream public introspection (the AshPPlan.ControlPlane/Oban/StateMachine pattern), verified on the exact base SHA." .

sjd:ev-config-mix a sj:EvidenceRequirement ;
    rdfs:label "Dependency surface observable in mix.exs" ;
    dcterms:description "mix.exs is the single record of adopted ecosystem packages (ash, spark, reactor, igniter, reactor_req, reactor_file); the adoption audit (ECO-EXT-AUDIT) diffs against it." .

sjd:acc-config-only-adoption a sj:AcceptanceCriterion ;
    rdfs:label "Adoption is configuration-only" ;
    dcterms:description "Every newly adopted ecosystem extension lands as extension declaration + configuration; no hand-written adapter bridges framework behavior the extension already derives." .

sjd:acc-config-no-glue a sj:AcceptanceCriterion ;
    rdfs:label "No per-extension glue at call sites" ;
    dcterms:description "A census of call sites touching newly adopted extensions shows extension-declared behavior consumed directly, not re-wrapped in project-local shim modules." .

sjd:fals-config-glue-code a sj:Falsifier ;
    rdfs:label "Hand-written integration glue observed" ;
    dcterms:description "Hand-written code re-implementing behavior an adopted extension derives from resources/actions (the anti-pattern the research names) falsifies the configuration-only adoption claim." .

sjd:fals-config-second-path a sj:Falsifier ;
    rdfs:label "Parallel introspection path" ;
    dcterms:description "A second introspection path bypassing Ash public Info modules for an adopted extension falsifies the single-substrate claim." .

# ── Order 2: extension catalog adoption audit ────────────────────────────────

sjd:order-eco-ext-audit a sj:WorkOrder ;
    dcterms:identifier "ECO-EXT-AUDIT" ;
    dcterms:title "Ecosystem extension catalog adoption audit" ;
    dcterms:description "Research finding 2 (high confidence, 3-0) plus openQuestion 1: the ecosystem ships a named extension catalog (AshPostgres, AshSqlite, AshCsv, AshCubDB, AshAuthentication, AshOban, AshStateMachine, AshPaperTrail, AshArchival, AshCloak, AshAi, AshGraphql, AshJsonApi); the research explicitly did NOT produce a per-module audit of which features ash_pplan has not adopted, so 'maximum usage' headroom is inferred, not measured. This order runs the missing audit: inventory lib/ and mix.exs consumption against the catalog, quantify the gap (AshOban, AshPaperTrail, AshCloak, bulk actions, AshGraphql/JsonApi), and give every candidate an adopt receipt or a typed refusal." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "docs/sjira/v26.10.3/sjira.ttl" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
    sj:originObservation <file:///private/tmp/claude-501/-Users-sac-ash-pplan/10b19945-7299-418b-9c13-3200e9fd4d77/tasks/wihu2sna6.output> ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-EXT-AUDIT" ;
    sj:pathScope
        "mix.exs" ,
        "lib/ash_pplan/" ,
        "docs/sjira/v26.10.3/sjira.ttl" ;
    sj:requiresCourt sjd:court-shacl-tests ;
    sj:requiresEvidence sjd:ev-audit-inventory , sjd:ev-audit-refusals ;
    sj:acceptance sjd:acc-audit-quantified , sjd:acc-audit-typed-refusals ;
    sj:falsifier sjd:fals-audit-inferred , sjd:fals-audit-silent-candidate ;
    sj:projection sjd:projection-sjira ;
    sj:nextAction sjd:action-run-courts ;
    sj:nextCheckpoint sjd:checkpoint-eco-max .

sjd:ev-audit-inventory a sj:EvidenceRequirement ;
    rdfs:label "lib/ vs catalog inventory" ;
    dcterms:description "A module/dependency inventory of lib/ diffed against the official extension catalog (mix.exs deps + extension declarations), produced on the exact base SHA." .

sjd:ev-audit-refusals a sj:EvidenceRequirement ;
    rdfs:label "Typed adopt/refuse receipts per candidate" ;
    dcterms:description "Each catalog candidate (AshOban, AshPaperTrail, AshCloak, bulk actions, AshGraphql/JsonApi) carries an adopt receipt or a typed refusal, never silence." .

sjd:acc-audit-quantified a sj:AcceptanceCriterion ;
    rdfs:label "Adoption gap is measured, not inferred" ;
    dcterms:description "The audit output states which catalog extensions ash_pplan consumes and which it does not, as measured counts over lib/ and mix.exs on the exact base SHA - closing the exact gap the research named as unmeasured." .

sjd:acc-audit-typed-refusals a sj:AcceptanceCriterion ;
    rdfs:label "Every unadopted candidate is typed" ;
    dcterms:description "Every unadopted catalog extension carries a typed adopt/refuse verdict with reason; an unadopted extension appearing nowhere in the audit falsifies the inventory." .

sjd:fals-audit-inferred a sj:Falsifier ;
    rdfs:label "Headroom inferred without inventory" ;
    dcterms:description "A headroom claim produced without the lib/ vs catalog inventory (the exact gap the research flagged) falsifies the audit's evidence claim." .

sjd:fals-audit-silent-candidate a sj:Falsifier ;
    rdfs:label "Candidate missing from audit" ;
    dcterms:description "A catalog extension absent from the audit output (neither adopted nor refused) falsifies the completeness claim." .

# ── Order 3: Spark dsl_patches lever ─────────────────────────────────────────

sjd:order-spark-dsl-patches a sj:WorkOrder ;
    dcterms:identifier "ECO-SPARK-PATCH" ;
    dcterms:title "Project-local Spark DSL extensions via dsl_patches" ;
    dcterms:description "Research finding 3 (high confidence, 3-0): Spark is the DSL engine behind every Ash-ecosystem DSL including Reactor's (ash_pplan pins spark ~> 2.7 as a direct dependency precisely because Reactor step DSLs are Spark-based); its extension points - sections, entities, transformers, verifiers - and end-user extensibility via dsl_patches/extensions are the lever for project-local extension without forking. This order answers openQuestion 4: whether ash_pplan should expose project-specific Spark DSL sections for its P-PLAN/PROV-O domain instead of composing existing DSLs verbosely at call sites, decided on a measured call-site census." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "docs/sjira/v26.10.3/sjira.ttl" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
    sj:originObservation <file:///private/tmp/claude-501/-Users-sac-ash-pplan/10b19945-7299-418b-9c13-3200e9fd4d77/tasks/wihu2sna6.output> ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-SPARK-PATCH" ;
    sj:pathScope
        "mix.exs" ,
        "lib/ash_pplan/compiler.ex" ,
        "lib/ash_pplan/fond.ex" ,
        "ontology.ttl" ;
    sj:requiresCourt sjd:court-shacl-tests ;
    sj:requiresEvidence sjd:ev-spark-pin , sjd:ev-spark-call-site-census ;
    sj:acceptance sjd:acc-dsl-patch-decision , sjd:acc-dsl-patch-nonvacuous ;
    sj:falsifier sjd:fals-dsl-patch-fork , sjd:fals-dsl-patch-vacuous ;
    sj:projection sjd:projection-sjira ;
    sj:nextAction sjd:action-run-courts ;
    sj:nextCheckpoint sjd:checkpoint-eco-max .

sjd:ev-spark-pin a sj:EvidenceRequirement ;
    rdfs:label "Spark pinned as direct dep" ;
    dcterms:description "mix.exs pins spark ~> 2.7 as a direct dependency; the census of verbose call-site DSL composition under lib/ash_pplan/ quantifies what a dsl_patches section would collapse." .

sjd:ev-spark-call-site-census a sj:EvidenceRequirement ;
    rdfs:label "Verbose call-site census" ;
    dcterms:description "A measured census of repeated DSL composition at call sites (the P-PLAN/PROV-O composition blocks) that a project-local Spark section would replace, produced on the exact base SHA." .

sjd:acc-dsl-patch-decision a sj:AcceptanceCriterion ;
    rdfs:label "dsl_patches decision is receipted" ;
    dcterms:description "The adopt/refuse decision for project-local Spark DSL extensions (dsl_patches or custom sections) carries a typed receipt with the census as evidence; silence is not a verdict." .

sjd:acc-dsl-patch-nonvacuous a sj:AcceptanceCriterion ;
    rdfs:label "Adoption is non-vacuous" ;
    dcterms:description "If adopted, the custom section replaces at least the censused verbose call sites and the compiler still refuses unadmitted topology (./bin/conform and ./bin/conform-falsify still pass)." .

sjd:fals-dsl-patch-fork a sj:Falsifier ;
    rdfs:label "Fork instead of extension point" ;
    dcterms:description "Reaching project-local DSL extension by forking an upstream DSL module instead of Spark's dsl_patches/extensions extension points falsifies the no-fork claim." .

sjd:fals-dsl-patch-vacuous a sj:Falsifier ;
    rdfs:label "Adopted patch changes nothing" ;
    dcterms:description "A dsl_patches adoption that leaves the censused verbose call sites untouched falsifies the collapse claim." .

# ── Order 4: Reactor concurrency/DAG ────────────────────────────────────────

sjd:order-reactor-dag a sj:WorkOrder ;
    dcterms:identifier "ECO-REACTOR-DAG" ;
    dcterms:title "Exploit Reactor's argument-derived DAG and default concurrency" ;
    dcterms:description "Research finding 4 (high confidence, 3-0): Reactor (v~1.0.7, ash-project org, a hard dependency of Ash 3) is a dynamic, concurrent, dependency-resolving saga orchestrator; steps run as concurrently as possible by default over an argument-derived DAG, and steps can be added while the reactor is running. ash_pplan already runs reactor ~> 1.0 with reactor_req, reactor_file and vendored reactor_process. This order verifies ash_pplan's composed flows let the DAG (not sequential composition) determine order and measures the concurrency actually achieved." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "docs/sjira/v26.10.3/sjira.ttl" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
    sj:originObservation <file:///private/tmp/claude-501/-Users-sac-ash-pplan/10b19945-7299-418b-9c13-3200e9fd4d77/tasks/wihu2sna6.output> ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-REACTOR-DAG" ;
    sj:pathScope
        "lib/ash_pplan/reactor.ex" ,
        "lib/ash_pplan/reactor/" ,
        "lib/ash_pplan/fond.ex" ;
    sj:requiresCourt sjd:court-shacl-tests ;
    sj:requiresEvidence sjd:ev-dag-measured-concurrency , sjd:ev-dag-runtime-steps ;
    sj:acceptance sjd:acc-dag-order-from-deps , sjd:acc-dag-concurrency-measured ;
    sj:falsifier sjd:fals-dag-sequential-glue , sjd:fals-dag-concurrency-unmeasured ;
    sj:projection sjd:projection-sjira ;
    sj:nextAction sjd:action-run-courts ;
    sj:nextCheckpoint sjd:checkpoint-eco-max .

sjd:ev-dag-measured-concurrency a sj:EvidenceRequirement ;
    rdfs:label "Measured step concurrency" ;
    dcterms:description "A measured concurrency figure (peak/mean concurrent steps) for ash_pplan's composed flows under Reactor's default scheduler, produced by an executed bench on the exact base SHA." .

sjd:ev-dag-runtime-steps a sj:EvidenceRequirement ;
    rdfs:label "Runtime-added steps exercised" ;
    dcterms:description "At least one flow exercising Reactor's runtime step-addition (or a typed refusal of it) on the exact base SHA." .

sjd:acc-dag-order-from-deps a sj:AcceptanceCriterion ;
    rdfs:label "Order derives from the DAG" ;
    dcterms:description "No composed flow imposes sequential order where only argument dependencies exist; sequentiality appears only where semantics require it, and each such case is receipted." .

sjd:acc-dag-concurrency-measured a sj:AcceptanceCriterion ;
    rdfs:label "Achieved concurrency is measured" ;
    dcterms:description "The achieved concurrency figure is a bench output on the exact base SHA, not an inference from Reactor's README." .

sjd:fals-dag-sequential-glue a sj:Falsifier ;
    rdfs:label "Sequential glue where DAG suffices" ;
    dcterms:description "A flow forcing sequential execution where only argument dependencies determine order falsifies the DAG-exploitation claim." .

sjd:fals-dag-concurrency-unmeasured a sj:Falsifier ;
    rdfs:label "Concurrency claimed unmeasured" ;
    dcterms:description "A concurrency claim without an executed bench receipt on the exact base SHA falsifies the measured-concurrency acceptance." .

# ── Order 5: Ash.Reactor full step surface ──────────────────────────────────

sjd:order-ashreactor-steps a sj:WorkOrder ;
    dcterms:identifier "ECO-ASHREACTOR-STEPS" ;
    dcterms:title "Adopt the full Ash.Reactor step DSL surface (incl. bulk + generic)" ;
    dcterms:description "Research finding 5 (high confidence, 3-0, with the verification correction that Ash.Reactor ships inside the main ash package - no separate ash_reactor hex package exists): Ash.Reactor provides a step DSL entity per action type - create, update, destroy, read, read_one, load, generic, ash_step, plus bulk create/update/destroy - for orchestrating resource actions in Reactor workflows. ash_pplan's adapter (lib/ash_pplan/reactor/adapters/ash_reactor.ex) currently exercises :create/:read/:update/:destroy kinds; this order closes the gap to the full surface (read_one, load, generic, ash_step, bulk), each by adoption receipt or typed refusal." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "lib/ash_pplan/reactor/adapters/ash_reactor.ex" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "manufacture" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
    sj:originObservation <file:///private/tmp/claude-501/-Users-sac-ash-pplan/10b19945-7299-418b-9c13-3200e9fd4d77/tasks/wihu2sna6.output> ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-ASHREACTOR-STEPS" ;
    sj:pathScope
        "lib/ash_pplan/reactor/adapters/ash_reactor.ex" ,
        "lib/ash_pplan/reactor/durable/engine.ex" ;
    sj:requiresCourt sjd:court-shacl-tests ;
    sj:requiresEvidence sjd:ev-steps-kind-census , sjd:ev-steps-bulk-exercise ;
    sj:acceptance sjd:acc-steps-full-surface , sjd:acc-steps-bulk-under-durable ;
    sj:falsifier sjd:fals-steps-adapter-fork , sjd:fals-steps-bulk-regression ;
    sj:projection sjd:projection-sjira ;
    sj:nextAction sjd:action-run-courts ;
    sj:nextCheckpoint sjd:checkpoint-eco-max .

sjd:ev-steps-kind-census a sj:EvidenceRequirement ;
    rdfs:label "Step-kind census of the adapter" ;
    dcterms:description "A census of step kinds exercised by lib/ash_pplan/reactor/adapters/ash_reactor.ex vs the Ash.Reactor action() union, produced on the exact base SHA." .

sjd:ev-steps-bulk-exercise a sj:EvidenceRequirement ;
    rdfs:label "Bulk step exercised under the durable engine" ;
    dcterms:description "A bulk create/update/destroy step executed under the AshPPlan.Reactor.Durable engine with crash/replay semantics intact." .

sjd:acc-steps-full-surface a sj:AcceptanceCriterion ;
    rdfs:label "Full step surface or typed refusal per gap" ;
    dcterms:description "Each Ash.Reactor step kind not exercised by the adapter carries either an adoption receipt (wired and tested) or a typed UNSUPPORTED reason; silence is not a verdict." .

sjd:acc-steps-bulk-under-durable a sj:AcceptanceCriterion ;
    rdfs:label "Bulk steps survive the durable engine" ;
    dcterms:description "A bulk step run under the durable engine replays correctly after a mid-step kill; the durable suites observe it." .

sjd:fals-steps-adapter-fork a sj:Falsifier ;
    rdfs:label "Vendored Ash.Reactor fork observed" ;
    dcterms:description "Closing a step-kind gap by vendoring/forking Ash.Reactor instead of using the shipped DSL entities falsifies the shipped-surface adoption claim." .

sjd:fals-steps-bulk-regression a sj:Falsifier ;
    rdfs:label "Bulk step breaks durable replay" ;
    dcterms:description "A bulk step whose mid-step kill/replay produces lost or duplicated effects falsifies the durable-compatibility claim." .

# ── Order 6: Reactor-as-generic-action ──────────────────────────────────────

sjd:order-reactor-generic a sj:WorkOrder ;
    dcterms:identifier "ECO-REACTOR-GENERIC" ;
    dcterms:title "Run Reactor modules directly as Ash generic actions" ;
    dcterms:description "Research finding 6 (high confidence, 3-0, the documented preferred initiation pattern): Ash generic actions support providing a Reactor module directly as their run option, with Ash action context (actor, tenant) passed into the Reactor context; qualifications: every Reactor input must map to an action argument, and transaction? true forces synchronous execution. This order answers openQuestion 2: whether converting multi-step flows to Reactor-as-generic-action simplifies ash_pplan's current adapter layer, and what breaks under transaction? true." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "lib/ash_pplan/reactor/adapters/ash_reactor.ex" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "manufacture" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
