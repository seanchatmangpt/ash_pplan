sjd:ev-generic-input-mapping a sj:EvidenceRequirement ;
    rdfs:label "Input-to-argument mapping receipted" ;
    dcterms:description "For a converted flow, every Reactor input maps to a generic-action argument and actor/tenant propagation is observed (or a typed refusal), on the exact base SHA." .

sjd:ev-generic-transaction-constraint a sj:EvidenceRequirement ;
    rdfs:label "transaction? true constraint characterized" ;
    dcterms:description "The synchronous-execution constraint under transaction? true is exercised by a test observing the forced-synchronous behavior (or a typed refusal), on the exact base SHA." .

sjd:acc-generic-simplification-measured a sj:AcceptanceCriterion ;
    rdfs:label "Adapter simplification is measured" ;
    dcterms:description "The conversion's simplification is a measured delta over the current adapter layer (removed indirection, fewer custom step kinds), not an inference." .

sjd:acc-generic-transaction-bound a sj:AcceptanceCriterion ;
    rdfs:label "transaction? true boundary receipted" ;
    dcterms:description "Every flow converted to Reactor-as-generic-action documents and tests its transaction? true behavior; an untested conversion falsifies the boundary claim." .

sjd:fals-generic-context-loss a sj:Falsifier ;
    rdfs:label "Actor/tenant context lost in conversion" ;
    dcterms:description "Actor/tenant context not arriving in the Reactor context after conversion falsifies the context-propagation claim." .

sjd:fals-generic-adapter-grew a sj:Falsifier ;
    rdfs:label "Adapter grew instead of shrinking" ;
    dcterms:description "A conversion that increases adapter-layer indirection or hand-written glue falsifies the simplification claim." .

# ── Order 7: saga compensate/middleware ─────────────────────────────────────

sjd:order-saga-compensate a sj:WorkOrder ;
    dcterms:identifier "ECO-SAGA-COMPENSATE" ;
    dcterms:title "Adopt compensate/undo saga semantics and Reactor middleware" ;
    dcterms:description "Research finding 7 (high confidence, 3-0): Reactor's saga semantics are directly adoptable - compensate/4 callbacks returning :ok, {:continue, value}, :retry (with max_retries) or {:error, reason}, a LIFO undo stack giving transaction-like rollback across resources, and the optional-callback Middleware behaviour attachable via the middlewares DSL section or Reactor.Builder.add_middleware/2 for cross-cutting instrumentation without touching step definitions (compensate result type verified in installed deps/reactor source, lib/reactor/step.ex). This order answers openQuestion 3: whether Reactor middleware can replace hand-rolled cross-cutting instrumentation (telemetry/tracing/undo handling) currently implemented inline in ash_pplan's steps; lib/ash_pplan/reactor/durable/middleware.ex is the local anchor." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "lib/ash_pplan/reactor/durable/middleware.ex" ;
    # Standing 2026-10-04: UNKNOWN -> PARTIAL_ALIVE per promotionRule, from the
    # witnessed executable-test courts on the exact base subject
    # c42ee1989db28cf544b26a0d13e084a3e1d4c7da (working tree at that head):
    # test/durable/saga_compensation_court_test.exs 5/5, runtime contract court
    # 5/5, pack-courts harness court 2/2 (86 zero-row cross-contract courts +
    # 4 gates + both anti-vacuity legs), telemetry middleware court 2/2, and
    # byte-identical regeneration (bin/manufacture-runtime-contract unchanged
    # across re-runs + @recipes/saga courts). ALIVE remains gated on the
    # durable receipt bound to the exact post-adoption head (coordinator
    # commit); this row does not claim it.
    sj:standing "PARTIAL_ALIVE" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "manufacture" ;
    sj:requiresReceiptClass "verification" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
    sj:originObservation <file:///private/tmp/claude-501/-Users-sac-ash-pplan/10b19945-7299-418b-9c13-3200e9fd4d77/tasks/wihu2sna6.output> ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-SAGA-COMPENSATE" ;
    sj:pathScope
        "lib/ash_pplan/reactor/durable/middleware.ex" ,
        "lib/ash_pplan/reactor/durable/engine.ex" ;
    sj:requiresCourt sjd:court-shacl-tests ;
    sj:requiresEvidence sjd:ev-saga-compensate-exercise , sjd:ev-saga-middleware-replacement ;
    sj:acceptance sjd:acc-saga-compensate-wired , sjd:acc-saga-middleware-inline-replaced ;
    sj:falsifier sjd:fals-saga-undo-lost , sjd:fals-saga-middleware-inline-remains ;
    sj:projection sjd:projection-sjira ;
    sj:nextAction sjd:action-run-courts ;
    sj:nextCheckpoint sjd:checkpoint-eco-max .

sjd:ev-saga-compensate-exercise a sj:EvidenceRequirement ;
    rdfs:label "Compensate/undo exercised" ;
    dcterms:description "A flow whose failing step exercises each compensate/4 result branch (or the branches ash_pplan adopts, with the rest typed out of scope), including LIFO undo across at least two resources, on the exact base SHA." .

sjd:ev-saga-middleware-replacement a sj:EvidenceRequirement ;
    rdfs:label "Inline instrumentation census" ;
    dcterms:description "A census of hand-rolled cross-cutting instrumentation inline in ash_pplan steps (telemetry/tracing/undo handling) and a per-item adopt-or-refuse verdict against Reactor.Middleware, produced on the exact base SHA." .

sjd:acc-saga-compensate-wired a sj:AcceptanceCriterion ;
    rdfs:label "Compensate semantics wired and observed" ;
    dcterms:description "Adopted compensate/undo semantics are exercised by tests observing rollback and retry behavior, not by documentation." .

sjd:acc-saga-middleware-inline-replaced a sj:AcceptanceCriterion ;
    rdfs:label "Middleware replaces inline instrumentation or is typed-refused" ;
    dcterms:description "Every inline cross-cutting instrumentation item is either moved behind a Reactor middleware with behavior preserved (observed by the existing suites) or carries a typed refusal; partial silent migration falsifies the census." .

sjd:fals-saga-undo-lost a sj:Falsifier ;
    rdfs:label "Undo lost on failure path" ;
    dcterms:description "A failure path that leaves a prior step's effect un-undone where the adopted compensate semantics promise rollback falsifies the saga claim." .

sjd:fals-saga-middleware-inline-remains a sj:Falsifier ;
    rdfs:label "Inline instrumentation remains after middleware adoption" ;
    dcterms:description "Cross-cutting logic implemented both inline in steps and in an adopted middleware (double implementation) falsifies the replacement claim." .

# ── Order 8: Igniter generator composition ──────────────────────────────────

sjd:order-igniter-composition a sj:WorkOrder ;
    dcterms:identifier "ECO-IGNITER-COMPOSE" ;
    dcterms:title "Project generators via Igniter semantic patching and compose_task" ;
    dcterms:description "Research finding 8 (high confidence, 3-0): Igniter is a code generation and project-patching framework whose generators semantically create AND modify existing files (AST-based via Sourceror); mix igniter.install auto-adds deps and runs package installers, and library generators compose tasks (ash.install composes spark.install and ash.gen.resource) via Igniter.compose_task/4 (verified in installed deps/igniter/lib/igniter.ex). ash_pplan already depends on ggen_igniter; this order makes ash_pplan's own generators Igniter-composed: semantic edits to existing files instead of whole-file writes, and composition of ash.gen.* / ggen_igniter tasks instead of re-implementing them." ;
    sj:repository "seanchatmangpt/ash_pplan" ;
    sj:baseSha "c42ee1989db28cf544b26a0d13e084a3e1d4c7da" ;
    sj:subject "lib/ash_pplan/generated" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "EXECUTED_VERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "UNKNOWN -> PARTIAL_ALIVE when the SHACL + executable-test court observes this order's acceptance criteria on the exact subject; ALIVE only on a durable receipt bound to the exact head; never from the research output." ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "manufacture" ;
    sj:requiresReceiptClass "projection" ;
    sj:originAuthority <https://ggen-igniter.dev/sjira/v26.10.3/sjira#eco-max-root> ;
    sj:originObservation <file:///private/tmp/claude-501/-Users-sac-ash-pplan/10b19945-7299-418b-9c13-3200e9fd4d77/tasks/wihu2sna6.output> ;
    sj:replayIdentity "semantic-jira:v26.10.3:ECO-IGNITER-COMPOSE" ;
    sj:pathScope
        "lib/ash_pplan/generated/" ,
        "lib/ash_pplan/manufacture_targets.ex" ,
        "docs/sjira/v26.10.3/sjira.ttl" ;
    sj:requiresCourt sjd:court-shacl-tests ;
    sj:requiresEvidence sjd:ev-igniter-compose-exercise , sjd:ev-igniter-idempotence ;
    sj:acceptance sjd:acc-igniter-semantic-edits , sjd:acc-igniter-composed-not-copied ;
    sj:falsifier sjd:fals-igniter-whole-file-rewrite , sjd:fals-igniter-duplicated-task ;
    sj:projection sjd:projection-sjira ;
    sj:nextAction sjd:action-run-courts ;
    sj:nextCheckpoint sjd:checkpoint-eco-max .

sjd:ev-igniter-compose-exercise a sj:EvidenceRequirement ;
    rdfs:label "Composed generator task executed" ;
    dcterms:description "An ash_pplan generator executed that composes at least one upstream Igniter task (ash.gen.* or ggen_igniter) via Igniter.compose_task, on the exact base SHA." .

sjd:ev-igniter-idempotence a sj:EvidenceRequirement ;
    rdfs:label "Generator idempotence observed" ;
    dcterms:description "Running the generator twice leaves the tree unchanged after the first run (Igniter semantic patching is idempotent), observed on the exact base SHA." .

sjd:acc-igniter-semantic-edits a sj:AcceptanceCriterion ;
    rdfs:label "Generators patch existing files semantically" ;
    dcterms:description "ash_pplan generators modify existing files via AST-aware patching (Sourceror) rather than overwriting whole files; a run over a hand-modified file preserves the manual edit." .

sjd:acc-igniter-composed-not-copied a sj:AcceptanceCriterion ;
    rdfs:label "Upstream tasks composed, not re-implemented" ;
    dcterms:description "Behavior available from upstream Igniter tasks is invoked via composition, not copied into project-local generators." .

sjd:fals-igniter-whole-file-rewrite a sj:Falsifier ;
    rdfs:label "Whole-file overwrite observed" ;
    dcterms:description "A generator clobbering a hand-modified file (whole-file rewrite where a semantic patch was available) falsifies the semantic-editing claim." .

sjd:fals-igniter-duplicated-task a sj:Falsifier ;
    rdfs:label "Re-implemented upstream task" ;
    dcterms:description "A project-local generator duplicating behavior shipped by an upstream Igniter task falsifies the composition claim." .
